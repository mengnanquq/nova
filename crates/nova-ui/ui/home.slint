//! 首页（Netflix 风格）：透明顶栏浮在 billboard 上 + 横向大行。
//!
//! billboard 88vh（最大 720px）：全宽 backdrop、底部+左侧双渐变、
//! 标题 / 元信息 / 3 行简介 / 双按钮 / 右下徽标。
//! 行：标题 22px + "查看全部 ›"（仅限有对应媒体库的行）+ 横向 Flickable；
//! 卡片放大用独立覆盖层（`CardZoom`），行内基础卡片尺寸恒定，布局零跳动。

import { Theme } from "theme.slint";
import { CardData, HomeData, Target, TargetBus } from "models.slint";
import { Navbar } from "navbar.slint";
import { PosterCard } from "poster_card.slint";
import { CardZoom } from "card_zoom.slint";
import { EmptyState } from "empty_state.slint";
import { FocusRing } from "focus_ring.slint";

// 一行卡片：标题 + 横向滚动 + 放大覆盖层 + 行左右箭头。
//
// focused-index 是键盘焦点在本行内的局部索引（-1 表示焦点不在本行）；
// 悬停（hot）优先于键盘焦点，同一时刻只放大一张卡。
//
// 卡片放大：官方 `scale(1.05)`、延迟 400ms 触发、200ms ease-in-out、**无位移**
// （官方卡片结构就是"海报 + 卡下标题"，没有悬停信息面板，也不需要上移）；
// 放大卡是独立覆盖层（不参与行布局，其它卡坐标零跳动），且可以横向溢出
// 到左右留白区（裁切只发生在窗口边缘：纵向 Flickable 视口即遮罩）。
// 每边只溢出 6px / 10px，而行距 / 标题下距都是 12px，所以不会盖住行标题。
component CardRow inherits Rectangle {
    in property <string> title;
    // 这一行对应的媒体库 id（「查看全部 ›」跳到这里；空串表示没有对应库）。
    //
    // 「继续观看」「最近添加」是**跨库聚合行**，没有对应的库页：这类行不显示
    // 「查看全部 ›」，也不登记 `*.more` 目标（以前它会退回打开第一张卡的详情，
    // 用户点"查看全部"却进了某一部作品——假行为）。
    in property <string> library-id;
    in property <[CardData]> cards;
    // 2:3 海报行（最近添加）；默认 16:9 横版行。
    in property <bool> portrait: false;
    // 本行与上一块之间的间距（`HomePage` 把纵向布局的 `spacing` 归 0 后逐行下发）。
    //
    // 为什么不用布局的 `spacing`：Slint 的 `VerticalLayout` 对 **0 高的子项照样算
    // 间距**，于是空的继续观看 / 最近添加行会白占一个 `section-gap`（两行都空时
    // hero 到首行叠出 3 个，单行空时 2 个）。空行高 0、间距又在自己块内时，空行
    // 自然一个间距也不占（见 `CardRow.height`）。
    in property <length> gap-above: 0px;
    in property <int> focused-index: -1;
    // 用户是否已开始导航（见 `HomePage.nav-active`）：未激活时不放大焦点卡。
    in property <bool> nav-active: false;
    callback open-item(string);
    // 「查看全部 ›」：切到该行对应的媒体库页。
    callback tab-activated(string);
    // 可见图片窗口：本行在视口内时上报横向可见区间 `(row, first, count)`，
    // 不在视口内 / 页面离屏时报 `(-1, 0, 0)` 的空区间（滚出视口的图不再请求）。
    callback image-window(int, int, int);
    // 本行在 `HomePage` 里的行号（`0` = 继续观看，`1` = 最近添加，`2 + n` = 库行）。
    in property <int> image-row: -1;
    // 首页图片窗口代次（首页数据变化时由 Rust 推一档）。
    in property <int> image-gen: 0;
    // 页面是否在屏上（离屏时不请求图片）。
    in property <bool> page-active: false;
    // 页面纵向视口在内容坐标里的上沿 / 高度（外层 `Flickable`）。
    in property <length> page-scroll-top: 0px;
    in property <length> page-viewport-h: 0px;
    // 悬停到某张卡：把键盘焦点也移过来（之后方向键从这里继续，R2-3）。
    //
    // 焦点数学在 Rust（`move_focus_by`），但悬停只发生在这里；本组件改不了
    // 页面级的 `focus-index`，所以上报给 `HomePage` 去写（与 `PosterGrid` 悬停
    // 直接写 `focus-index` 是同一套语义）。
    callback focus-hover(int);
    // 键盘焦点落到本行的某张卡时，页面把**行内局部下标**写到这里（悬停不写）。
    //
    // 库行是 `for` 重复元素，页面拿不到它们的 `flick`，没法直接调 `scroll-to-card`；
    // 所以页面只下发「键盘滚到第 N 张」，由行自己执行。`-1` = 本行不是键盘焦点行。
    // 悬停只同步 `focus-index`（放大 / 方向键起点），绝不触发滚动（R7-1）。
    in property <int> keyboard-scroll: -1;
    // 键盘滚动**请求序号**（单调递增）：每次页面下发滚动请求都 +1。
    //
    // 只看 `keyboard-scroll` 的值不够：用户可能用滚轮把这一行横向滚走（只改
    // `flick.content-x`），再 ↑ 到 hero、↓ 回到同一格，或者行首按 ← / 末行按 ↓——
    // 这些场景里请求的 row/local 与上次完全相同，值没变就永远不重新滚动，焦点卡
    // 就留在视口外（A1）。所以真正触发滚动的是这个序号。
    in property <int> keyboard-scroll-seq: 0;
    // 悬停锁存复位序号（页面在**内容变化**时推一档，见 `App::set_home`）：清掉
    // `hot` / `latch`，再由仍有 `has-hover` 的卡重新点亮（卡片实例已复用，不会重建）。
    in property <int> hover-reset: 0;
    // 悬停**硬清**序号（页面在焦点被钳回 0 = 数据变少时推一档）。
    //
    // 与 `hover-reset` 的区别：那个会让仍有 `has-hover` 的卡重新点亮自己，这里不。
    // 数据变少会把行整体上下挪动，而 Slint 的 `has-hover` 只在指针事件里更新——
    // 指针停着不动时它就是**旧位置**的悬停，拿它重新点亮会把放大画到指针已经没有
    // 停留的那张卡上（行上移 274px 的真机场景）。
    in property <int> hover-clear: 0;

    // ---- 调试通道：本行的可交互目标（见 docs/ui-architecture.md）----
    // 行是重复元素（各库行），父组件没法把本行的目标拼进自己的 `targets` 数组，
    // 所以本行自己登记：卡片由 `PosterCard` 登记，"查看全部"与左右箭头在这里登记。
    in property <string> target-prefix: "";
    in property <bool> targets-visible: true;
    // 没有库 id 的行没有「查看全部 ›」可点，清单里也就不能有这一项。
    out property <[Target]> targets: root.library-id == "" ? [] : [
        {
            id: root.target-prefix + "more",
            kind: "button",
            label: "查看全部 ›",
            x: more-area.absolute-position.x,
            y: more-area.absolute-position.y,
            width: more-area.width,
            height: more-area.height,
        },
    ];

    // 图区宽 / 图区高（"图高"）：**不含**卡下标题。
    property <length> poster-width: root.portrait ? Theme.card-portrait-w : Theme.card-landscape-w;
    property <length> poster-height: root.portrait ? Theme.card-portrait-h : Theme.card-landscape-h;
    // 卡片总高 = 图高 + 卡下标题块（官方 `li` 结构）。
    property <length> card-height: root.poster-height + Theme.card-caption-height;
    property <int> hot: -1;
    // 悬停锁存：指针从基础卡移到放大后的加宽区/箭头上时，基础卡不再有悬停，
    // 用 latch 记住最后悬停的卡，只要覆盖层或箭头仍被悬停就保持放大。
    in-out property <int> latch: -1;
    changed hot => {
        if (root.hot >= 0) {
            root.latch = root.hot;
        }
    }
    changed hover-clear => {
        root.hot = -1;
        root.latch = -1;
    }
    // 悬停复算请求序号（`hover-reset` 时本行推一档，见下）。
    //
    // `has-hover` 是**边沿事件**：`hot` 被清掉之后，指针仍停在同一张卡上也不会
    // 自己重报。所以复算不能由行去读卡片的 `has-hover`（`for` 重复元素拿不到实例
    // 属性），改成把序号推下去、由**每张卡自己**按当前的 `has-hover` 决定要不要
    // 重新点亮自己。
    property <int> hover-gen: 0;
    // 页面要求重算悬停（**内容变化**时，Rust 推一档）：不复用旧下标。
    //
    // 只按长度判断太窄了——数据条数没变、但卡片被替换或整体前移时，同一个下标
    // 指向的已经不是指针下面那张卡。所以这里**全部清掉**，再让仍有 `has-hover`
    // 的卡自己把 `hot` / `latch` 点亮回来（以前无条件清零也留不住“指针没动”的
    // 悬停，`has-hover` 的边沿事件不会重发；而卡片实例现在是复用的，不再重建）。
    changed hover-reset => {
        // 指针停在放大覆盖层或左右箭头上时不动：那两种情况放大层本来就是指针下的
        // 对象（`zoom-index` 回退到 `latch`），清掉只会让指针底下的放大层自己消失。
        if (!(zoom-ov.hovered || arrow-left-area.has-hover || arrow-right-area.has-hover)) {
            root.hot = -1;
            root.latch = -1;
            root.hover-gen += 1;
        } else {
            // 跳过时也要把**越界**的那一项清掉：数据变少后 `hot` / `latch` 可能指着
            // 已经不存在的卡，而 `zoom-index` 会照着它算 ⇒ 放大层和左右箭头留在
            // 屏幕上再也下不去（箭头的可见条件是 `zoom-index >= 0`）。指针还在
            // 覆盖层 / 箭头上，所以只清越界的，别把指针底下的放大效果一起打掉。
            if (root.hot >= root.cards.length) {
                root.hot = -1;
            }
            if (root.latch >= root.cards.length) {
                root.latch = -1;
            }
        }
    }
    property <int> zoom-index: root.hot >= 0 ? root.hot
        : ((zoom-ov.hovered || arrow-left-area.has-hover || arrow-right-area.has-hover)
            ? root.latch : (root.nav-active ? root.focused-index : -1));
    // 卡间距：官方 12px（`margin-right:.75rem`），且必须 ≥ 放大卡横向溢出（6px）。
    property <length> gap: max(Theme.card-gap, Theme.zoom-allowance-x);
    // 标题下沿到卡顶：官方 12px（`row-title-gap` 已含放大余量下限的校验）。
    property <length> title-off: Theme.section-title-height + Theme.row-title-gap;
    property <float> zoom-factor: 1.0;

    // ---- 内容入场（数据到达）----
    //
    // 数据从空变为非空时：整行淡入（reveal 0 → 1）+ 整体上浮 6px（只动绘制位置，
    // 行高与子元素尺寸不变，所以"放大不跳布局"的断言仍成立）。没有定时器。
    //
    // 为什么用自定义 `reveal` 而不是直接 `animate opacity`：`opacity` 的默认值是 1，
    // 而"创建时不可见 / 还没被求值过"的元素上，动画会从默认值 1 过渡到 1，
    // 看上去就像没动画（Slint 的 animate 从属性当前值过渡）。`property <float>`
    // 的默认值是 0（恰好是隐藏态），所以从 0 起步一定看得见。
    property <float> reveal: root.cards.length > 0 ? 1 : 0;
    animate reveal {
        duration: Theme.motion-row;
        easing: cubic-bezier(0.5, 0, 0.1, 1);
    }
    opacity: root.reveal;
    // 位移由同一条进度反推（length 属性默认 0 = 终态，不能直接 animate）。
    property <length> rise: Theme.motion-rise * (1 - root.reveal);

    states [
        zoomed when root.zoom-index >= 0 : {
            zoom-factor: Theme.zoom-factor;
            in {
                animate zoom-factor {
                    // 官方 CSS：`transition: transform 0.2s ease-in-out`。
                    duration: Theme.motion-zoom;
                    delay: Theme.zoom-delay;
                    easing: ease-in-out;
                }
            }
            out {
                animate zoom-factor {
                    duration: Theme.motion-zoom;
                    easing: ease-in-out;
                }
            }
        }
    ]

    // 行高 = 行标题 + 标题下距 + 卡片总高（图高 + 卡下标题）。
    // 不需要额外的放大预留：1.05 最多向上溢出 10px（1.05×368 的一半），标题下距 12px 兜住；
    // 向下溢出落在 40px 的 `section-gap` 里。
    //
    // **空行不占一整块，也不占间距**（R7-C2 / R7-空白）：`visible: false` 的元素在
    // `VerticalLayout` 里照样占位，以前继续观看 / 最近添加为空时会在页面上留下一整块
    // 纯黑（真机半屏）。这里把空行的高度直接算成 0，而块间距 `gap-above` 也算在
    // `height` 里——空行高 0 就连它自己的间距一起消失。`HomePage` 的 `content-total`
    // 与 `library-card-top` 都读这些 `height` / `cards-top`，保持一致。
    height: root.cards.length > 0 ? root.cards-top + root.card-height : 0px;

    // 行标题 + 查看全部（与卡同起于 content-gutter）。
    HorizontalLayout {
        x: Theme.content-gutter;
        y: root.gap-above + root.rise;
        width: parent.width - Theme.content-gutter * 2;
        height: Theme.section-title-height;
        spacing: Theme.space-3;

        Text {
            text: root.title;
            color: Theme.text;
            font-family: Theme.font-family;
            // 官方 Hawkins Text 断点：<960 20/500、960–1279 24/500、≥1280 32/700。
            font-size: Theme.row-title-size;
            font-weight: Theme.row-title-weight;
            // 官方 `Text-TextLineHeight: 125%`。
            line-height-factor: Theme.text-line-height;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: transparent;
        }

        // 「查看全部 ›」只属于有对应媒体库的行；聚合行连文字都不显示
        // （不占视觉位置：背景透明，隐藏后留白与原来一致）。
        Rectangle {
            width: more-label.preferred-width;
            height: parent.height;
            background: transparent;
            visible: root.library-id != "";

            more-label := Text {
                width: parent.width;
                height: parent.height;
                text: "查看全部 ›";
                color: more-area.has-hover ? Theme.text : Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-14;
                vertical-alignment: center;
            }

            // 「查看全部 ›」= 打开该行对应的**媒体库列表页**。
            //
            // 以前这里打开的是行内第一张卡——用户点"查看全部"却进了某一部作品，
            // 语义完全不对（审计里把它记为"看着有反应其实是空转"）。
            // 聚合行（没有 `library-id`）干脆不显示这个入口，也不做任何退让式跳转。
            more-area := TouchArea {
                clicked => {
                    root.tab-activated(root.library-id);
                }
            }
        }
    }

    /// 键盘焦点卡移出可视区时，行内横向滚到焦点卡**完全可见**。
    ///
    /// 与左右箭头的翻页是同一个 Flickable（`flick.scroll-to` 用平滑滚动）；
    /// 键盘跟随要求确定性，所以直接写 `content-x`（与媒体库 / 搜索页的
    /// `scroll-to-index` 同一口径）。可见性按放大余量之后的矩形算。
    public function scroll-to-card(index: int) {
        if (index < 0 || index >= root.cards.length) {
            return;
        }
        let pad = Theme.zoom-allowance-x / 2;
        let left = Theme.content-gutter + index * (root.poster-width + root.gap);
        let right = left + root.poster-width;
        let view-left = -flick.content-x;
        let max-x = max(0px, flick.content-width - flick.width);
        if (left - pad < view-left) {
            flick.content-x = -clamp(left - pad, 0px, max-x);
        } else if (right + pad > view-left + flick.width) {
            flick.content-x = -clamp(right + pad - flick.width, 0px, max-x);
        }
    }

    // 只有键盘移动会改 `keyboard-scroll` / `keyboard-scroll-seq`（页面在 `scroll-to-index`
    // 里下发），悬停改的是 `focused-index`，不会走到这里——所以悬停不会把页面拽走（R7-1）。
    //
    // 触发条件是**请求序号**而不是下标值：滚轮把行滚走后再回到同一格，值不变、
    // 序号变了，仍然要重新滚（A1）。
    changed keyboard-scroll-seq => {
        if (root.nav-active && root.keyboard-scroll >= 0) {
            root.scroll-to-card(root.keyboard-scroll);
        }
    }

    // 横向滚动的基础卡片（尺寸恒定）：两端各留 gutter，
    // 滚动时卡片只在窗口边缘被裁掉（外层纵向视口即遮罩）。
    flick := Flickable {
        x: 0;
        y: root.cards-top + root.rise;
        width: parent.width;
        height: root.card-height;
        interactive: true;
        content-width: Theme.content-gutter * 2 + row.preferred-width;
        content-height: root.card-height;

        row := HorizontalLayout {
            // 行内容与正文列对齐（≥1920 为 200px，与 Netflix 实测列宽 1520 一致）。
            x: Theme.content-gutter;
            spacing: root.gap;
            height: root.card-height;

            for card[i] in root.cards : PosterCard {
                card: card;
                card-width: root.poster-width;
                image-height: root.poster-height;
                hover-gen: root.hover-gen;
                // 首页行是横版集数卡：官方 `li` 有 8px 内衬 + 2px 描边。
                framed: true;
                target-id: root.target-prefix + "card." + i;
                target-label: card.title;
                targets-visible: root.targets-visible;
                clicked => {
                    root.open-item(card.id);
                }
                hover-changed(has) => {
                    if (has) {
                        root.hot = i;
                        // 锁存也在这里写：`hover-reset` 是「清掉 `hot` / `latch` → 再让
                        // 仍有 `has-hover` 的卡重新点亮」两步，而 `hot` 在同一次属性
                        // 事务里先被清成 -1 又被写回 i，`changed hot` 会被合并掉（最终值没变），
                        // 指望它去恢复 `latch` 是保不住的（实测：重贴数据后指针一动，
                        // 覆盖层接管悬停时 `latch` 还是 -1，放大直接灭）。
                        root.latch = i;
                        // 悬停也是"当前焦点"：方向键必须从这张卡继续。
                        root.focus-hover(i);
                    } else if (root.hot == i) {
                        root.hot = -1;
                    }
                }
            }
        }
    }

    // 放大覆盖层：按 zoom-index 画一张放大的卡（后绘制 → 盖住相邻卡片）。
    // 常驻实例 + visible 门控：不参与布局，测试可以稳定读到覆盖层几何。
    zoom-ov := CardZoom {
        framed: true;
        property <int> zi: root.cards.length > 0
            ? clamp(root.zoom-index, 0, root.cards.length - 1) : 0;
        property <length> zw: root.poster-width * root.zoom-factor;
        property <length> zh: root.card-height * root.zoom-factor;
        // 基础卡中心（视口坐标）= 正文列起点 + idx*(w+gap) + w/2 - 滚动偏移。
        // 注意是 `content-gutter`（行内容真正的 x），不是装饰性的 `gutter`。
        property <length> center-x: Theme.content-gutter + zi * (root.poster-width + root.gap)
            + root.poster-width / 2 - flick.content-x;
        // 放大卡可以穿出左右留白（钳到窗口边缘）；纵向对齐卡片总高的中心。
        x: clamp(center-x - zw / 2, 0px, parent.width - zw);
        y: root.cards-top + root.rise + root.card-height / 2 - zh / 2;
        width: zw;
        visible: root.cards.length > 0 && root.zoom-index >= 0
            && root.zoom-index < root.cards.length;
        index: root.zoom-index;
        card: root.cards[zi];
        base-width: root.poster-width;
        base-image-height: root.poster-height;
        zoom-factor: root.zoom-factor;
        // 指针在放大覆盖层上（含“本来就停在这张卡上”的重复悬停）：焦点对齐到这张卡。
        // 底卡的 `has-hover` 在覆盖层接管后不再跳变，只靠它会把焦点留在键盘旧位置。
        hover(index, has) => {
            if (has && index >= 0 && index < root.cards.length) {
                root.focus-hover(index);
            }
        }
        clicked => {
            root.open-item(root.cards[root.zoom-index].id);
        }
    }

    // 放大覆盖层几何（测试断言「放大不跳布局」用：差异区域必须被它完全包含）。
    out property <bool> zoom-on: zoom-ov.visible;
    out property <length> zoom-rect-x: zoom-ov.x;
    out property <length> zoom-rect-y: zoom-ov.y;
    out property <length> zoom-rect-w: zoom-ov.width;
    out property <length> zoom-rect-h: zoom-ov.height;
    out property <length> arrow-y: arrow-left.y;
    // 卡区上沿 / 卡片总高（行内容坐标，不含行标题）：首页纵向滚动按
    // "它 + 卡片总高"算焦点行。
    out property <length> cards-top: root.gap-above + root.title-off;
    out property <length> cards-height: root.card-height;
    // 卡片区上沿（**不含**块间距）：页面反推库行卡片上沿时用（`cards-top` 含块间距）。
    out property <length> cards-offset: root.title-off;
    // 探针：焦点卡在行内容坐标里的左右沿 + 行自己的横向滚动偏移 / 视口宽。
    // 测试据此断言"焦点卡横向完全可见"（网格的对应探针在 `PosterGrid`）。
    out property <length> probe-focus-left: root.focused-index >= 0
        && root.focused-index < root.cards.length
        ? Theme.content-gutter + root.focused-index * (root.poster-width + root.gap) : -1px;
    out property <length> probe-focus-right: root.probe-focus-left < 0px ? -1px
        : root.probe-focus-left + root.poster-width;
    out property <length> probe-content-x: flick.content-x;
    out property <length> probe-viewport-w: flick.width;
    // 测试探针：卡下标题的下沿（放大卡上沿必须不低于它 = 不遮挡行标题）。
    out property <length> row-title-bottom: root.gap-above + root.rise + Theme.section-title-height;
    // 把本轮 `targets` 与左右箭头登记到总线（箭头只在悬停/有焦点时可见，
    // 隐藏时点击没有意义，所以按可见性登记）。
    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.targets-visible && root.visible) {
                TargetBus.register(target);
            }
        }
    }
    property <int> arrows-target-gen: TargetBus.gen;
    changed arrows-target-gen => {
        if (root.targets-visible && root.visible) {
            if (arrow-left.visible) {
                TargetBus.register({
                    id: root.target-prefix + "left",
                    kind: "scroll",
                    label: "向左滚动",
                    x: arrow-left-area.absolute-position.x,
                    y: arrow-left-area.absolute-position.y,
                    width: arrow-left-area.width,
                    height: arrow-left-area.height,
                });
            }
            if (arrow-right.visible) {
                TargetBus.register({
                    id: root.target-prefix + "right",
                    kind: "scroll",
                    label: "向右滚动",
                    x: arrow-right-area.absolute-position.x,
                    y: arrow-right-area.absolute-position.y,
                    width: arrow-right-area.width,
                    height: arrow-right-area.height,
                });
            }
        }
    }

    // 测试探针：图宽 / 图高 / 卡片总高。
    out property <length> poster-width-probe: root.poster-width;
    out property <length> poster-height-probe: root.poster-height;
    out property <length> card-total-height: root.card-height;

    // ---- 可见图片窗口 ----
    //
    // 首页以前把 hero + 继续观看 + 最近添加 + 各库行的键串成一个 Vec 交给 Rust，
    // Rust 只能 `take(120)`：第 108 张之后与后续库行永远没图（体检 R6-5）。
    // 现在每行自己算「纵向是否在页面视口内 + 行内横向可见区间」，把区间报给 Rust，
    // 由 Rust 按可见窗口请求；区间只在真的变化时上报（滚动事件很密）。
    property <bool> row-in-viewport: root.page-active
        && root.image-row >= 0
        && root.cards.length > 0
        && root.page-viewport-h > 0px
        && root.poster-width + root.gap > 0px
        && root.y + root.cards-top < root.page-scroll-top + root.page-viewport-h
        && root.y + root.cards-top + root.cards-height > root.page-scroll-top;
    property <length> card-step: root.poster-width + root.gap;
    property <length> row-view-left: -flick.content-x;
    // 可见区间上下各多取一张：卡片边缘跨在视口边界上时不会只剩骨架。
    property <int> first-visible-card: root.row-in-viewport
        ? clamp(floor((root.row-view-left - Theme.content-gutter) / root.card-step) - 1,
            0, root.cards.length - 1)
        : -1;
    property <int> last-visible-card: root.row-in-viewport
        ? clamp(ceil((root.row-view-left + flick.width - Theme.content-gutter) / root.card-step) + 1,
            0, root.cards.length)
        : 0;
    property <int> image-first: root.row-in-viewport ? root.first-visible-card : -1;
    property <int> image-count: root.row-in-viewport
        ? max(0, root.last-visible-card - root.first-visible-card) : 0;

    function report-images() {
        // 离屏（`page-active = false`）时也要上报：各行的 `image-first` / `image-count`
        // 此时已经是空区间（`row-in-viewport` 为假），把空窗口报给 Rust 才能清掉
        // `ImageScope::HomeRow(n)` 的可见集合（否则这些键永远被当成在屏上的图保护着）。
        if (root.image-row >= 0) {
            root.image-window(root.image-row, root.image-first, root.image-count);
        }
    }
    changed image-gen => { root.report-images(); }
    changed page-active => { root.report-images(); }
    changed image-first => { root.report-images(); }
    changed image-count => { root.report-images(); }

    // 行左右箭头：官方 24×80 胶囊（`width:1.5rem;height:5rem;border-radius:16rem`、
    // 底色 `rgba(128,128,128,.4)`），垂直居中于卡区，悬停行时出现；
    // 点击横向滚一屏。箭头叠在行两端（会盖住最外层卡，Netflix 同样如此）。
    arrow-left := Rectangle {
        x: 0;
        y: root.cards-top + root.rise + (root.poster-height - Theme.arrow-height) / 2;
        width: Theme.arrow-width;
        height: Theme.arrow-height;
        border-radius: Theme.radius-pill;
        background: Theme.arrow-bg;
        visible: root.zoom-index >= 0 || arrow-left-area.has-hover;
        // 悬停微交互：只降不透明度，图标本体不位移。
        opacity: arrow-left-area.has-hover ? 0.85 : 1;
        animate opacity {
            duration: Theme.motion-fast;
            easing: ease-out;
        }

        // ‹ 箭头：字体字形（Inter / DejaVu 都有 U+2039，实测不豆腐；
        // transform-rotation 在 1.19 渲染器里不生效，不能用短棒旋转拼）。
        Text {
            width: parent.width;
            height: parent.height;
            text: "\u{2039}";
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.arrow-glyph-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        arrow-left-area := TouchArea {
            clicked => {
                // 箭头翻页用 Flickable 内置的平滑滚动（`ScrollBehavior.smooth`）。
                //
                // 不直接给 `content-x` 加 `animate`：那会把用户拖拽/滚轮也套上缓动
                // （拖拽必须跟手，硬要求）。内置平滑滚动只影响这一次程序化定位，
                // 用户手势仍然逐帧跟手；缓动曲线是 Slint 库内的 spring 模拟，
                // 不走 `Theme` 时长 token（见 docs/ui-netflix-1to1.md 第 9 节说明）。
                flick.scroll-to({ x: -flick.content-x - root.width, y: -flick.content-y }, ScrollBehavior.smooth);
            }
        }
    }

    arrow-right := Rectangle {
        x: parent.width - self.width;
        y: arrow-left.y;
        width: Theme.arrow-width;
        height: Theme.arrow-height;
        border-radius: Theme.radius-pill;
        background: Theme.arrow-bg;
        visible: root.zoom-index >= 0 || arrow-right-area.has-hover;
        opacity: arrow-right-area.has-hover ? 0.85 : 1;
        animate opacity {
            duration: Theme.motion-fast;
            easing: ease-out;
        }

        // › 箭头：与左侧镜像（U+203A）。
        Text {
            width: parent.width;
            height: parent.height;
            text: "\u{203A}";
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.arrow-glyph-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        arrow-right-area := TouchArea {
            clicked => {
                flick.scroll-to({ x: -flick.content-x + root.width, y: -flick.content-y }, ScrollBehavior.smooth);
            }
        }
    }
}

export component HomePage inherits Rectangle {
    in property <HomeData> data;
    in-out property <int> focus-index: 0;
    // 键盘滚动请求（只由 `scroll-to-index` 写）：可视行号 + 行内局部下标。
    // 行组件把「自己是不是这一行」折成 `keyboard-scroll`（-1 = 不是），
    // 悬停路径永远不碰这两个属性（R7-1）。
    in-out property <int> keyboard-scroll-row: -1;
    in-out property <int> keyboard-scroll-local: -1;
    // 滚动请求序号（单调递增，每次请求 +1）：行只认它，因为「同一个 row/local」
    // 也要重新滚（滚轮把行滚走后 ↑ 到 hero、↓ 回来，或者行首 ← / 末行 ↓，A1）。
    property <int> keyboard-scroll-seq: 0;
    // 悬停锁存复位序号（Rust 在**内容变化**时推一档）：让各行的 `hot` / `latch`
    // 失效，再由仍有 `has-hover` 的卡重新点亮。
    in property <int> hover-reset: 0;
    // 悬停硬清序号（Rust 在焦点被钳回 0、数据变少时推一档）：只清不重算（见 `CardRow`）。
    in property <int> hover-clear: 0;
    // 用户是否已开始导航；未激活时行不放大任何卡（首屏保持"干净"，与 Netflix 一致）。
    in property <bool> nav-active: false;
    in property <bool> search-focused: false;
    // 搜索框文本（与 AppWindow 双向同步）。
    in-out property <string> search-text;

    // ---- 键盘焦点层（体检 R2-2b）----
    // `hero-focus` 是 hero 按钮行的焦点（0 = 播放、1 = 更多信息，-1 = 不在 hero 层）；
    // `nav-focus` 是顶栏的焦点下标（-1 = 不在顶栏）。两者都由 `AppWindow` 按当前
    // 焦点层门控后传进来，鼠标操作不会进入这两层。
    in property <int> hero-focus: -1;
    in property <int> nav-focus: -1;
    // 内容层是否持有键盘焦点：顶栏 / hero 层持有焦点时不再放大内容卡片，
    // 否则画面会同时出现两处焦点指示（放大卡 + 焦点环），分不清键盘焦点在哪。
    in property <bool> content-focused: true;

    callback open-item(string);
    callback hero-play();
    callback tab-activated(string);
    callback search();
    callback search-changed(string);
    callback search-submit();
    callback search-clear();
    callback search-escape();
    // 顶栏搜索框里仍要生效的全局快捷键（转发到 `AppWindow.key-intent`）。
    callback global-shortcut(int);
    // 空状态的“连接服务器”：真正的连接流程在上层（这里只发回调）。
    callback connect-server();
    // 图片可见窗口（行的上报汇总到上一级）：`row = -1` 是 hero。
    callback image-window(int, int, int);
    // 首页图片窗口代次（数据真变了时 Rust 推一档，让行重新上报区间）。
    in property <int> image-gen: 0;

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 首页自己直接摆放的控件全在条件子树里（hero 按钮）或是子组件（顶栏 / 卡片行 /
    // 空态），Slint 1.19 的数组属性无法拼接，所以都走 `TargetBus` 登记；
    // 这里的声明式数组只留"页面直接摆放且常驻"的控件——首页目前没有。
    out property <[Target]> targets: [];
    out property <int> debug-nav-tabs: nav.tabs.length;
    // 顶栏键盘焦点的几何探针（`navbar.slint` 的 `probe-*` 转发）。
    out property <length> probe-focus-tab-left: nav.probe-focus-tab-left;
    out property <length> probe-focus-tab-right: nav.probe-focus-tab-right;
    out property <length> probe-tabs-viewport-w: nav.probe-tabs-viewport-w;
    out property <length> probe-tabs-scroll-x: nav.probe-tabs-scroll-x;

    /// 把焦点交给搜索输入框（Ctrl+F / 点击搜索图标时由上层调到这里）。
    public function focus-input() {
        nav.focus-input();
    }

    /// 直接设置首页纵向滚动偏移（testing 快照 / 键盘导航用，不经过滚轮动画）。
    public function scroll-to-offset(y: length) {
        flick.content-y = y;
    }

    /// 键盘焦点移出可视区时，把焦点行 / 焦点卡滚进视口（体检 R2-2）。
    ///
    /// `index` 是扁平焦点索引，`row` 是**可视行号**（`0` = 继续观看、`1` = 最近添加、
    /// `2 + n` = 第 n 个库行；由 Rust 的 `HomeView::focus_row_at` 给出）。
    ///
    /// 纵向：外层 `flick` 滚到整行卡区完全可见（与媒体库 / 搜索页的
    /// `scroll-to-index` 同一套上下沿算法）。库行是 `for` 重复元素，页面拿不到
    /// 它们的 `y`，但可以从 `content-total` 的同一套常量反推行上沿（`library-card-top`）。
    /// 横向：页面只下发「本行第 N 张」，由行自己的 `changed keyboard-scroll` 执行
    /// （库行的 `flick` 页面调不到）。
    ///
    /// 这个函数**只由键盘路径调用**：悬停只同步焦点，不滚动（R7-1）。
    public function scroll-to-index(index: int, row: int) {
        if (index < 0 || row < 0) {
            return;
        }
        if (row == 0) {
            root.scroll-to-row(row0.y + row0.cards-top, row0.cards-height);
            root.request-row-scroll(0, index);
            return;
        }
        if (row == 1) {
            root.scroll-to-row(row1.y + row1.cards-top, row1.cards-height);
            root.request-row-scroll(1, index - root.continue-count);
            return;
        }
        let ri = row - 2;
        if (ri >= root.data.library-rows.length) {
            return;
        }
        root.scroll-to-row(root.library-card-top(ri),
            Theme.card-landscape-h + Theme.card-caption-height);
        root.request-row-scroll(row, index - root.data.library-row-starts[ri]);
    }

    /// 库行卡区上沿（内容坐标）：与 `content-total` / `VerticalLayout` 同一套几何。
    ///
    /// 行顺序固定：hero → 继续观看 → 最近添加 → 各库行，块间距 `section-gap`；
    /// 没有 hero 时第一个块从 0 开始（hero 是 `if` 子树，不会留空槽）。
    ///
    /// 块高一律读 `CardRow` 自己报的值（`height` / `cards-top` / `cards-height`），
    /// 页面里不再抄一份“标题 + 卡片高”的公式（A4：以前 `library-card-top` 与
    /// `continue/recent/library-row-h` 是同一公式的三份拷贝）。
    function library-card-top(ri: int) -> length {
        // 块间距已经挪进各块自己的上边距（空行不占间距），所以这里按“块高含间距”
        // 一路累加：`row0` / `row1` 的 `height` 与 `library-block-h` 都含 `gap-above`。
        return root.billboard-slot
            + row0.height + row1.height
            + ri * root.library-block-h
            + root.library-gap + row0.cards-offset;
    }

    /// 下发键盘滚动：本行横向跟随；`local` 是行内下标（非本行时为 -1）。
    ///
    /// 每次请求都推进序号：行只认序号变化，所以「同一个 row/local」也会重新执行
    /// `scroll-to-card`（A1：轮滚滚走后回到同一格、行首 ←、末行 ↓）。
    function request-row-scroll(row: int, local: int) {
        root.keyboard-scroll-row = row;
        root.keyboard-scroll-local = local;
        root.keyboard-scroll-seq = root.keyboard-scroll-seq + 1;
    }

    // 纵向让一段卡区（上沿 + 卡片总高）完全可见；视口是外层 `flick`。
    // （Slint 的 `function` 默认就是组件私有，只有 `public function` 才对父组件可见。）
    function scroll-to-row(top: length, card-height: length) {
        let pad = Theme.zoom-allowance-y / 2;
        let view-top = -flick.content-y;
        let max-y = max(0px, flick.content-height - flick.height);
        if (top - pad < view-top) {
            flick.content-y = -clamp(top - pad, 0px, max-y);
        } else if (top + card-height + pad > view-top + flick.height) {
            flick.content-y = -clamp(top + card-height + pad - flick.height, 0px, max-y);
        }
    }

    background: Theme.bg;

    // billboard 高度的 **vh 封顶比例**（默认 0.88）。
    //
    // 主值来自官方 `.billboard{height:56.25vw}`（见 `Theme.billboard-height`）；
    // 但官方那个高度是**绝对定位的背景层**，外面还有 `.billboard-row{padding-bottom:40%}`
    // 给内容流定高，所以 100vh 的 hero 不会挤掉行。我们的 hero 是内容流里的一个块，
    // 直接取 56.25vw 在 1280×800 会把首行卡片推到 y=802（窗口只有 800）——实测快照里
    // 行区完全看不到。所以用 88vh 封顶（**非官方值**，可用性折中）：1280×800 下
    // 还留 14px 卡顶，1920×1080 下 950px。取 92vh 也会挤光（720 → 卡顶 802），
    // 故不用任务书里的 92。详细算术见 docs/ui-netflix-1to1.md §10。
    // testing 快照可调小以拍到行区。
    in property <float> billboard-ratio: 0.88;

    // 当前纵向滚动偏移（测试 / 调试用）。
    out property <length> scroll-y: flick.content-y;

    // billboard 槽位：hero 块占的高度（内容坐标里 hero 的底边）。
    //
    // 比 88vh 少 16px：块间距 40px，补回后首行标题正好
    // 落在 billboard（88vh）底 24px 处。
    property <length> billboard-slot: root.data.has-hero ? billboard-height - 16px : 0px;
    // 行高 = 行标题（`section-title-height`）+ 标题下距（`row-title-gap`）
    // + 卡片总高（图高 + 卡下标题）。不需要放大预留：1.05 的溢出（上下共 16.8px）
    // 全部落在标题下距 12px 与行间距 40px 里（见 `Theme.zoom-allowance-*`）。
    //
    // 这些值不再在页面里重写：真正的高度读 `row0.height` / `row1.height`（空行是 0，
    // 见 `CardRow.height`，R7-C2）；库行与继续观看同一种横版行，用 `row0` 报的
    // `cards-offset + cards-height`（空行时它仍然是完整块的几何）。
    property <length> library-row-h: row0.cards-offset + row0.cards-height;
    // 库行块高 = 库行间距 + 行高（与 `CardRow.height` 同源）。
    property <length> library-block-h: root.library-gap + root.library-row-h;
    // 各块的**上边距**：布局的 `spacing` 已归 0（见 `row0` 处的注释），间距单独下发，
    // 空行时随 `CardRow.height = 0` 一起消失。
    property <length> gap-above-row0: root.data.has-hero ? Theme.section-gap : 0px;
    property <length> gap-above-row1: root.data.has-hero || root.continue-count > 0
        ? Theme.section-gap : 0px;
    property <length> library-gap: root.data.has-hero || root.continue-count > 0
        || root.recent-count > 0 ? Theme.section-gap : 0px;
    // 内容总高度：显式计算（不用 preferred-height —— 无头渲染器布局中途
    // 会把未决的 preferred 读成 0，Flickable 会把 content-y 钳回 0）。
    //
    // 每一块的高度都含自己的上边距（`gap-above`），所以这里不再单独加
    // `(块数 - 1) × section-gap`：空行高 0 = 连间距一起消失，hero 底到首个
    // 可见行标题顶恒是一个 `section-gap`（以前空行高 0 但布局照样给它算间距）。
    property <length> content-total: root.billboard-slot
        + row0.height + row1.height
        + root.data.library-rows.length * root.library-block-h
        + Theme.space-8;
    out property <length> content-h: flick.content-height;

    // ---- 可见图片窗口：hero ----
    //
    // hero 的背景图（1280 宽）只在它真的在视口里时请求；页面离屏时清空（`row = -1`）。
    property <bool> page-active: root.visible;
    property <bool> hero-in-view: root.page-active && root.data.has-hero
        && -flick.content-y < root.billboard-slot;
    property <int> hero-image-count: root.hero-in-view ? 1 : 0;
    changed hero-image-count => { root.image-window(-1, 0, root.hero-image-count); }
    changed image-gen => { root.image-window(-1, 0, root.hero-image-count); }
    changed page-active => { root.image-window(-1, 0, root.hero-image-count); }

    // Billboard：官方 56.25vw，用 88vh 封顶（非官方，理由见 `billboard-ratio`）。
    property <length> billboard-height: min(Theme.billboard-height, self.height * root.billboard-ratio);
    property <int> continue-count: root.data.continue-watching.length;
    property <int> recent-count: root.data.recently-added.length;
    // 键盘焦点落到行内的局部索引（焦点不在该行时为 -1）。
    property <int> continue-focus: root.focus-index < root.continue-count
        ? root.focus-index : -1;
    // 页面级内容入场：数据到达时整块淡入（reveal 默认 0 = 隐藏态，见 CardRow 注释）。
    property <float> reveal: root.data.empty ? 0 : 1;
    animate reveal {
        duration: Theme.motion-slow;
        easing: ease-out;
    }
    // 焦点不在本行（越界）时必须是 -1：大下标不能点亮下一行的箭头/放大。
    property <int> recent-focus: root.focus-index >= root.continue-count
        && root.focus-index - root.continue-count < root.recent-count
        ? root.focus-index - root.continue-count : -1;

    // ---- 探针：键盘焦点行 / 焦点卡（首页滚动跟随的回归断言用）----
    //
    // 焦点矩形一律报**视口相对**坐标（与媒体库 / 搜索页同一口径）：纵向加外层
    // `flick.content-y`，横向加焦点行自己的 `content-x`。
    //
    // 为什么必须加内层偏移（体检 R3-2）：首页行是**横向 Flickable**，「最近添加」
    // 是一整条很长的横向行（不是嵌套网格），它的滚动完全不进 `scroll_y`。只报内容
    // 坐标时，行内滚动一大截后 `focus_left/right` 仍是内容坐标，看起来“在视口内”，
    // 实际早就滚出去了。现在“焦点卡在视口内”可以直接判断：
    // `0 ≤ focus_top && focus_bottom ≤ viewport_h`、
    // `0 ≤ focus_left && focus_right ≤ row_viewport_w`。
    // 这四个探针只覆盖前两行（页面直接名字引用得到的行）。焦点在库行时一律报 -1：
    // 库行是 `for` 重复元素，页面拿不到它们的 `y` / `flick`（用 `targets` 里的
    // `home.row.lib.N.card.M` 窗口坐标判断可见性）。
    property <bool> probe-focus-in-rows: root.focus-index >= 0
        && root.focus-index < root.continue-count + root.recent-count;
    out property <bool> probe-focus-in-continue: root.focus-index < root.continue-count;
    out property <length> probe-viewport-h: flick.height;
    out property <length> probe-focus-top: !root.probe-focus-in-rows ? -1px
        : (root.probe-focus-in-continue
            ? row0.y + row0.cards-top : row1.y + row1.cards-top) + flick.content-y;
    out property <length> probe-focus-bottom: !root.probe-focus-in-rows ? -1px
        : (root.probe-focus-in-continue
            ? row0.y + row0.cards-top + row0.cards-height
            : row1.y + row1.cards-top + row1.cards-height) + flick.content-y;
    out property <length> probe-row-content-x: !root.probe-focus-in-rows ? -1px
        : root.probe-focus-in-continue ? row0.probe-content-x : row1.probe-content-x;
    out property <length> probe-row-viewport-w: !root.probe-focus-in-rows ? -1px
        : root.probe-focus-in-continue ? row0.probe-viewport-w : row1.probe-viewport-w;
    out property <length> probe-focus-left: !root.probe-focus-in-rows ? -1px
        : (root.probe-focus-in-continue
            ? row0.probe-focus-left : row1.probe-focus-left) + root.probe-row-content-x;
    out property <length> probe-focus-right: !root.probe-focus-in-rows ? -1px
        : (root.probe-focus-in-continue
            ? row0.probe-focus-right : row1.probe-focus-right) + root.probe-row-content-x;

    // 测试用：继续观看行的几何（「放大不跳布局」断言的基准）。
    out property <length> row0-y: row0.y - flick.content-y;
    out property <length> zoom-rect-x: row0.zoom-rect-x;
    out property <length> zoom-rect-y: row0.zoom-rect-y + row0.y - flick.content-y;
    out property <length> zoom-rect-w: row0.zoom-rect-w;
    out property <length> zoom-rect-h: row0.zoom-rect-h;
    out property <bool> row0-zoom-on: row0.zoom-on;
    // 最近添加（row1）的放大层是否打开。回归用：焦点之前的行缩量时指针已离开，
    // 第 1 行不能还亮着放大（见 `App::set_home` 的悬停硬清）。
    out property <bool> row1-zoom-on: row1.zoom-on;
    out property <length> row0-arrow-y: row0.arrow-y + row0.y - flick.content-y;
    // 测试用：行标题下沿 / 图高 / 卡片总高（验收"放大卡不遮盖行标题"与
    // "卡片总高 = 图高 + 卡下标题"两条）。
    out property <length> row0-title-bottom: row0.row-title-bottom + row0.y - flick.content-y;
    out property <length> row0-poster-width: row0.poster-width-probe;
    out property <length> row0-poster-height: row0.poster-height-probe;
    out property <length> row0-card-height: row0.card-total-height;
    // 竖版行（最近添加）同一组探针：官方 240×336 的 5:7 海报在这里。
    out property <length> row1-poster-width: row1.poster-width-probe;
    out property <length> row1-poster-height: row1.poster-height-probe;
    out property <length> row1-card-height: row1.card-total-height;
    // 探针：hero 底边（内容坐标）。与首个可见行标题顶一起校验“空行不占间距”：
    // 两者的差恒为一个 `section-gap`（块间距已挪进各行自己的 `gap-above`）。
    out property <length> hero-bottom: root.billboard-slot;
    out property <length> row1-title-bottom: row1.row-title-bottom + row1.y - flick.content-y;

    // 注意：这里**不用** `visible` 门控，改成 opacity 驱动（`reveal`）。
    // 原因：Slint 对"属性第一次求值"不播动画，若用 `visible: false` 藏起来，
    // 数据到达的那一刻才是它第一次被绘制 → 入场淡入会被跳过。
    // 空数据时 flick 里没有任何可见内容（billboard / 行都不实例化），
    // 所以"常驻 + opacity 0"与原来的"隐藏"视觉一致；同时把 `interactive` 关掉，
    // 避免一层不可见的滚动区抢走空态面板的滚轮/点击。
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        interactive: !root.data.empty;
        content-width: self.width;
        content-height: root.content-total;
        // 内容入场：数据到达（空 → 非空）时整块淡入。行自己再叠 6px 上浮（CardRow.rise）。
        opacity: root.reveal;

        content := VerticalLayout {
            width: parent.width;
            height: root.content-total;
            // 块间距**不**交给布局：`VerticalLayout` 对 0 高的子项照样算 `spacing`，
            // 空的继续观看 / 最近添加行会白占一个 `section-gap`（两行都空时 hero
            // 到首行叠出 3 个）。间距改成每行自己的 `gap-above`（含在行高里）。
            spacing: 0px;
            padding-bottom: Theme.space-8;

            // ---- Billboard ----
            if (root.data.has-hero) :
                hero := Rectangle {
                    width: parent.width;
                    // 槽位比 88vh 少 16px：补回块间距后首行距 billboard 底 24px。
                    height: root.billboard-height - 16px;
                    clip: true;

                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: root.data.hero.image;
                        image-fit: cover;
                    }

                    // 底部渐变（#00000000 → #000000E6）。
                    Rectangle {
                        x: 0;
                        y: parent.height * 0.4;
                        width: parent.width;
                        height: parent.height * 0.6;
                        background: @linear-gradient(180deg, #00000000 0%, Theme.scrim 100%);
                    }

                    // 左侧横向渐变，保证文字可读。
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        background: @linear-gradient(90deg, Theme.scrim 0%, #00000000 65%);
                    }

                    // 文案块：底边锚在距 billboard 底 18% 处（清单数值）。
                    // 用固定高度容器 + alignment: end，不依赖 preferred-height 反推。
                    // 入场：随内容整体上浮 6px 归位（由页面级 `reveal` 反推，不再单独 animate）。
                    Rectangle {
                        x: Theme.billboard-left;
                        width: parent.width - Theme.billboard-left - Theme.gutter;
                        // 有简介：标题 58 + 元信息 20 + 简介 78 + 按钮 44 + 间距；无简介收紧。
                        height: root.data.hero.overview != "" ? 240px : 160px;
                        y: parent.height * 0.82 - self.height
                            + Theme.motion-rise * (1 - root.reveal);
                        background: transparent;

                        VerticalLayout {
                            width: parent.width;
                            height: parent.height;
                            alignment: end;
                            spacing: Theme.space-3;

                        Text {
                            text: root.data.hero.title;
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-48;
                            // 官方 hero h1 字重是 Hawkins `Text` 的最大档 900。
                            font-weight: Theme.weight-black;
                            height: 58px;
                            overflow: elide;
                            wrap: no-wrap;
                        }

                        // 条件实例而不是 visible:false：布局器不给未实例化的元素留位，
                        // 无副标题/简介时按钮真正收紧（visible:false 仍会被 VerticalLayout 占位）。
                        if (root.data.hero.subtitle != "") :
                            Text {
                                text: root.data.hero.subtitle;
                                color: Theme.text-muted;
                                font-family: Theme.font-family;
                                font-size: Theme.font-14;
                                height: 20px;
                                overflow: elide;
                                wrap: no-wrap;
                            }

                        if (root.data.hero.overview != "") :
                            Text {
                                text: root.data.hero.overview;
                                color: Theme.text;
                                font-family: Theme.font-family;
                                font-size: Theme.font-16;
                                width: 560px;
                                height: 78px;
                                wrap: word-wrap;
                                overflow: elide;
                            }

                            HorizontalLayout {
                                spacing: Theme.space-3;

                            // 调试通道：hero 的两个按钮在条件子树里（只有有简介时才实例化），
                            // 只能由这块自己登记（id 固定 `home.hero.*`）。
                            property <int> target-gen: TargetBus.gen;
                            changed target-gen => {
                                if (root.visible) {
                                    TargetBus.register({
                                        id: "home.hero.play",
                                        kind: "button",
                                        label: "▶  播放",
                                        x: hero-play-area.absolute-position.x,
                                        y: hero-play-area.absolute-position.y,
                                        width: hero-play-area.width,
                                        height: hero-play-area.height,
                                    });
                                    TargetBus.register({
                                        id: "home.hero.info",
                                        kind: "button",
                                        label: "更多信息",
                                        x: hero-info-area.absolute-position.x,
                                        y: hero-info-area.absolute-position.y,
                                        width: hero-info-area.width,
                                        height: hero-info-area.height,
                                    });
                                }
                            }

                            // ▶ 播放：白底黑字。
                            Rectangle {
                                width: Theme.play-button-width;
                                height: Theme.button-primary-height;
                                // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                                border-radius: Theme.radius-button;
                                background: Theme.btn-primary-bg;

                                // 悬停洗色：opacity 过渡而不是 visible 硬切。
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.wash;
                                    opacity: hero-play-area.has-hover ? 1 : 0;
                                    animate opacity {
                                        // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                                        duration: Theme.motion-button;
                                        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                                    }
                                }

                                // 按压反馈（scale 0.98 的近似，见 Theme.press-wash 注释）。
                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.press-wash;
                                    opacity: hero-play-area.pressed ? 1 : 0;
                                    animate opacity {
                                        // 官方 Hawkins 令牌：Button-DurationPressed 0ms（按下立即生效）。
                                        duration: Theme.motion-press;
                                        easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                                    }
                                }

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "▶  播放";
                                    color: Theme.btn-primary-fg;
                                    font-family: Theme.font-family;
                                    font-size: Theme.font-14;
                                    font-weight: Theme.weight-semibold;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                hero-play-area := TouchArea {
                                    clicked => {
                                        root.hero-play();
                                    }
                                }

                                // 键盘焦点环（体检 R2-2b）：只有方向键进入 hero 层时
                                // `hero-focus` 才为 0（鼠标悬停/点击不会点亮它）。
                                FocusRing {
                                    x: -Theme.focus-offset;
                                    y: -Theme.focus-offset;
                                    width: parent.width + Theme.focus-offset * 2;
                                    height: parent.height + Theme.focus-offset * 2;
                                    ring-radius: Theme.radius-button + Theme.focus-offset;
                                    active: root.nav-active && root.hero-focus == 0;
                                }
                            }

                            // ⓘ 更多信息：半透明白底。
                            Rectangle {
                                width: Theme.info-button-width;
                                height: Theme.button-primary-height;
                                // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                                border-radius: Theme.radius-button;
                                background: Theme.btn-secondary-bg;

                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.wash;
                                    opacity: hero-info-area.has-hover ? 1 : 0;
                                    animate opacity {
                                        duration: Theme.motion-button;
                                        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                                    }
                                }

                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    border-radius: parent.border-radius;
                                    background: Theme.press-wash;
                                    opacity: hero-info-area.pressed ? 1 : 0;
                                    animate opacity {
                                        duration: Theme.motion-press;
                                        easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                                    }
                                }

                                HorizontalLayout {
                                    x: Theme.space-3;
                                    width: parent.width - Theme.space-3 * 2;
                                    height: parent.height;
                                    spacing: Theme.space-2;
                                    cross-axis-alignment: center;

                                    // ⓘ 图标：描边圆 + i，避免字体缺字形。
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        border-radius: Theme.radius-pill;
                                        border-width: 1.5px;
                                        border-color: Theme.text;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "i";
                                            color: Theme.text;
                                            font-family: Theme.font-family;
                                            font-size: 10px;
                                            font-weight: Theme.weight-bold;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        height: parent.height;
                                        text: "更多信息";
                                        color: Theme.text;
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-14;
                                        font-weight: Theme.weight-semibold;
                                        vertical-alignment: center;
                                    }
                                }

                                hero-info-area := TouchArea {
                                    clicked => {
                                        root.open-item(root.data.hero.id);
                                    }
                                }

                                // 同上：`hero-focus == 1` = 键盘焦点在「更多信息」上。
                                FocusRing {
                                    x: -Theme.focus-offset;
                                    y: -Theme.focus-offset;
                                    width: parent.width + Theme.focus-offset * 2;
                                    height: parent.height + Theme.focus-offset * 2;
                                    ring-radius: Theme.radius-button + Theme.focus-offset;
                                    active: root.nav-active && root.hero-focus == 1;
                                }
                            }
                            }
                        }
                    }

                    // 右下角徽标：描边胶囊（4K / HDR）。
                    if (root.data.hero.badge != "") :
                        Rectangle {
                            x: parent.width - self.width - Theme.billboard-left;
                            // 与按钮同一行（按钮高 44，徽标 24 → 上移 34 居中）。
                            y: parent.height * 0.82 - 34px;
                            width: hero-badge.preferred-width + Theme.space-3;
                            height: 24px;
                            border-radius: Theme.radius-badge;
                            border-width: 1px;
                            border-color: Theme.text-muted;
                            background: transparent;

                            hero-badge := Text {
                                x: Theme.space-2;
                                height: parent.height;
                                text: root.data.hero.badge;
                                color: Theme.text;
                                font-family: Theme.font-family;
                                font-size: Theme.font-12;
                                vertical-alignment: center;
                            }
                        }
                }

            // ---- 继续观看（16:9 横版缩略图，带进度）----
            // 常驻实例 + `visible` 门控：`visible: false` 只影响绘制，**不**让本行从
            // 纵向布局里消失（行高照算）。所以 `content-total` 必须把这两行**无条件**
            // 算进去（体检 R7-1：当时按“非空行数”算，空行一出现内容总高就少一整行，
            // 最后一个库行永远滚不进视口）。
            // 块间距走 `gap-above`（布局 `spacing` 已归 0），空行高 0 ⇒ 连间距一起消失。
            // 好处是测试 / 探针能稳定读到行几何（行总是实例化的）。
            row0 := CardRow {
                width: parent.width;
                visible: root.continue-count > 0;
                gap-above: root.gap-above-row0;
                target-prefix: "home.row.continue.";
                targets-visible: root.visible;
                title: "继续观看";
                cards: root.data.continue-watching;
                focused-index: root.continue-focus;
                keyboard-scroll: root.keyboard-scroll-row == 0
                    ? root.keyboard-scroll-local : -1;
                keyboard-scroll-seq: root.keyboard-scroll-seq;
                hover-reset: root.hover-reset;
                hover-clear: root.hover-clear;
                nav-active: root.nav-active && root.content-focused;
                image-row: 0;
                image-gen: root.image-gen;
                page-active: root.page-active;
                page-scroll-top: -flick.content-y;
                page-viewport-h: flick.height;
                image-window(row, first, count) => {
                    root.image-window(row, first, count);
                }
                open-item(id) => {
                    root.open-item(id);
                }
                focus-hover(index) => {
                    root.focus-index = index;
                }
            }

            // ---- 最近添加（2:3 竖版海报）----
            row1 := CardRow {
                width: parent.width;
                visible: root.recent-count > 0;
                gap-above: root.gap-above-row1;
                target-prefix: "home.row.recent.";
                targets-visible: root.visible;
                title: "最近添加";
                portrait: true;
                cards: root.data.recently-added;
                focused-index: root.recent-focus;
                keyboard-scroll: root.keyboard-scroll-row == 1
                    ? root.keyboard-scroll-local : -1;
                keyboard-scroll-seq: root.keyboard-scroll-seq;
                hover-reset: root.hover-reset;
                hover-clear: root.hover-clear;
                nav-active: root.nav-active && root.content-focused;
                image-row: 1;
                image-gen: root.image-gen;
                page-active: root.page-active;
                page-scroll-top: -flick.content-y;
                page-viewport-h: flick.height;
                image-window(row, first, count) => {
                    root.image-window(row, first, count);
                }
                open-item(id) => {
                    root.open-item(id);
                }
                focus-hover(index) => {
                    // 最近添加是一整行（视觉上不切块），局部索引 + 继续观看张数
                    // 才是扁平焦点索引（与 `HomeView::focus_rows` 的映射一致）。
                    root.focus-index = root.continue-count + index;
                }
            }

            // ---- 各库前 20 条（16:9，标题 = 库名）----
            for row-data[ri] in root.data.library-rows :
                CardRow {
                    // 库里也有键盘焦点：局部下标 = 扁平焦点 - 本行起点（体检 R7-2：
                    // 以前库行根本没接 `focused-index` / `focus-hover`，于是鼠标悬停
                    // 不对齐、键盘更是整行进不去）。
                    property <int> local-focus: root.focus-index
                        - root.data.library-row-starts[ri];
                    width: parent.width;
                    visible: row-data.cards.length > 0;
                    gap-above: root.library-gap;
                    target-prefix: "home.row.lib." + ri + ".";
                    targets-visible: root.visible;
                    title: row-data.title;
                    library-id: row-data.library-id;
                    cards: row-data.cards;
                    image-row: 2 + ri;
                    image-gen: root.image-gen;
                    page-active: root.page-active;
                    page-scroll-top: -flick.content-y;
                    page-viewport-h: flick.height;
                    focused-index: local-focus >= 0
                        && local-focus < row-data.cards.length ? local-focus : -1;
                    keyboard-scroll: root.keyboard-scroll-row == 2 + ri
                        ? root.keyboard-scroll-local : -1;
                    keyboard-scroll-seq: root.keyboard-scroll-seq;
                    hover-reset: root.hover-reset;
                    hover-clear: root.hover-clear;
                    nav-active: root.nav-active && root.content-focused;
                    focus-hover(index) => {
                        root.focus-index = root.data.library-row-starts[ri] + index;
                    }
                    image-window(row, first, count) => {
                        root.image-window(row, first, count);
                    }
                    tab-activated(id) => {
                        root.tab-activated(id);
                    }
                    open-item(id) => {
                        root.open-item(id);
                    }
                }
        }
    }

    if (root.data.empty) :
        EmptyState {
            width: parent.width;
            height: parent.height;
            target-prefix: "home.";
            targets-visible: root.visible;
            title: "媒体库还是空的";
            message: "连接一个 Emby 或 Jellyfin 服务器后，这里会出现最近添加与继续观看。";
            primary-label: "连接服务器";
            secondary-label: "搜索本地缓存";
            primary => {
                root.connect-server();
            }
            secondary => {
                root.search();
            }
        }

    // 顶栏最后绘制：透明浮在 billboard 上；滚动 40px 后变实底。
    nav := Navbar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height;
        tabs: root.data.tabs;
        current-index: root.data.current-tab;
        scrolled: !root.data.empty && flick.content-y < -40px;
        target-prefix: "home.";
        targets-visible: root.visible;
        focus-index: root.nav-focus;
        search-focused: root.search-focused;
        search-text <=> root.search-text;
        tab-activated(id) => {
            root.tab-activated(id);
        }
        search => {
            root.search();
        }
        search-changed(text) => {
            root.search-changed(text);
        }
        search-submit => {
            root.search-submit();
        }
        search-clear => {
            root.search-clear();
        }
        search-escape => {
            root.search-escape();
        }
        global-shortcut(code) => {
            root.global-shortcut(code);
        }
    }
}

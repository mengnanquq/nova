//! 媒体库（Netflix 风格）：标题 + 数量、6 列（≥1440 宽 7 列）2:3 网格、12px 间距。
//!
//! 放大用独立覆盖层（`CardZoom`）：网格里基础卡片尺寸恒定，
//! 覆盖层按焦点/悬停索引定位绘制，后绘制盖住相邻卡片，布局零跳动。

import { Theme } from "theme.slint";
import { LibraryData, Target, TargetBus } from "models.slint";
import { Navbar } from "navbar.slint";
import { PosterGrid } from "poster_grid.slint";
import { EmptyState } from "empty_state.slint";

export component LibraryPage inherits Rectangle {
    in property <LibraryData> data;
    in-out property <int> focus-index: 0;
    // 用户是否已开始导航；未激活时网格不放大任何卡（见 `poster_grid.slint`）。
    in property <bool> nav-active: false;
    in property <bool> search-focused: false;
    // 搜索框文本（与 AppWindow 双向同步）。
    in-out property <string> search-text;

    callback open-item(string);
    callback tab-activated(string);
    callback sort();
    callback search();
    callback search-changed(string);
    callback search-submit();
    callback search-clear();
    callback search-escape();
    // 顶栏搜索框里仍要生效的全局快捷键（转发到 `AppWindow.key-intent`）。
    callback global-shortcut(int);

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 排序按钮是页面直接摆放、常驻的控件 → 声明式列出；网格卡片 / 顶栏标签 /
    // 空态按钮在子组件或条件子树里 → 由它们自己登记到 `TargetBus`。
    // 空库时排序条不显示（点了也没有意义），清单里也就不该出现。
    out property <[Target]> targets: root.data.empty ? [] : [
        {
            id: "library.sort",
            kind: "button",
            label: root.data.sort-label + "  ▼",
            x: sort-area.absolute-position.x,
            y: sort-area.absolute-position.y,
            width: sort-area.width,
            height: sort-area.height,
        },
    ];

    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.visible && !root.data.empty) {
                TargetBus.register(target);
            }
        }
    }

    /// 把焦点交给搜索输入框（Ctrl+F / 点击搜索图标时由上层调到这里）。
    public function focus-input() {
        nav.focus-input();
    }

    background: Theme.bg;

    // 网格几何：用 `content-gutter`（≥1920 为 200px），列数按实测反推
    // ——Netflix 1920 下正文列宽 1520，6 张 240 宽海报 + 12px 间距正好铺满，
    // 所以 1920 是 6 列而不是 7 列；更窄的视口沿用 6 列，仅靠列宽自适应。
    // 卡宽 / 图高 / 卡片总高 / 行高 / 列起点由 `PosterGrid` 统一计算（搜索页共用同一套）。
    property <int> columns: 6;
    // 网格起点：标题行下沿（行高 = 卡片总高 + 行间距，由 `PosterGrid` 算）。
    property <length> grid-y: Theme.navbar-height + Theme.space-5 + Theme.text-h4-size
        + Theme.space-4;

    // 不用 `visible` 门控网格：Slint 对属性的"第一次求值"不播动画，
    // 若数据到达之前它是隐藏的，网格入场淡入（`PosterGrid.reveal`）会被跳过。
    // 网格在卡片为空时不画任何东西，所以"常驻 + 内含空网格"与"隐藏"视觉一致；
    // `interactive` 关掉，避免不可见的滚动区抢走空态面板的输入。
    grid-flick := Flickable {
        width: parent.width;
        height: parent.height;
            interactive: !root.data.empty;
            content-width: self.width;
            content-height: content.height;

            content := Rectangle {
                width: parent.width;

                // 标题 + 数量 + 排序（空数据时藏起来，别在空态面板后面露出"0 部"）。
                HorizontalLayout {
                    visible: !root.data.empty;
                    x: Theme.content-gutter;
                    y: Theme.navbar-height + Theme.space-5;
                    width: parent.width - Theme.content-gutter * 2;
                    height: Theme.text-h4-size;
                    spacing: Theme.space-4;

                    Text {
                        text: root.data.title;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        // 官方 Hawkins Text 的 2rem/700 档（区块标题）。
                        font-size: Theme.text-h4-size;
                        font-weight: Theme.text-h4-weight;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.data.count-text;
                        color: Theme.text-muted;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: transparent;
                    }

                    Rectangle {
                        width: sort-label.preferred-width + Theme.space-5;
                        height: 36px;
                        // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                        border-radius: Theme.radius-button;
                        background: sort-area.has-hover ? Theme.surface-raised : Theme.btn-secondary-bg;

                        sort-label := Text {
                            x: Theme.space-3;
                            height: parent.height;
                            text: root.data.sort-label + "  ▼";
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-12;
                            vertical-alignment: center;
                        }

                        sort-area := TouchArea {
                            clicked => {
                                root.sort();
                            }
                        }
                    }
                }

                // 网格（与搜索页共用 `PosterGrid`：6 列 / content-gutter / 5:7 卡 /
                // card-gap / 放大覆盖层都在那一个组件里）。
                grid := PosterGrid {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    target-prefix: "library.";
                    targets-visible: !root.data.empty;
                    nav-active: root.nav-active;
                    columns: root.columns;
                    grid-top: root.grid-y;
                    cards: root.data.cards;
                    focus-index <=> root.focus-index;
                    open(id) => {
                        root.open-item(id);
                    }
                }

                height: grid.content-height;
            }
        }

    if (root.data.empty) :
        EmptyState {
            width: parent.width;
            height: parent.height;
            target-prefix: "library.";
            targets-visible: root.visible;
            title: root.data.title + " 里还没有内容";
            message: "同步完成后，海报会出现在这里。";
            primary-label: "重新搜索";
            primary => {
                root.search();
            }
        }

    // 顶栏最后绘制：透明浮在网格上；滚动 40px 后变实底。
    nav := Navbar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height;
        tabs: root.data.tabs;
        current-index: root.data.current-tab;
        scrolled: !root.data.empty && grid-flick.content-y < -40px;
        target-prefix: "library.";
        targets-visible: root.visible;
        search-focused: root.search-focused;
        search-text <=> root.search-text;
        tab-activated(id) => {
            root.tab-activated(id);
        }
        search => {
            root.search();
        }
        search-changed(text) => {
            root.search-changed(text);
        }
        search-submit => {
            root.search-submit();
        }
        search-clear => {
            root.search-clear();
        }
        search-escape => {
            root.search-escape();
        }
        global-shortcut(code) => {
            root.global-shortcut(code);
        }
    }
}

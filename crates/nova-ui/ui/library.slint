//! 媒体库（Netflix 风格）：标题 + 数量、6 列（≥1440 宽 7 列）2:3 网格、12px 间距。
//!
//! 放大用独立覆盖层（`CardZoom`）：网格里基础卡片尺寸恒定，
//! 覆盖层按焦点/悬停索引定位绘制，后绘制盖住相邻卡片，布局零跳动。

import { Theme } from "theme.slint";
import { LibraryData } from "models.slint";
import { Navbar } from "navbar.slint";
import { PosterCard } from "poster_card.slint";
import { CardZoom } from "card_zoom.slint";
import { EmptyState } from "empty_state.slint";

export component LibraryPage inherits Rectangle {
    in property <LibraryData> data;
    in-out property <int> focus-index: 0;
    in property <bool> search-focused: false;
    // 搜索框文本（与 AppWindow 双向同步）。
    in-out property <string> search-text;

    callback open-item(string);
    callback tab-activated(string);
    callback sort();
    callback search();
    callback search-changed(string);
    callback search-submit();
    callback search-clear();
    callback search-escape();

    /// 把焦点交给搜索输入框（Ctrl+F / 点击搜索图标时由上层调到这里）。
    public function focus-input() {
        nav.focus-input();
    }

    background: Theme.bg;

    // 网格几何：用 `content-gutter`（≥1920 为 200px），列数按实测反推
    // ——Netflix 1920 下正文列宽 1520，6 张 240 宽海报 + 12px 间距正好铺满，
    // 所以 1920 是 6 列而不是 7 列；更窄的视口沿用 6 列，仅靠列宽自适应。
    property <int> columns: 6;
    property <length> card-width: (root.width - Theme.content-gutter * 2 - Theme.card-gap * (root.columns - 1))
        / root.columns;
    // 竖版海报 5:7（Netflix 实测 240×336 = 5:7，与 Theme.card-portrait-h 一致）。
    property <length> card-height: root.card-width * 7 / 5;
    property <int> card-count: root.data.cards.length;
    // 放大后浮出的信息区高度。
    property <length> zoom-info: Theme.zoom-info-height;
    property <float> zoom-factor: 1.0;
    property <int> zoom-index: root.focus-index;
    // 网格几何：行高含放大信息区。
    property <length> grid-y: Theme.navbar-height + Theme.space-5 + Theme.font-34 + Theme.space-4;
    property <int> grid-rows: (root.card-count + root.columns - 1) / root.columns;
    property <length> row-height: root.card-height + root.zoom-info;
    property <length> grid-height: root.grid-rows * root.row-height;

    states [
        zoomed when root.zoom-index >= 0 && root.zoom-index < root.card-count : {
            zoom-factor: Theme.zoom-factor;
            in {
                animate zoom-factor {
                    duration: Theme.zoom-duration;
                    delay: Theme.zoom-delay;
                    easing: ease-out;
                }
            }
            out {
                animate zoom-factor {
                    duration: Theme.zoom-duration;
                    easing: ease-out;
                }
            }
        }
    ]

    if (root.data.empty) :
        EmptyState {
            width: parent.width;
            height: parent.height;
            title: root.data.title + " 里还没有内容";
            message: "同步完成后，海报会出现在这里。";
            primary-label: "重新搜索";
            primary => {
                root.search();
            }
        }

    grid-flick := Flickable {
        visible: !root.data.empty;
        width: parent.width;
        height: parent.height;
            interactive: true;
            content-width: self.width;
            content-height: content.height;

            content := Rectangle {
                width: parent.width;

                // 标题 + 数量 + 排序。
                HorizontalLayout {
                    x: Theme.content-gutter;
                    y: Theme.navbar-height + Theme.space-5;
                    width: parent.width - Theme.content-gutter * 2;
                    height: Theme.font-34;
                    spacing: Theme.space-4;

                    Text {
                        text: root.data.title;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-34;
                        font-weight: Theme.weight-bold;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.data.count-text;
                        color: Theme.text-muted;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 1px;
                        background: transparent;
                    }

                    Rectangle {
                        width: sort-label.preferred-width + Theme.space-5;
                        height: 36px;
                        border-radius: Theme.radius-badge;
                        background: sort-area.has-hover ? Theme.surface-raised : Theme.btn-secondary-bg;

                        sort-label := Text {
                            x: Theme.space-3;
                            height: parent.height;
                            text: root.data.sort-label + "  ▼";
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-12;
                            vertical-alignment: center;
                        }

                        sort-area := TouchArea {
                            clicked => {
                                root.sort();
                            }
                        }
                    }
                }

                // 网格：手工定位（列数固定，位置可计算），行高含放大信息区。
                for card[i] in root.data.cards : PosterCard {
                    x: Theme.content-gutter + mod(i, root.columns) * (root.card-width + Theme.card-gap);
                    y: grid-y + floor(i / root.columns) * row-height;
                    card: card;
                    card-width: root.card-width;
                    card-height: root.card-height;
                    clicked => {
                        root.open-item(card.id);
                    }
                    hover-changed(has) => {
                        // 网格的放大跟随键盘焦点；悬停时移过去。
                        if (has) {
                            root.focus-index = i;
                        }
                    }
                }

                // 放大覆盖层。
                if (root.zoom-index >= 0 && root.zoom-index < root.card-count) :
                    CardZoom {
                        property <length> zw: root.card-width * root.zoom-factor;
                        property <length> zh: root.card-height * root.zoom-factor;
                        property <length> center-x: Theme.content-gutter
                            + mod(root.zoom-index, root.columns) * (root.card-width + Theme.card-gap)
                            + root.card-width / 2;
                        property <length> center-y: grid-y
                            + floor(root.zoom-index / root.columns) * row-height
                            + root.card-height / 2;
                        // 放大卡可以穿出左右 gutter（钳到窗口边缘）。
                        x: clamp(center-x - zw / 2, 0px, parent.width - zw);
                        y: clamp(center-y - zh / 2, Theme.navbar-height, parent.height - zh);
                        width: zw;
                        card: root.data.cards[root.zoom-index];
                        base-width: root.card-width;
                        base-height: root.card-height;
                        zoom-factor: root.zoom-factor;
                        clicked => {
                            root.open-item(root.data.cards[root.zoom-index].id);
                        }
                    }

                height: grid-y + grid-height + Theme.space-8;
            }
        }

    // 顶栏最后绘制：透明浮在网格上；滚动 40px 后变实底。
    nav := Navbar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height;
        tabs: root.data.tabs;
        current-index: root.data.current-tab;
        scrolled: !root.data.empty && grid-flick.content-y < -40px;
        search-focused: root.search-focused;
        search-text <=> root.search-text;
        tab-activated(id) => {
            root.tab-activated(id);
        }
        search => {
            root.search();
        }
        search-changed(text) => {
            root.search-changed(text);
        }
        search-submit => {
            root.search-submit();
        }
        search-clear => {
            root.search-clear();
        }
        search-escape => {
            root.search-escape();
        }
    }
}

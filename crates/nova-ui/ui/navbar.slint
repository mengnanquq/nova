//! 顶部导航（Netflix 风格）：未滚动时用顶部黑→底部透明的压暗渐变浮在 hero 上，
//! 滚动 40px 后渐变为 surface 实底。
//!
//! 左：NOVA 字标（红点 + 白字）；中：库标签——纯文字态（当前白、其余 text-secondary），
//! 无胶囊无下划线；右侧只有搜索图标按钮（聚焦展开 240px 输入框）。

import { Theme } from "theme.slint";
import { TabData, Target, TargetBus } from "models.slint";

export component Navbar inherits Rectangle {
    in property <[TabData]> tabs;
    in property <int> current-index: 0;
    in property <bool> search-focused: false;
    // 页面滚动是否已超过 40px：驱动透明 → surface 实底的过渡。
    in property <bool> scrolled: false;
    // 搜索页把顶栏的胶囊搜索框藏起来：页内已经有更大的搜索框，
    // 两个输入框同屏会互相抢焦点。
    in property <bool> show-search: true;
    // 搜索框文本：与 AppWindow 双向同步（TextInput ⇄ 这里 ⇄ 上层）。
    in-out property <string> search-text;

    callback tab-activated(string);
    callback search();
    // 输入即时过滤：每次编辑都发。
    callback search-changed(string);
    // Enter 提交。
    callback search-submit();
    // 清除按钮（有输入时出现）。
    callback search-clear();
    // 输入框里按 Esc：交由上层退出聚焦。
    callback search-escape();

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 页面传入自己的命名空间（`"home."` / `"library."` / `"search."`），
    // 这样同一份顶栏在三个页面里不会互相覆盖 id。
    in property <string> target-prefix: "";
    in property <bool> targets-visible: true;
    /// 顶栏里固定存在的可点控件。库标签是 `for` 重复元素，单独登记（见下）。
    ///
    /// 三个搜索入口是**互斥可见**的：收起时只有放大镜（点它展开），展开时是输入框，
    /// 输入框有文字时才多一个「×」。清单只列当前真的能点的那个，否则
    /// `sweep` 会对着不可见的区域点击并报"没反应"。
    out property <[Target]> targets: !root.show-search ? []
        : root.search-focused
            ? (root.search-text != ""
                ? [search-input-target, search-clear-target]
                : [search-input-target])
            : [search-icon-target];

    property <Target> search-icon-target: {
        id: root.target-prefix + "nav.search",
        kind: "button",
        label: "搜索",
        x: search-area.absolute-position.x,
        y: search-area.absolute-position.y,
        width: search-area.width,
        height: search-area.height,
    };
    property <Target> search-input-target: {
        id: root.target-prefix + "nav.search-input",
        kind: "input",
        label: "顶栏搜索框",
        x: search-input.absolute-position.x,
        y: search-input.absolute-position.y,
        width: search-input.width,
        height: search-input.height,
    };
    property <Target> search-clear-target: {
        id: root.target-prefix + "nav.search-clear",
        kind: "button",
        label: "清除搜索",
        x: clear-area.absolute-position.x,
        y: clear-area.absolute-position.y,
        width: clear-area.width,
        height: clear-area.height,
    };

    // 把本轮 `targets` 登记到总线（调试通道取清单前会推进 `gen`）。
    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.targets-visible && root.visible) {
                TargetBus.register(target);
            }
        }
    }

    /// 让搜索输入框拿到键盘焦点（Ctrl+F 由 Rust 侧调到这里）。
    public function focus-input() {
        search-input.focus();
    }

    height: Theme.navbar-height;
    background: root.scrolled ? Theme.surface : transparent;
    animate background {
        duration: Theme.motion;
        easing: ease-out;
    }

    // 未滚动态的压暗层：顶栏高度内由顶部黑淡到底部透明，再向下多延伸 56px
    // （Netflix 的 header 渐变 `to top` 就只覆盖顶栏本身，这里放宽一点以免硬边）。
    // 滚动后淡出，露出下面的实底。
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height + Theme.navbar-gradient-extend;
        background: Theme.navbar-scroll-gradient;
        opacity: root.scrolled ? 0 : 1;
        animate opacity {
            duration: Theme.motion;
            easing: ease-out;
        }
    }

    // 右缘渐隐：标签放不下时暗示"后面还有"。只在实底态显示（透明态没有可融入的底色）。
    Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 64px;
        height: parent.height;
        visible: root.scrolled && tabs-row.preferred-width > tabs-view.width + 1px;
        background: @linear-gradient(90deg, #14141400 0%, Theme.surface 78%);
    }

    HorizontalLayout {
        x: Theme.gutter;
        width: parent.width - Theme.gutter * 2;
        height: parent.height;
        spacing: Theme.space-5;
        cross-axis-alignment: center;

        // 品牌：红点 + NOVA，bold、字距 -0.5。
        Rectangle {
            width: brand.preferred-width + Theme.space-2;
            height: 28px;
            background: transparent;

            Rectangle {
                x: 0;
                y: 11px;
                width: 6px;
                height: 6px;
                border-radius: Theme.radius-pill;
                background: Theme.accent;
            }

            brand := Text {
                x: Theme.space-2;
                height: parent.height;
                text: "NOVA";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-20;
                font-weight: Theme.weight-bold;
                letter-spacing: -0.5px;
                vertical-alignment: center;
            }
        }

        // 库标签可能很多（真实 Emby 上 10+ 个）：放进可裁剪容器里，
        // 让它占剩余宽度并在内部裁掉溢出部分，搜索框宽度不受影响。
        // Flickable 自身的 horizontal-stretch 不生效（preferred 宽 = 内容宽），
        // 包一层 Rectangle 来占满剩余宽度，搜索/头像才能贴到右缘。
        tabs-stretch := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            clip: false;

        tabs-view := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: tabs-row.preferred-width;
            content-height: parent.height;
            interactive: true;

            tabs-row := HorizontalLayout {
                spacing: Theme.nav-link-gap;
                height: parent.height;
                cross-axis-alignment: center;

                for tab[i] in root.tabs : Rectangle {
                    width: tab-label.preferred-width;
                    height: parent.height;
                    background: transparent;

                    tab-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: tab.title;
                        // 纯文字态：当前项白、其余 text-secondary，悬停变白。
                        color: i == root.current-index || tab-area.has-hover
                            ? Theme.text : Theme.text-muted;
                        // 颜色过渡 `motion-fast`；字重不可动画（激活仍是 semibold），
                        // 且本顶栏本来就没有下划线指示条（第 9 节已注明）。
                        animate color {
                            duration: Theme.motion-fast;
                            easing: ease-out;
                        }
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        font-weight: i == root.current-index
                            ? Theme.weight-semibold : Theme.weight-regular;
                        vertical-alignment: center;
                    }

                    tab-area := TouchArea {
                        clicked => {
                            root.tab-activated(tab.id);
                        }
                    }

                    // 库标签是重复元素：只能自己登记目标（数组无法在父组件里拼接）。
                    property <int> target-gen: TargetBus.gen;
                    changed target-gen => {
                        if (root.targets-visible && root.visible) {
                            TargetBus.register({
                                id: root.target-prefix + "nav.tab." + i,
                                kind: "tab",
                                label: tab.title,
                                x: tab-area.absolute-position.x,
                                y: tab-area.absolute-position.y,
                                width: tab-area.width,
                                height: tab-area.height,
                            });
                        }
                    }
                }
            }
        }
        }

        // 搜索：图标按钮，聚焦时展开为 240px 输入框。
        Rectangle {
            visible: root.show-search;
            width: root.search-focused ? Theme.search-box-width : 36px;
            height: Theme.search-box-height;
            border-radius: Theme.radius-poster;
            background: root.search-focused
                ? Theme.surface-raised : (search-area.has-hover ? Theme.wash : transparent);
            animate width {
                duration: Theme.motion;
                easing: ease-out;
            }
            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            // 放大镜：矢量 Path 画（圆环 + 45° 手柄），2px 描边、圆头。
            //
            // 以前是"圆角矩形当圆环 + 叠两个 `╲` 字形当手柄"：字形笔画按字体度量走，
            // 与圆环的描边对不齐、换字体就散架（看着就是不协调）。Path 用与播放器
            // 图标同一套画法，粗细与颜色都能精确控制。
            search-icon := Rectangle {
                visible: !root.search-focused;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                background: transparent;

                Path {
                    width: 24px;
                    height: 24px;
                    // 圆环：半径 7.5、圆心 (10,10)；手柄：从 45° 切点拉到右下角。
                    commands: "M 10 2.5 C 5.85 2.5 2.5 5.85 2.5 10 C 2.5 14.15 5.85 17.5 10 17.5 C 14.15 17.5 17.5 14.15 17.5 10 C 17.5 5.85 14.15 2.5 10 2.5 Z M 15.6 15.6 L 21 21";
                    stroke: search-area.has-hover ? Theme.text : Theme.text-muted;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
            }

            // 展开态左侧的小放大镜：与收起态同一套 Path 画法，缩到 16px。
            //
            // 原来这里也是"圆角矩形 + 两个 `╲` 字形"，实测**根本渲染不出来**——
            // 展开后的搜索框左侧是空的，输入文字还按那 20px 缩进，看着就是不协调。
            search-icon-mini := Rectangle {
                visible: root.search-focused;
                x: Theme.space-2 + 2px;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                background: transparent;

                Path {
                    width: 16px;
                    height: 16px;
                    // 圆环半径 5、圆心 (6.6,6.6)；手柄拉到右下角。
                    commands: "M 6.6 1.6 C 3.84 1.6 1.6 3.84 1.6 6.6 C 1.6 9.36 3.84 11.6 6.6 11.6 C 9.36 11.6 11.6 9.36 11.6 6.6 C 11.6 3.84 9.36 1.6 6.6 1.6 Z M 10.3 10.3 L 14.4 14.4";
                    stroke: Theme.text-muted;
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
            }

            // 占位：聚焦但无输入时显示。
            Text {
                visible: root.search-focused && root.search-text == "";
                x: Theme.space-2 + 20px + Theme.space-2;
                width: parent.width - Theme.space-2 * 2 - 20px;
                height: parent.height;
                text: "搜索";
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                vertical-alignment: center;
            }

            search-input := TextInput {
                visible: root.search-focused;
                x: Theme.space-2 + 20px + Theme.space-2;
                width: parent.width - Theme.space-2 * 2 - 20px
                    - (root.search-text == "" ? 0px : clear-button.width + Theme.space-1);
                height: parent.height;
                text <=> root.search-text;
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-14;
                vertical-alignment: center;
                single-line: true;

                edited => {
                    root.search-changed(root.search-text);
                }
                accepted => {
                    root.search-submit();
                }
                key-pressed(event) => {
                    // Esc 不进文本框：退出聚焦（由上层把焦点还给全局键盘处理）。
                    if (event.text == Key.Escape) {
                        root.search-escape();
                        return accept;
                    }
                    return reject;
                }
            }

            // 清除按钮：只在有输入时出现。
            clear-button := Rectangle {
                visible: root.search-focused && root.search-text != "";
                x: parent.width - self.width - Theme.space-1;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: Theme.radius-pill;
                background: clear-area.has-hover ? Theme.wash : transparent;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                clear-area := TouchArea {
                    clicked => {
                        root.search-clear();
                    }
                }
            }

            search-area := TouchArea {
                // 输入框可见时让它自己处理鼠标，这里只在图标态响应点击。
                enabled: !root.search-focused;
                clicked => {
                    root.search();
                }
            }
        }

        // 这里原来有一个 32px 的红色圆形"头像"（白色 N）。
        //
        // 已移除：它没有 TouchArea、也没有账号/设置页可去，却长得像个可点的按钮——
        // 用户点它什么都不会发生（审计把它记为"连点击入口都没有"）。项目没有账号
        // 体系，留一个假头头像比没有更糟。将来做多用户/档案时再加回来，
        // 那时它应该是一个真的下拉菜单。
    }
}

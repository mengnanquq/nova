//! 顶部导航（Netflix 风格）：未滚动时用顶部黑→底部透明的压暗渐变浮在 hero 上，
//! 滚动 40px 后渐变为 surface 实底。
//!
//! 左：NOVA 字标（红点 + 白字）；中：库标签——纯文字态（当前白、其余 text-secondary），
//! 无胶囊无下划线；右侧只有搜索图标按钮（聚焦展开 240px 输入框）。

import { Theme } from "theme.slint";
import { TabData, Target, TargetBus } from "models.slint";
import { FocusRing } from "focus_ring.slint";

export component Navbar inherits Rectangle {
    in property <[TabData]> tabs;
    in property <int> current-index: 0;
    // 键盘焦点下标（体检 R2-2b）：`0..标签数-1` = 库标签，`标签数` = 搜索按钮，
    // `-1` = 顶栏不持有键盘焦点（鼠标操作 / 焦点在内容层）。
    //
    // 这是**焦点**，与 `current-index`（当前已选中的标签，白色 semibold）区分：
    // 焦点环用 accent 2px 描边（`FocusRing`），选中态只有字色 / 字重变化。
    in property <int> focus-index: -1;
    in property <bool> search-focused: false;
    // 页面滚动是否已超过 40px：驱动透明 → surface 实底的过渡。
    in property <bool> scrolled: false;
    // 搜索页把顶栏的胶囊搜索框藏起来：页内已经有更大的搜索框，
    // 两个输入框同屏会互相抢焦点。
    in property <bool> show-search: true;
    // 搜索框文本：与 AppWindow 双向同步（TextInput ⇄ 这里 ⇄ 上层）。
    in-out property <string> search-text;

    callback tab-activated(string);
    callback search();
    // 输入即时过滤：每次编辑都发。
    callback search-changed(string);
    // Enter 提交。
    callback search-submit();
    // 清除按钮（有输入时出现）。
    callback search-clear();
    // 输入框里按 Esc：交由上层退出聚焦。
    callback search-escape();
    // 输入框抢到焦点时仍要生效的全局快捷键（参数是 `AppWindow.key-intent` 的意图编号）。
    //
    // 为什么必须由输入框自己发：TextInput 会先把 Ctrl+字母当编辑快捷键吞掉，
    // `key-pressed` 里 `return reject` 之后事件也不会冒泡到 `AppWindow` 的全局
    // `keyboard` FocusScope。所以这里识别到 Ctrl+N / Ctrl+F 就**主动**上报并 accept；
    // Ctrl+A/C/V/X/Z 等编辑键继续 `reject`，留在输入框里正常工作。
    callback global-shortcut(int);

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 页面传入自己的命名空间（`"home."` / `"library."` / `"search."`），
    // 这样同一份顶栏在三个页面里不会互相覆盖 id。
    in property <string> target-prefix: "";
    in property <bool> targets-visible: true;
    /// 顶栏里固定存在的可点控件。库标签是 `for` 重复元素，单独登记（见下）。
    ///
    /// 三个搜索入口是**互斥可见**的：收起时只有放大镜（点它展开），展开时是输入框，
    /// 输入框有文字时才多一个「×」。清单只列当前真的能点的那个，否则
    /// `sweep` 会对着不可见的区域点击并报"没反应"。
    out property <[Target]> targets: !root.show-search ? []
        : root.search-focused
            ? (root.search-text != ""
                ? [search-input-target, search-clear-target]
                : [search-input-target])
            : [search-icon-target];

    property <Target> search-icon-target: {
        id: root.target-prefix + "nav.search",
        kind: "button",
        label: "搜索",
        x: search-area.absolute-position.x,
        y: search-area.absolute-position.y,
        width: search-area.width,
        height: search-area.height,
    };
    property <Target> search-input-target: {
        id: root.target-prefix + "nav.search-input",
        kind: "input",
        label: "顶栏搜索框",
        x: search-input.absolute-position.x,
        y: search-input.absolute-position.y,
        width: search-input.width,
        height: search-input.height,
    };
    property <Target> search-clear-target: {
        id: root.target-prefix + "nav.search-clear",
        kind: "button",
        label: "清除搜索",
        x: clear-area.absolute-position.x,
        y: clear-area.absolute-position.y,
        width: clear-area.width,
        height: clear-area.height,
    };

    // 把本轮 `targets` 登记到总线（调试通道取清单前会推进 `gen`）。
    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.targets-visible && root.visible) {
                TargetBus.register(target);
            }
        }
    }

    // 见 `focus-input`：`set-selection-offsets` 用的是 UTF-8 字节偏移（超出会被
    // clamp 到文本长度），不能拿 `string.length`（字素簇个数）当偏移。
    property <int> text-end: 2147483647;

    // ---- 键盘焦点几何（测试 / 调试用）----
    //
    // 标签行是横向 `Flickable`：窄窗口下后面的标签被裁在视口外。键盘焦点移到
    // 被裁掉的标签时要把它滚进可见区（见标签元素的 `ensure-visible`）。
    //
    // 焦点标签的位置由**焦点那个标签自己**写进来（`for` 元素无法从父组件按下标访问），
    // 记的是**标签行内容坐标**（`self.x`，滚动不会改它）；下面四个 `probe-*` 再
    // 换算成**标签区视口坐标**报出去。标签行左右各留 `Theme.focus-offset` 的内边距
    // （见 `tabs-row`），焦点环画在标签本体外 `Theme.focus-offset` 处，所以
    // "焦点环完整可见"（含描边）的判定是
    // `probe-focus-tab-left - Theme.focus-offset >= 0 &&
    //  probe-focus-tab-right + Theme.focus-offset <= probe-tabs-viewport-w`；
    // 只看标签本体（`0 <= left && right <= viewport`）会漏掉被裁掉的环。
    //
    // 以前这里记的是 `absolute-position`（**已经含滚动偏移**），探针又加了一遍
    // `content-x`：同一个标签报出的左右沿会随"按下方向键那一刻已经滚到哪儿"漂移
    // （体检 R8-A1：搜索页 800×600 报 `focus_tab_right=643.2 > tabs_viewport_w=623`，
    // 首页同尺寸却"正常"；其实两页标签行宽度与最大滚动量完全一致，差异全部来自这个
    // 双算）。内容坐标 + 当前 `content-x` 才是标签此刻真正的视口位置（向右滚时为负）。
    in-out property <length> focus-tab-left: 0px;
    in-out property <length> focus-tab-width: 0px;
    // 视口相对坐标：内容坐标 + 滚动偏移（`content-x` 向右滚时为负）。
    out property <length> probe-focus-tab-left: root.focus-tab-left + tabs-view.content-x;
    out property <length> probe-focus-tab-right: root.probe-focus-tab-left + root.focus-tab-width;
    out property <length> probe-tabs-viewport-w: tabs-view.width;
    out property <length> probe-tabs-scroll-x: tabs-view.content-x;

    /// 让搜索输入框拿到键盘焦点（Ctrl+F / 点放大镜由 Rust 侧调到这里）。
    public function focus-input() {
        // 已经在本框里打字时不碰光标：在中间改字不能被强行跳到末尾。
        if (search-input.has-focus) {
            return;
        }
        search-input.focus();
        // 顶栏输入框的文本是**常驻**的（`search-text` 与 AppWindow 双向同步，回首页
        // 也保留旧查询词），展开时 TextInput 的光标停在旧位置（通常是 0）：点开就
        // 打字会把首字符插到旧词前面（体检 R3-1：旧词 `沙丘` + 立即输入 `1234`
        // → `1沙丘234`）。交接时把光标与锚点一起推到末尾，与搜索页大输入框
        // `SearchPage.focus-input` 同一口径。
        search-input.set-selection-offsets(root.text-end, root.text-end);
    }

    height: Theme.navbar-height;
    background: root.scrolled ? Theme.surface : transparent;
    animate background {
        duration: Theme.motion;
        easing: ease-out;
    }

    // 未滚动态的压暗层：顶栏高度内由顶部黑淡到底部透明，再向下多延伸 56px
    // （Netflix 的 header 渐变 `to top` 就只覆盖顶栏本身，这里放宽一点以免硬边）。
    // 滚动后淡出，露出下面的实底。
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height + Theme.navbar-gradient-extend;
        background: Theme.navbar-scroll-gradient;
        opacity: root.scrolled ? 0 : 1;
        animate opacity {
            duration: Theme.motion;
            easing: ease-out;
        }
    }

    // 右缘渐隐：标签放不下时暗示"后面还有"。只在实底态显示（透明态没有可融入的底色）。
    Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 64px;
        height: parent.height;
        visible: root.scrolled && tabs-row.preferred-width > tabs-view.width + 1px;
        background: @linear-gradient(90deg, #14141400 0%, Theme.surface 78%);
    }

    HorizontalLayout {
        x: Theme.gutter;
        width: parent.width - Theme.gutter * 2;
        height: parent.height;
        spacing: Theme.space-5;
        cross-axis-alignment: center;

        // 品牌：红点 + NOVA，bold、字距 -0.5。
        Rectangle {
            width: brand.preferred-width + Theme.space-2;
            height: 28px;
            background: transparent;

            Rectangle {
                x: 0;
                y: 11px;
                width: 6px;
                height: 6px;
                border-radius: Theme.radius-pill;
                background: Theme.accent;
            }

            brand := Text {
                x: Theme.space-2;
                height: parent.height;
                text: "NOVA";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-20;
                font-weight: Theme.weight-bold;
                letter-spacing: -0.5px;
                vertical-alignment: center;
            }
        }

        // 库标签可能很多（真实 Emby 上 10+ 个）：放进可裁剪容器里，
        // 让它占剩余宽度并在内部裁掉溢出部分，搜索框宽度不受影响。
        // Flickable 自身的 horizontal-stretch 不生效（preferred 宽 = 内容宽），
        // 包一层 Rectangle 来占满剩余宽度，搜索/头像才能贴到右缘。
        tabs-stretch := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            // 窄窗口（800px）下标签行比标签区宽：必须裁在标签区里，
            // 否则最后一个标签会画到右侧搜索按钮上面。
            clip: true;

        tabs-view := Flickable {
            width: parent.width;
            height: parent.height;
            content-width: tabs-row.preferred-width;
            content-height: parent.height;
            interactive: true;

            tabs-row := HorizontalLayout {
                spacing: Theme.nav-link-gap;
                // 焦点环画在标签本体左右各 `Theme.focus-offset` 之外（见下面的
                // `FocusRing`）。给标签行留同样的内边距，`content-width`
                // （= `tabs-row.preferred-width`）才把焦点环的余量算进去：否则滚到
                // 最右 / 最左时，最后一个 / 第一个标签的环描边会被 `clip` 裁掉。
                padding-left: Theme.focus-offset;
                padding-right: Theme.focus-offset;
                height: parent.height;
                cross-axis-alignment: center;

                for tab[i] in root.tabs : Rectangle {
                    width: tab-label.preferred-width;
                    height: parent.height;
                    background: transparent;

                    tab-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: tab.title;
                        // 纯文字态：当前项白、其余 text-secondary，悬停变白。
                        color: i == root.current-index || tab-area.has-hover
                            ? Theme.text : Theme.text-muted;
                        // 颜色过渡 `motion-fast`；字重不可动画（激活仍是 semibold），
                        // 且本顶栏本来就没有下划线指示条（第 9 节已注明）。
                        animate color {
                            duration: Theme.motion-fast;
                            easing: ease-out;
                        }
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        font-weight: i == root.current-index
                            ? Theme.weight-semibold : Theme.weight-regular;
                        vertical-alignment: center;
                    }

                    tab-area := TouchArea {
                        clicked => {
                            root.tab-activated(tab.id);
                        }
                    }

                    // 键盘焦点是否在这个标签上（体检 R2-2b）。
                    property <bool> keyboard-focused: i == root.focus-index;
                    changed keyboard-focused => {
                        if (self.keyboard-focused) {
                            // 窄窗口下标签行比标签区宽：把焦点**环**横向滚入可见区
                            // （`ensure-visible` 滚的是包着它的 `tabs-view`）。
                            // 只滚标签本体不够：环比本体左右各宽 `Theme.focus-offset`，
                            // 滚到两端时描边仍会被标签区裁掉，所以对环本身 ensure。
                            focus-ring.ensure-visible(ScrollBehavior.smooth);
                        }
                        // 把几何报给顶栏的探针（见 `probe-focus-tab-*`）。
                        self.report-geometry();
                    }

                    // 布局坐标镜像一份：窗口宽度变化时标签行会重排（`nav-link-gap`
                    // 随宽度缩放、字重影响 label 宽度），探针不能停在按下方向键那一刻。
                    property <length> layout-left: self.x;
                    property <length> layout-width: self.width;
                    changed layout-left => {
                        self.report-geometry();
                    }
                    changed layout-width => {
                        self.report-geometry();
                    }

                    function report-geometry() {
                        if (self.keyboard-focused) {
                            root.focus-tab-left = self.layout-left;
                            root.focus-tab-width = self.layout-width;
                        }
                    }

                    // 焦点环（accent 2px 描边）：与"当前标签"的白色文字（选中态）区分。
                    // 只在键盘进入顶栏层时才有非 -1 的 `focus-index`，鼠标点击不出环。
                    focus-ring := FocusRing {
                        x: -Theme.focus-offset;
                        y: (parent.height - self.height) / 2;
                        width: parent.width + Theme.focus-offset * 2;
                        height: Theme.nav-focus-height;
                        ring-radius: Theme.radius-button + Theme.focus-offset;
                        active: parent.keyboard-focused;
                    }

                    // 库标签是重复元素：只能自己登记目标（数组无法在父组件里拼接）。
                    //
                    // 登记的是**标签区里真正可见的那一段**：`tabs-view` 是 Flickable，
                    // 放不下的标签被裁在视口外，但 `absolute-position` 报的是未裁剪的
                    // 布局坐标。800px 宽下最后一个标签（x733..761）与搜索按钮
                    // （x732..768）就这样「重叠」了——按目标坐标点击会点到搜索框。
                    // 取与标签区视口的交集，完全看不见时不登记。
                    property <length> target-left: max(tab-area.absolute-position.x,
                        tabs-view.absolute-position.x);
                    property <length> target-right: min(tab-area.absolute-position.x + tab-area.width,
                        tabs-view.absolute-position.x + tabs-view.width);
                    property <int> target-gen: TargetBus.gen;
                    changed target-gen => {
                        if (root.targets-visible && root.visible
                            && self.target-right > self.target-left) {
                            TargetBus.register({
                                id: root.target-prefix + "nav.tab." + i,
                                kind: "tab",
                                label: tab.title,
                                x: self.target-left,
                                y: tab-area.absolute-position.y,
                                width: self.target-right - self.target-left,
                                height: tab-area.height,
                            });
                        }
                    }
                }
            }
        }
        }

        // 搜索：图标按钮，聚焦时展开为 240px 输入框。
        //
        // 宽度**必须**跟 `show-search` 门控（R7-C1）：搜索页（`show-search: false`）
        // 把胶囊框藏起来，但 `visible: false` 在 `HorizontalLayout` 里**照样占位**——
        // 而搜索页的页内大输入框持有焦点时 `search-focused` 为真，宽度会按**展开态**
        // 240px 算，标签区凭空少了 204px（真机 800×600：587 → 383，最后几个标签
        // 被切掉）。藏起来就不占位。
        Rectangle {
            visible: root.show-search;
            width: root.show-search
                ? (root.search-focused ? Theme.search-box-width : 36px) : 0px;
            height: Theme.search-box-height;
            border-radius: Theme.radius-poster;
            background: root.search-focused
                ? Theme.surface-raised : (search-area.has-hover ? Theme.wash : transparent);
            animate width {
                duration: Theme.motion;
                easing: ease-out;
            }
            animate background {
                duration: Theme.motion-fast;
                easing: ease-out;
            }

            // 放大镜：矢量 Path 画（圆环 + 45° 手柄），2px 描边、圆头。
            //
            // 以前是"圆角矩形当圆环 + 叠两个 `╲` 字形当手柄"：字形笔画按字体度量走，
            // 与圆环的描边对不齐、换字体就散架（看着就是不协调）。Path 用与播放器
            // 图标同一套画法，粗细与颜色都能精确控制。
            search-icon := Rectangle {
                visible: !root.search-focused;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                background: transparent;

                Path {
                    width: 24px;
                    height: 24px;
                    // 圆环：半径 7.5、圆心 (10,10)；手柄：从 45° 切点拉到右下角。
                    commands: "M 10 2.5 C 5.85 2.5 2.5 5.85 2.5 10 C 2.5 14.15 5.85 17.5 10 17.5 C 14.15 17.5 17.5 14.15 17.5 10 C 17.5 5.85 14.15 2.5 10 2.5 Z M 15.6 15.6 L 21 21";
                    stroke: search-area.has-hover ? Theme.text : Theme.text-muted;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
            }

            // 展开态左侧的小放大镜：与收起态同一套 Path 画法，缩到 16px。
            //
            // 原来这里也是"圆角矩形 + 两个 `╲` 字形"，实测**根本渲染不出来**——
            // 展开后的搜索框左侧是空的，输入文字还按那 20px 缩进，看着就是不协调。
            search-icon-mini := Rectangle {
                visible: root.search-focused;
                x: Theme.space-2 + 2px;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                background: transparent;

                Path {
                    width: 16px;
                    height: 16px;
                    // 圆环半径 5、圆心 (6.6,6.6)；手柄拉到右下角。
                    commands: "M 6.6 1.6 C 3.84 1.6 1.6 3.84 1.6 6.6 C 1.6 9.36 3.84 11.6 6.6 11.6 C 9.36 11.6 11.6 9.36 11.6 6.6 C 11.6 3.84 9.36 1.6 6.6 1.6 Z M 10.3 10.3 L 14.4 14.4";
                    stroke: Theme.text-muted;
                    stroke-width: 1.5px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                    fill: transparent;
                }
            }

            // 占位：聚焦但无输入时显示。
            Text {
                visible: root.search-focused && root.search-text == "";
                x: Theme.space-2 + 20px + Theme.space-2;
                width: parent.width - Theme.space-2 * 2 - 20px;
                height: parent.height;
                text: "搜索";
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                vertical-alignment: center;
            }

            search-input := TextInput {
                visible: root.search-focused;
                x: Theme.space-2 + 20px + Theme.space-2;
                width: parent.width - Theme.space-2 * 2 - 20px
                    - (root.search-text == "" ? 0px : clear-button.width + Theme.space-1);
                height: parent.height;
                text <=> root.search-text;
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-14;
                vertical-alignment: center;
                single-line: true;

                edited => {
                    root.search-changed(root.search-text);
                }
                accepted => {
                    root.search-submit();
                }
                key-pressed(event) => {
                    // Esc 不进文本框：退出聚焦（由上层把焦点还给全局键盘处理）。
                    if (event.text == Key.Escape) {
                        root.search-escape();
                        return accept;
                    }
                    // 8 = Ctrl+N（打开“添加服务器”），7 = Ctrl+F（聚焦搜索）。
                    if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                        root.global-shortcut(8);
                        return accept;
                    }
                    if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                        root.global-shortcut(7);
                        return accept;
                    }
                    return reject;
                }
            }

            // 清除按钮：只在有输入时出现。
            clear-button := Rectangle {
                visible: root.search-focused && root.search-text != "";
                x: parent.width - self.width - Theme.space-1;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: Theme.radius-pill;
                background: clear-area.has-hover ? Theme.wash : transparent;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                clear-area := TouchArea {
                    clicked => {
                        root.search-clear();
                    }
                }
            }

            search-area := TouchArea {
                // 输入框可见时让它自己处理鼠标，这里只在图标态响应点击。
                enabled: !root.search-focused;
                clicked => {
                    root.search();
                }
            }

            // 键盘焦点落在"搜索按钮"槽位（下标 = 标签数）时的焦点环。
            // 搜索页的顶栏没有搜索入口（`show-search: false`），那个页面的槽位只有标签，
            // 所以这里不会凭空亮一个环。
            FocusRing {
                x: -Theme.focus-offset;
                y: -Theme.focus-offset;
                width: parent.width + Theme.focus-offset * 2;
                height: parent.height + Theme.focus-offset * 2;
                ring-radius: Theme.radius-poster + Theme.focus-offset;
                active: root.focus-index == root.tabs.length;
            }
        }

        // 这里原来有一个 32px 的红色圆形"头像"（白色 N）。
        //
        // 已移除：它没有 TouchArea、也没有账号/设置页可去，却长得像个可点的按钮——
        // 用户点它什么都不会发生（审计把它记为"连点击入口都没有"）。项目没有账号
        // 体系，留一个假头头像比没有更糟。将来做多用户/档案时再加回来，
        // 那时它应该是一个真的下拉菜单。
    }
}

//! 顶部导航：品牌 + 媒体库标签 + 搜索入口。下缘一条 1px hairline。

import { Theme } from "theme.slint";
import { TabData } from "models.slint";

export component Navbar inherits Rectangle {
    in property <[TabData]> tabs;
    in property <int> current-index: 0;
    in property <bool> search-focused: false;
    // 搜索框文本：与 AppWindow 双向同步（TextInput ⇄ 这里 ⇄ 上层）。
    in-out property <string> search-text;

    callback tab-activated(string);
    callback search();
    // 输入即时过滤：每次编辑都发。
    callback search-changed(string);
    // Enter 提交。
    callback search-submit();
    // 清除按钮（有输入时出现）。
    callback search-clear();
    // 输入框里按 Esc：交由上层退出聚焦。
    callback search-escape();

    /// 让搜索输入框拿到键盘焦点（Ctrl+F 由 Rust 侧调到这里）。
    public function focus-input() {
        search-input.focus();
    }

    height: Theme.navbar-height;
    background: Theme.bg;

    Rectangle {
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.hairline;
    }

    // 右缘渐隐：标签放不下时，最后一个标签会被从中间切断，看起来像坏了。
    // 盖一层向背景色过渡的渐变，暗示"后面还有，可以滚"。
    // 只有真的溢出时才显示（否则纯色条会盖住最后一个标签的右半边）。
    Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 64px;
        height: parent.height;
        visible: tabs-row.preferred-width > tabs-view.width + 1px;
        background: @linear-gradient(90deg, #0A0B0D00 0%, Theme.bg 78%);
    }

    HorizontalLayout {
        x: Theme.gutter;
        width: parent.width - Theme.gutter * 2;
        height: parent.height;
        spacing: Theme.space-6;
        cross-axis-alignment: center;

        Rectangle {
            width: brand.preferred-width + Theme.space-3;
            height: 28px;
            background: transparent;

            Rectangle {
                x: 0;
                y: 11px;
                width: 6px;
                height: 6px;
                border-radius: Theme.radius-badge;
                background: Theme.accent;
            }

            brand := Text {
                x: Theme.space-3;
                height: parent.height;
                text: "NOVA";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-22;
                font-weight: Theme.weight-bold;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 1px;
            height: 24px;
            background: Theme.hairline;
        }

        // 库标签可能很多（真实 Emby 上 10+ 个）：放进可裁剪容器里，
        // 让它占剩余宽度并在内部裁掉溢出部分，**搜索框宽度不受影响**。
        // 之前标签是 HorizontalLayout 的直接子元素，标签一多就把右侧搜索框挤成 0 宽。
        // 用 Flickable 而不是普通容器：布局项的最小宽度默认会继承子元素的首选宽度，
        // 十个库标签加起来 1000+px，普通容器会把自己撑到溢满、把搜索框挤出可视区。
        // Flickable 的最小宽度是 0，天生裁剪，还能横向滚动查看后面的库。
        tabs-view := Flickable {
            horizontal-stretch: 1;
            height: parent.height;
            viewport-width: tabs-row.preferred-width;
            viewport-height: parent.height;
            // 可拖动/滚轮横向滚动：标签老老实实排在视口外，而不是被裁掉看不见。
            interactive: true;

            tabs-row := HorizontalLayout {
                spacing: Theme.space-6;
                height: parent.height;
                cross-axis-alignment: center;
            for tab[i] in root.tabs : Rectangle {
                width: tab-label.preferred-width + Theme.space-5;
                height: 40px;
                border-radius: Theme.radius-pill;
                background: tab-area.has-hover ? Theme.wash : transparent;

                tab-label := Text {
                    x: Theme.space-3;
                    height: parent.height;
                    text: tab.title;
                    color: i == root.current-index ? Theme.accent : Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    font-weight: i == root.current-index ? Theme.weight-semibold : Theme.weight-regular;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: Theme.space-3;
                    y: parent.height - 6px;
                    width: parent.width - Theme.space-5;
                    height: 2px;
                    border-radius: Theme.radius-pill;
                    background: i == root.current-index ? Theme.accent : transparent;
                }

                tab-area := TouchArea {

                    clicked => {
                        root.tab-activated(tab.id);
                    }
                }
            }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: transparent;
        }

        Rectangle {
            width: 196px;
            height: 36px;
            border-radius: Theme.radius-pill;
            background: Theme.surface;
            border-width: 1px;
            border-color: root.search-focused ? Theme.accent : Theme.hairline;

            // 占位：空态且未聚焦时显示（有焦点或有输入时让位给真实文本）。
            Text {
                visible: root.search-text == "" && !search-input.has-focus;
                x: Theme.space-3;
                width: parent.width - Theme.space-3 * 2;
                height: parent.height;
                text: "搜索  ·  Ctrl+F";
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                vertical-alignment: center;
            }

            // 点击胶囊空白处也聚焦（TextInput 自身区域由它处理鼠标）。
            TouchArea {
                clicked => {
                    root.search();
                }
            }

            search-input := TextInput {
                x: Theme.space-3;
                width: parent.width - Theme.space-3 * 2
                    - (root.search-text == "" ? 0px : clear-button.width + Theme.space-2);
                height: parent.height;
                text <=> root.search-text;
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                vertical-alignment: center;
                single-line: true;

                edited => {
                    root.search-changed(root.search-text);
                }
                accepted => {
                    root.search-submit();
                }
                key-pressed(event) => {
                    // Esc 不进文本框：退出聚焦（由上层把焦点还给全局键盘处理）。
                    if (event.text == Key.Escape) {
                        root.search-escape();
                        return accept;
                    }
                    return reject;
                }
            }

            // 清除按钮：只在有输入时出现。
            clear-button := Rectangle {
                visible: root.search-text != "";
                x: parent.width - self.width - Theme.space-2;
                y: (parent.height - self.height) / 2;
                width: 20px;
                height: 20px;
                border-radius: Theme.radius-pill;
                background: clear-area.has-hover ? Theme.wash : Theme.surface-raised;

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: "×";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                clear-area := TouchArea {
                    clicked => {
                        root.search-clear();
                    }
                }
            }
        }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: Theme.radius-pill;
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.hairline;

            Text {
                text: "N";
                color: Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

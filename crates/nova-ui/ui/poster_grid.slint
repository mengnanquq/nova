//! 竖版海报网格（5:7）：媒体库页与搜索页共用的**唯一**一套网格几何。
//!
//! 几何（改一处两页同时生效）：
//! - 列宽 = (`width` - 2×`content-gutter` - 卡间距×(列数-1)) / 列数；
//! - 图高 = 列宽 × 7 / 5（Netflix 实测 240×336 = 5:7）；
//! - 卡片总高 = 图高 + 卡下标题块（官方 `li` 结构，见 `theme.slint`）；
//! - 列起点 = `content-gutter` + 列号 × (列宽 + 卡间距)；
//! - 行高 = 卡片总高 + 行间距（行间距 12px，且 ≥ 放大卡竖向溢出的一半）。
//!
//! 网格放在页面（或页面 Flickable 的内容区）里，原点是内容区左上角：
//! `grid-top` 给"内容区顶部到第一行卡片"的距离（媒体库是标题行高，
//! 搜索页是结果头高度）。放大覆盖层由 `CardZoom` 后绘制，不参与网格布局。

import { Theme } from "theme.slint";
import { CardData } from "models.slint";
import { PosterCard } from "poster_card.slint";
import { CardZoom } from "card_zoom.slint";

export component PosterGrid inherits Rectangle {
    in property <[CardData]> cards;
    // 网格列数（页面决定：媒体库/搜索页目前都用 6 列）。
    in property <int> columns: 6;
    // ---- 视口窗口化（大库 4546 张不再一次性实例化）----
    // `window-start` 是首个实例化卡片的**全局**下标，`window-count` 是实例化张数；
    // 取 -1 表示「不窗口化」（全部实例化，与窗口化之前的行为一致，也是几何还不可用
    // 时的退化）。区间由 Rust 用 `viewmodel::grid::grid_window` 按视口算好 —— 布局
    // 几何（行高 / 内容坐标）只在本文件算一次，不在别处重抄。
    //
    // 窗口化只影响"实例化几张"：`content-height`、行号、`target-id`、焦点几何
    // 一律仍按全部卡片（全局下标）算。
    in property <int> window-start: 0;
    in property <int> window-count: -1;
    // 视口在内容坐标里的上沿与高度（页面从 `Flickable` 报上来）。
    in property <length> scroll-y: 0px;
    in property <length> viewport-height: 0px;
    // 视口 / 几何变化时通知 Rust 重算窗口（Rust 读本组件的 `probe-*` 属性）。
    callback viewport-changed();
    // 左右留白：媒体库与搜索页都用 `Theme.content-gutter`。
    in property <length> content-gutter: Theme.content-gutter;
    // 内容区顶部到第一行卡片的距离。
    in property <length> grid-top: 0px;
    // 放大覆盖层的上边界（内容区坐标）：媒体库要在顶栏之下，搜索页可贴到内容区顶。
    in property <length> overlay-clamp-top: Theme.navbar-height;
    // 焦点/悬停索引（-1 表示网格里没有焦点）。
    in-out property <int> focus-index: -1;
    // 用户是否已开始导航（按过方向键 / 悬停）。未激活时不放大任何卡——
    // 否则页面一创建 `focus-index` 默认 0 就会把第一张卡画成放大态。
    in property <bool> nav-active: false;

    // 点开一张卡：参数是条目 id。
    callback open(string);

    // ---- 调试通道：网格里每张卡的 id 前缀（`"library."` / `"search."`）----
    in property <string> target-prefix: "";
    // 网格当前是否真的可以点（搜索页非 Ready 态时关掉，避免登记到空/错误态上）。
    in property <bool> targets-visible: true;

    // ---- 几何（媒体库与搜索页都只读这些）----
    // 列宽（同时也是海报区宽，含外框内衬）。
    out property <length> card-width: (root.width - root.content-gutter * 2
        - root.column-gap * (root.columns - 1)) / root.columns;
    // 图高：竖版海报严格 5:7（比例常量在 Theme 里，与首页行的竖版卡同一份真值）。
    out property <length> poster-height: root.card-width * Theme.poster-ratio-h / Theme.poster-ratio-w;
    // 卡片总高 = 图高 + 卡下标题块（官方卡片结构：海报在上、标题在下）。
    out property <length> card-height: root.poster-height + Theme.card-caption-height;
    // 列间距：官方 12px，且必须 ≥ 放大卡横向溢出（`zoom-allowance-x`）。
    out property <length> column-gap: max(Theme.card-gap, Theme.zoom-allowance-x);
    // 行间距：官方类型页网格**没有**给出行距（`/tmp/genre_inline.css` 里没有
    // `rowContainer` / `lolomoRow` 的 margin/gap，那套样式只描述横向行），
    // 沿用 `card-gap` 12px；同时必须 ≥ 放大卡竖向溢出的一半（`zoom-allowance-y`/2 = 10px）。
    out property <length> row-spacing: max(Theme.card-gap, Theme.zoom-allowance-y / 2);
    out property <length> card-step: root.card-width + root.column-gap;
    out property <length> first-card-x: root.content-gutter;
    out property <int> total-count: root.cards.length;
    out property <int> row-count: (root.total-count + root.columns - 1) / root.columns;
    // 真实实例化的卡片张数（`window-count` 夹到 `[window-start, total)` 之后）。
    out property <int> window-length: max(0, min(root.window-count < 0
        ? root.total-count : root.window-count, root.total-count - root.window-start));
    out property <length> row-height: root.card-height + root.row-spacing;
    // 内容区需要的总高度（含底部留白），页面据此设置 Flickable 的 content-height。
    out property <length> content-height: root.grid-top + root.row-count * root.row-height
        + Theme.space-8;
    // ---- 探针（测试用：键盘焦点卡在内容坐标里的上下沿）----
    // 页面把 Flickable 的滚动偏移也报出来，两者一起断言"焦点卡完全可见"。
    out property <length> probe-focus-top: root.focus-index >= 0
        && root.focus-index < root.total-count
        ? root.grid-top + floor(root.focus-index / root.columns) * root.row-height : -1px;
    out property <length> probe-focus-bottom: root.focus-index >= 0
        && root.focus-index < root.total-count
        ? root.grid-top + floor(root.focus-index / root.columns) * root.row-height
            + root.card-height : -1px;
    // 焦点卡上的放大覆盖层是否真的在画（键盘焦点的可见指示就是它）。
    out property <bool> probe-zoom-on: root.zoom-in-window;
    // 窗口化探针（测试用）：实例化区间 / 总张数 / 视口几何。
    out property <int> probe-window-start: root.window-start;
    out property <int> probe-window-count: root.window-length;
    out property <int> probe-total-count: root.total-count;
    out property <length> probe-row-height: root.row-height;
    out property <length> probe-grid-top: root.grid-top;

    // 视口/几何变化：Rust 侧据此重算实例化窗口（见 `pages/app.rs` 的
    // `sync_grid_window`）。没有订阅者时（纯 Slint 用法）是空操作。
    changed scroll-y => { root.viewport-changed(); }
    changed viewport-height => { root.viewport-changed(); }
    changed row-height => { root.viewport-changed(); }
    changed columns => { root.viewport-changed(); }
    changed total-count => { root.viewport-changed(); }

    // 宽度由页面给（本组件是普通 Rectangle，不是布局元素）。
    height: root.content-height;
    background: transparent;
    // 放大卡可以穿出左右 gutter 与首行上沿（由 CardZoom 自己钳位）。
    clip: false;

    // 内容入场：结果/媒体库数据到达（空 → 非空）时网格整体淡入。
    // 网格没有单个"内容层"可以整体位移（卡片是绝对定位的 `for` 子项），
    // 所以这里只做透明度；行级 6px 上浮由首页的 `CardRow.rise` 负责。
    //
    // 用自定义 float 进度（默认 0 = 隐藏态）而不是直接 `animate opacity`：
    // opacity 默认 1，未被求值过的元素会从 1 到 1，等于没有动画。
    property <float> reveal: root.cards.length > 0 ? 1 : 0;
    animate reveal {
        duration: Theme.motion-slow;
        easing: ease-out;
    }
    opacity: root.reveal;

    property <float> zoom-factor: 1.0;
    // 放大谁：与首页 `CardRow` 同一规则——**悬停优先**，其次键盘焦点。
    //
    // 以前只看 `nav-active`（只有按过方向键才为真），于是用鼠标悬停媒体库 / 搜索
    // 结果卡片只移动焦点、不放大——同一个应用里首页行悬停会放大、网格不会。
    // `hot` 记悬停的卡；指针移到放大覆盖层上时基础卡失去悬停，用 `latch` 锁住。
    property <int> hot: -1;
    property <int> latch: -1;
    changed hot => {
        if (root.hot >= 0) {
            root.latch = root.hot;
        }
    }
    property <bool> overlay-hovered: false;
    property <int> zoom-index: root.hot >= 0 ? root.hot
        : (root.overlay-hovered ? root.latch : (root.nav-active ? root.focus-index : -1));
    // 放大覆盖层只画"已经实例化"的卡：窗口化之后 `zoom-index` 可能落在窗口之外
    // （例如悬停后把那张卡滚出视口），这时没有底卡可放大，直接不画。
    property <bool> zoom-in-window: root.zoom-index >= 0
        && root.zoom-index >= root.window-start
        && root.zoom-index < root.window-start + root.window-length;

    states [
        zoomed when root.zoom-in-window : {
            zoom-factor: Theme.zoom-factor;
            in {
                animate zoom-factor {
                    // 官方 CSS：`transition: transform 0.2s ease-in-out`。
                    duration: Theme.motion-zoom;
                    delay: Theme.zoom-delay;
                    easing: ease-in-out;
                }
            }
            out {
                animate zoom-factor {
                    duration: Theme.motion-zoom;
                    easing: ease-in-out;
                }
            }
        }
    ]

    // 网格：手工定位（列数固定，位置可计算），行高 = 卡片总高 + 行间距。
    //
    // 只实例化 `[window-start, window-start + window-length)`：`i` 是本窗口内的
    // 局部下标，`g` 是**全局**下标（位置 / 目标 id / 焦点索引都用它）。窗口滚动时
    // `window-start` 变化只改绑定，不重建元素；元素个数只在视口行数变化时变。
    for i in root.window-length : PosterCard {
        property <int> g: root.window-start + i;
        x: root.first-card-x + mod(g, root.columns) * root.card-step;
        y: root.grid-top + floor(g / root.columns) * root.row-height;
        card: root.cards[g];
        card-width: root.card-width;
        image-height: root.poster-height;
        target-id: root.target-prefix + "card." + g;
        target-label: root.cards[g].title;
        targets-visible: root.targets-visible;
        clicked => {
            root.open(root.cards[g].id);
        }
        hover-changed(has) => {
            // 悬停：放大这张，同时把键盘焦点移过来（之后按方向键从这里继续）。
            if (has) {
                root.hot = g;
                root.focus-index = g;
            } else if (root.hot == g) {
                root.hot = -1;
            }
        }
    }

    // 放大覆盖层。
    if (root.zoom-in-window) :
        CardZoom {
            property <length> zw: root.card-width * root.zoom-factor;
            property <length> zh: root.card-height * root.zoom-factor;
            property <length> center-x: root.first-card-x
                + mod(root.zoom-index, root.columns) * root.card-step
                + root.card-width / 2;
            property <length> center-y: root.grid-top
                + floor(root.zoom-index / root.columns) * root.row-height
                + root.card-height / 2;
            // 放大卡可以穿出左右 gutter（钳到窗口边缘）。
            x: clamp(center-x - zw / 2, 0px, parent.width - zw);
            y: clamp(center-y - zh / 2, root.overlay-clamp-top, parent.height - zh);
            width: zw;
            card: root.cards[root.zoom-index];
            base-width: root.card-width;
            base-image-height: root.poster-height;
            zoom-factor: root.zoom-factor;
            changed hovered => {
                root.overlay-hovered = self.hovered;
            }
            // 覆盖层上的悬停（含指针本来就停在这张卡上的重复悬停）也要对齐键盘焦点：
            // 底卡被覆盖层盖住后 `has-hover` 不再跳变，只靠底卡会让焦点留在旧位置（R2-3）。
            index: root.zoom-index;
            hover(index, has) => {
                if (has && index >= 0 && index < root.cards.length) {
                    root.focus-index = index;
                }
            }
            clicked => {
                root.open(root.cards[root.zoom-index].id);
            }
        }
}

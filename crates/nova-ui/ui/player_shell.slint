//! 播放页：视频画布占位 + 控制层（`player_overlay.slint`）。
//!
//! 画布本身永远是黑的（起播时不许黑闪），引擎接入后 mpv 把 SDR 8bit 帧渲染进来。
//! HDR 片源只能在 mpv 侧色调映射到 SDR —— 界面文案写"色调映射"，不写"直通"。

import { Theme } from "theme.slint";
import { PlayerData, Target } from "models.slint";
import { PlayerOverlay } from "player_overlay.slint";

export component PlayerShellPage inherits Rectangle {
    in property <PlayerData> data;
    // 拖动进度条时气泡里的时间文本（由 Rust 用视图模型格式化）。
    in property <string> scrub-text: "";
    in property <bool> fullscreen: false;

    callback back();
    callback play-pause();
    callback seek-relative(int);
    callback scrub-start();
    callback scrub-move(float);
    callback scrub-commit(float);
    callback scrub-cancel();
    callback input();
    callback tick();
    callback audio-toggle();
    callback subtitle-toggle();
    callback audio-selected(int);
    callback subtitle-selected(int);
    callback retry();
    callback fullscreen-toggle();
    callback rate-cycle();
    callback time-toggle();
    callback mute-toggle();
    callback volume-set(float);
    callback subtitle-delay(float);
    // 字幕安全区（逻辑像素）：控制块顶边到窗口底边 + theme 安全间距。
    // 控制层真实布局 / 窗口高度变化时推一次，Rust 侧再换算成 `sub-pos` 百分比。
    callback subtitle-inset-changed();

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 播放页的控件全在 `PlayerOverlay` 里（子组件），本页自己不直接摆放控件，
    // 所以声明式数组为空；`PlayerOverlay` 会把自己的目标登记到 `TargetBus`。
    out property <[Target]> targets: [];

    // 控制层的字幕安全区，来自 `PlayerOverlay` 的真实布局（标题行位置 + 安全间距）。
    // Rust 读这个值（不存副本），布局变化时只发个通知让它重算百分比。
    out property <length> subtitle-safe-inset: overlay.subtitle-safe-inset;
    changed subtitle-safe-inset => {
        root.subtitle-inset-changed();
    }
    // 窗口高度变了要重推：控制块贴底，像素距离不变但引擎侧的百分比是相对
    // **画面**高度算的（letterbox 后画面高随窗口宽高变化），必须重新换算。
    changed height => {
        root.subtitle-inset-changed();
    }

    background: Theme.player-bg;

    // 视频画布：先铺黑底，起播时不会闪白。
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 播放页的控件全在 `PlayerOverlay` 里（子组件），本页自己不直接摆放控件，
    // 所以声明式数组为空；`PlayerOverlay` 会把自己的目标登记到 `TargetBus`。
    out property <[Target]> targets: [];

    background: Theme.player-bg;

        // 首帧到达前 / 缓冲时保留的画面（由上层推入的背景图）。
        Image {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: root.data.frame;
            visible: root.data.has-frame;
            image-fit: contain;
        }

        VerticalLayout {
            visible: !root.data.has-frame;
            alignment: center;
            spacing: Theme.space-3;

            Text {
                text: "视频画面";
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-22;
                font-weight: Theme.weight-semibold;
                horizontal-alignment: center;
            }

            // 首帧到达前的空态：只保留一行用户看得懂的信息。
            // 原来这里还有一行“引擎接入后由 mpv 渲染到这里”——引擎早就接进来了，那是过时的开发提示，已删。
            Text {
                text: "支持 HDR 片源的色调映射（纹理经 mpv 映射为 SDR 8bit）";
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                horizontal-alignment: center;
            }
        }
    }

    overlay := PlayerOverlay {
        width: 100%;
        height: 100%;
        data: root.data;
        scrub-text: root.scrub-text;
        fullscreen: root.fullscreen;

        back => {
            root.back();
        }

        play-pause => {
            root.play-pause();
        }

        seek-relative(seconds) => {
            root.seek-relative(seconds);
        }

        scrub-start => {
            root.scrub-start();
        }

        scrub-move(ratio) => {
            root.scrub-move(ratio);
        }

        scrub-commit(ratio) => {
            root.scrub-commit(ratio);
        }

        scrub-cancel => {
            root.scrub-cancel();
        }

        input => {
            root.input();
        }

        tick => {
            root.tick();
        }

        audio-toggle => {
            root.audio-toggle();
        }

        subtitle-toggle => {
            root.subtitle-toggle();
        }

        audio-selected(index) => {
            root.audio-selected(index);
        }

        subtitle-selected(index) => {
            root.subtitle-selected(index);
        }

        retry => {
            root.retry();
        }

        fullscreen-toggle => {
            root.fullscreen-toggle();
        }

        rate-cycle => {
            root.rate-cycle();
        }

        time-toggle => {
            root.time-toggle();
        }

        mute-toggle => {
            root.mute-toggle();
        }

        volume-set(volume) => {
            root.volume-set(volume);
        }

        subtitle-delay(seconds) => {
            root.subtitle-delay(seconds);
        }
    }
}

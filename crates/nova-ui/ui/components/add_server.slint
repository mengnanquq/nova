//! “添加服务器”对话框：覆盖层 + 半透明遮罩 + 居中面板。
//!
//! 只做摆放与焦点：地址校验、错误分类都在 Rust 视图模型里，这里通过属性接收。
//! 关闭后覆盖层整体隐藏，不给下层布局预留任何空间。

import { Theme } from "../theme.slint";
import { Target, TargetBus } from "../models.slint";

export component AddServerDialog inherits Rectangle {
    in property <bool> open: false;
    // 0 = 空闲（可编辑可提交），1 = 连接中（禁用重复提交）。
    in property <int> state: 0;
    in-out property <string> address;
    in-out property <string> user;
    in-out property <string> password;
    // 地址的内联提示（空串 = 无提示，地址合法）。
    in property <string> address-hint: "";
    // 明文 HTTP 警示条。
    in property <bool> plaintext-warning: false;
    // 错误区：主文案 + 可选的已脱敏补充说明。
    in property <string> error-text: "";
    in property <string> error-detail: "";
    // 钥匙环退化等提示。
    in property <string> note-text: "";

    callback close();
    callback submit();
    callback address-edited(string);

    // 提交门控：连接中、地址为空或带内联提示时禁用。
    property <bool> submit-disabled: root.state == 1
        || root.address == ""
        || root.address-hint != "";

    // ---- 调试通道：可交互目标（对话框里的输入框与两个动作按钮）----
    // 对话框整体 `visible: open`，关闭时下面的登记会被 `root.visible` 挡住。
    out property <[Target]> targets: [
        {
            id: "dialog.address",
            kind: "input",
            label: "服务器地址",
            x: address-input.absolute-position.x,
            y: address-input.absolute-position.y,
            width: address-input.width,
            height: address-input.height,
        },
        {
            id: "dialog.user",
            kind: "input",
            label: "用户名",
            x: user-input.absolute-position.x,
            y: user-input.absolute-position.y,
            width: user-input.width,
            height: user-input.height,
        },
        {
            id: "dialog.password",
            kind: "input",
            label: "密码",
            x: password-input.absolute-position.x,
            y: password-input.absolute-position.y,
            width: password-input.width,
            height: password-input.height,
        },
        {
            id: "dialog.cancel",
            kind: "button",
            label: "取消",
            x: cancel-area.absolute-position.x,
            y: cancel-area.absolute-position.y,
            width: cancel-area.width,
            height: cancel-area.height,
        },
        {
            id: "dialog.connect",
            kind: "button",
            label: "连接",
            x: connect-area.absolute-position.x,
            y: connect-area.absolute-position.y,
            width: connect-area.width,
            height: connect-area.height,
        },
    ];

    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.visible) {
                TargetBus.register(target);
            }
        }
    }

    /// 把焦点交给地址输入框（打开对话框时由上层调到这里）。
    public function focus-input() {
        address-input.focus();
    }

    x: 0;
    y: 0;
    width: 100%;
    height: 100%;
    visible: root.open;

    // ---- 入场：**没做**（如实记录）----
    //
    // 对话框是"`visible` 从 false 变 true"的那一刻出现的，而 Slint 对属性的
    // 第一次求值不播动画（实测：`visible: false` → true 的第一帧直接到终值；
    // `init` 里置位同理），要补这一下就得引定时器/每帧轮询（硬约束禁止）。
    // 所以这里保持即时显示，`scale 0.98 → 1` 也做不到（`Transform` 是 internal 元素）。

    // 半透明遮罩：压住下层内容但保持可见；点击遮罩 = 取消。
    TouchArea {
        clicked => {
            root.close();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 440px;
        height: body.preferred-height + Theme.space-6 * 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.hairline;
        border-radius: Theme.radius-panel;

        // 面板自身拦住鼠标事件，不透给遮罩。
        TouchArea { }

        body := VerticalLayout {
            x: Theme.space-6;
            y: Theme.space-6;
            width: parent.width - Theme.space-6 * 2;
            height: self.preferred-height;
            spacing: Theme.space-4;

            Text {
                text: "连接服务器";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-22;
                font-weight: Theme.weight-semibold;
            }

            // ---- 服务器地址 ----
            VerticalLayout {
                spacing: Theme.space-1;

                Text {
                    text: "服务器地址";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                }

                Rectangle {
                    height: 36px;
                    // 官方 Hawkins 输入框令牌：`Input-BorderRadius: 0.25rem`（4px）、
                    // `Input-BorderWidth: 0.0625rem`（1px）、`Input-Border:
                    // rgba(128,128,128,0.7)`（聚焦态用品牌红覆盖）。
                    border-radius: Theme.radius-input;
                    background: Theme.surface-raised;
                    border-width: Theme.input-border-width;
                    border-color: address-input.has-focus ? Theme.accent : Theme.input-border;

                    address-input := TextInput {
                        x: Theme.space-3;
                        width: parent.width - Theme.space-3 * 2;
                        height: parent.height;
                        text <=> root.address;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        vertical-alignment: center;
                        single-line: true;

                        edited => {
                            root.address-edited(self.text);
                        }
                        accepted => {
                            // Enter = 提交（门控在 Rust 侧统一做）。
                            root.submit();
                        }
                        key-pressed(event) => {
                            // Esc 不进文本框：直接取消对话框。
                            if (event.text == Key.Escape) {
                                root.close();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }

                if (root.address-hint != "") : Text {
                    text: root.address-hint;
                    color: Theme.danger;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                    wrap: word-wrap;
                }
            }

            // ---- 用户名 ----
            VerticalLayout {
                spacing: Theme.space-1;

                Text {
                    text: "用户名";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                }

                Rectangle {
                    height: 36px;
                    // 官方 Hawkins 输入框令牌：`Input-BorderRadius: 0.25rem`（4px）、
                    // `Input-BorderWidth: 0.0625rem`（1px）、`Input-Border:
                    // rgba(128,128,128,0.7)`（聚焦态用品牌红覆盖）。
                    border-radius: Theme.radius-input;
                    background: Theme.surface-raised;
                    border-width: Theme.input-border-width;
                    border-color: user-input.has-focus ? Theme.accent : Theme.input-border;

                    user-input := TextInput {
                        x: Theme.space-3;
                        width: parent.width - Theme.space-3 * 2;
                        height: parent.height;
                        text <=> root.user;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        vertical-alignment: center;
                        single-line: true;

                        accepted => {
                            root.submit();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.close();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
            }

            // ---- 密码（password 输入模式）----
            VerticalLayout {
                spacing: Theme.space-1;

                Text {
                    text: "密码";
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                }

                Rectangle {
                    height: 36px;
                    // 官方 Hawkins 输入框令牌：`Input-BorderRadius: 0.25rem`（4px）、
                    // `Input-BorderWidth: 0.0625rem`（1px）、`Input-Border:
                    // rgba(128,128,128,0.7)`（聚焦态用品牌红覆盖）。
                    border-radius: Theme.radius-input;
                    background: Theme.surface-raised;
                    border-width: Theme.input-border-width;
                    border-color: password-input.has-focus ? Theme.accent : Theme.input-border;

                    password-input := TextInput {
                        x: Theme.space-3;
                        width: parent.width - Theme.space-3 * 2;
                        height: parent.height;
                        text <=> root.password;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: InputType.password;

                        accepted => {
                            root.submit();
                        }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.close();
                                return accept;
                            }
                            return reject;
                        }
                    }
                }
            }

            // ---- 明文 HTTP 警示条：不阻止提交 ----
            if (root.plaintext-warning) : Rectangle {
                height: warning-text.preferred-height + Theme.space-2 * 2;
                border-radius: Theme.radius-panel;
                background: Theme.warning;

                warning-text := Text {
                    x: Theme.space-3;
                    width: parent.width - Theme.space-3 * 2;
                    y: (parent.height - self.preferred-height) / 2;
                    text: "当前地址使用明文 HTTP，密码将未加密传输；局域网自建可信时可以继续。";
                    color: Theme.accent-contrast;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }
            }

            // ---- 错误区：在表单下方，永远占同一块区域 ----
            if (root.error-text != "") : Rectangle {
                height: error-body.preferred-height + Theme.space-2 * 2;
                border-radius: Theme.radius-panel;
                background: Theme.danger;

                error-body := VerticalLayout {
                    x: Theme.space-3;
                    width: parent.width - Theme.space-3 * 2;
                    y: (parent.height - self.preferred-height) / 2;
                    spacing: Theme.space-1;

                    Text {
                        text: root.error-text;
                        color: Theme.accent-contrast;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        font-weight: Theme.weight-semibold;
                        wrap: word-wrap;
                    }

                    if (root.error-detail != "") : Text {
                        text: root.error-detail;
                        color: Theme.accent-contrast;
                        font-family: Theme.font-family;
                        font-size: Theme.font-12;
                        wrap: word-wrap;
                    }
                }
            }

            // ---- 钥匙环退化等提示 ----
            if (root.note-text != "") : Text {
                text: root.note-text;
                color: Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                wrap: word-wrap;
            }

            Rectangle {
                height: 1px;
                background: transparent;
            }

            // ---- 动作行：取消 + 连接 ----
            HorizontalLayout {
                spacing: Theme.space-3;
                alignment: center;

                Rectangle {
                    height: Theme.button-primary-height;
                    width: cancel-label.preferred-width + Theme.space-6 * 2;
                    // 胶囊：官方营销页 CTA 是 `border-radius:100px`（会员端
                    // Hawkins 的 Button-BorderRadius 是 4px），两种来源见 docs §10。
                    border-radius: Theme.radius-pill;
                    background: cancel-area.has-hover ? Theme.surface-raised : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    animate background {
                        // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                        duration: Theme.motion-button;
                        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                    }

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        border-radius: parent.border-radius;
                        background: Theme.press-wash;
                        opacity: cancel-area.pressed ? 1 : 0;
                        animate opacity {
                            // Button-DurationPressed 0ms。
                            duration: Theme.motion-press;
                            easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                        }
                    }

                    cancel-label := Text {
                        x: Theme.space-6;
                        width: parent.width - Theme.space-6 * 2;
                        height: parent.height;
                        text: "取消";
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    cancel-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }

                Rectangle {
                    height: Theme.button-primary-height;
                    width: connect-label.preferred-width + Theme.space-6 * 2;
                    // 胶囊：官方营销页 CTA 是 `border-radius:100px`（会员端
                    // Hawkins 的 Button-BorderRadius 是 4px），两种来源见 docs §10。
                    border-radius: Theme.radius-pill;
                    // 官方 Hawkins 令牌：Button-Surface / Hovered / Pressed / Disabled。
                    // 连接中固定显示“连接中…”；禁用态直接用 Disabled 底色（不再叠 opacity）。
                    background: root.submit-disabled ? Theme.accent-disabled
                        : (connect-area.pressed ? Theme.accent-pressed
                        : (connect-area.has-hover ? Theme.accent-hover : Theme.accent));
                    animate background {
                        // Button-Duration 250ms / Button-DurationPressed 0ms；
                        // Button-EasingHovered / Button-Easing 照抄官方贝塞尔。
                        duration: connect-area.pressed ? Theme.motion-press : Theme.motion-button;
                        easing: connect-area.has-hover
                            ? cubic-bezier(0.32, 0.94, 0.6, 1) : cubic-bezier(0.4, 0, 0.68, 0.06);
                    }

                    connect-label := Text {
                        x: Theme.space-6;
                        width: parent.width - Theme.space-6 * 2;
                        height: parent.height;
                        text: root.state == 1 ? "连接中…" : "连接";
                        color: Theme.accent-contrast;
                        font-family: Theme.font-family;
                        font-size: Theme.font-14;
                        font-weight: Theme.weight-semibold;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    connect-area := TouchArea {
                        enabled: !root.submit-disabled;
                        mouse-cursor: root.submit-disabled ? default : pointer;
                        clicked => {
                            root.submit();
                        }
                    }
                }
            }
        }
    }
}

//! 设计令牌：颜色 / 间距 / 字号 / 圆角 / 字体族。Netflix 视觉体系。
//!
//! 组件里不允许写死颜色或尺寸，一律引用这里的 token。

export global Theme {
    // ---- 颜色 ----
    // Netflix 是纯黑底，不是深灰。
    in property <color> bg: #000000;
    // 详情页底色：Netflix 详情页实测 `background-color: rgb(15,15,15)`（非纯黑）。
    in property <color> detail-bg: #0F0F0F;
    // 顶栏实底 / 菜单 / 面板。
    in property <color> surface: #141414;
    // 卡片 / 按钮悬停。
    in property <color> surface-raised: #1F1F1F;
    in property <color> hairline: #262626;
    in property <color> hairline-strong: #404040;
    in property <color> text: #FFFFFF;
    // 元信息（text-secondary）：在 #000 上对比度 8.9:1。
    in property <color> text-muted: #B3B3B3;
    // 次要说明。
    in property <color> text-faint: #808080;
    // 详情页元信息分隔点：实测 `rgba(255,255,255,.4)`（比 text-faint 更中性）。
    in property <color> detail-meta-dot: #FFFFFF66;
    // 品牌红：只用于 logo 点、选中态、进度条，不大面积铺。
    // === 官方 Hawkins 令牌原文（Button-*） ===
    // Button-Surface: rgb(229,9,20) / Button-SurfaceHovered: rgb(193,17,25)
    // Button-SurfacePressed: rgb(153,22,29) / Button-SurfaceDisabled: rgba(229,9,20,0.4)
    in property <color> accent: #E50914;
    in property <color> accent-hover: #C11119;
    in property <color> accent-pressed: #99161D;
    in property <color> accent-disabled: #E5091466;
    // 红底上的文字 / 图标。
    in property <color> accent-contrast: #FFFFFF;
    in property <color> danger: #E50914;
    // 压图遮罩 / badge 底 / 悬停洗色。
    in property <color> scrim: #000000E6;
    in property <color> scrim-soft: #000000A6;
    in property <color> hero-scrim: #000000CC;
    in property <color> badge-bg: #000000B3;
    in property <color> wash: #FFFFFF1F;
    // 按压态叠色：Slint 1.19 的 `Transform`（transform-scale）是 internal 元素，
    // 用户代码拿不到，所以按钮按下的 scale 0.98 用一层压暗叠色近似（见第 9 节）。
    in property <color> press-wash: #00000033;
    // 主按钮（播放）：白底黑字。
    in property <color> btn-primary-bg: #FFFFFF;
    in property <color> btn-primary-fg: #000000;
    // 次按钮（更多信息 / 我的列表）。
    in property <color> btn-secondary-bg: #FFFFFF26;
    in property <color> player-bg: #000000;
    // 播放控制层：底部渐变。官方原文（`/tmp/live_akira.css`）：
    //   `.PlayerControlsNeo__gradient-bottom{background-image:linear-gradient(0deg,rgba(0,0,0,.7) 0,transparent);
    //      bottom:0;height:20%;opacity:0}`
    //   `.PlayerControlsNeo__layout--active .PlayerControlsNeo__gradient-bottom{opacity:.75}`
    // 即**单段** `.7` 黑 → 透明（不是我们原来的两段式），高度 20%，激活时整层再乘 0.75。
    // 0.7 × 0.75 = 0.525 → alpha 134（`#86`）。**预乘在这里写死**：如果在 Slint 里
    // 给整个 Rectangle 设 `opacity: .75`，它的子控件（标题 / 按钮）也会变成半透明。
    in property <color> player-scrim-bottom: #00000086;
    in property <color> player-scrim-top: #00000000;
    // 官方 `.watch-video--bottom-controls-container-scrim{
    // background-image:linear-gradient(0deg,rgba(0,0,0,.3) 0,transparent)}`：
    // 控层 DOM 里的**第二层**底渐变（和 `PlayerControlsNeo__gradient-bottom` 叠加）。
    in property <color> player-scrim-floor: #0000004D;
    // 官方顶部渐变（loading 层）：`background:linear-gradient(180deg,rgba(0,0,0,.651),transparent)`；
    // 全屏层是 `linear-gradient(180deg,rgba(0,0,0,.7) 0,transparent)` + `height:20%` + `opacity:.75`。
    // 我们按 loading 层这条（任务书口径），全屏层那条记在 docs §11。
    in property <brush> player-top-gradient: @linear-gradient(180deg, #000000A6 0%, #00000000 100%);
    // 官方 `.PlayerControlsNeo__layout--dimmed{background-color:rgba(0,0,0,.5)}`：
    // 我们**不用**这一条（同组的 `--dimmed .PlayerControlsNeo__core-controls{opacity:0}`
    // 说明那是“控件隐藏”的另一个状态，不是“控件可见就压暗整帧”）。留 token 记录原文。
    in property <color> player-dim: #00000080;
    // 官方 `.PlayerControlsNeo__layout--active … {opacity:.75}`（已预乘进上面的底色，
    // 留这个数只为对照）。
    in property <float> player-scrim-opacity: 0.75;
    // 进度条三层：轨道 / 已缓冲 / 已播。官方原文（`.nfp .scrubber-container …`）：
    //   `.track{background:#5b5b5b}`、`.buffered{background:hsla(0,0%,100%,.2)}`、
    //   `.current-progress{background:#e50914}`
    in property <color> player-track: #5B5B5B;
    in property <color> player-buffered: #FFFFFF33;
    in property <color> player-progress: #E50914;
    // 海报卡底部的“继续观看”进度条轨道：仍沿用旧的半透明白（卡在海报上，
    // 不能像播放器那样用不透明的 `#5b5b5b`，否则在亮海报上会变成一条深灰。
    in property <color> card-progress-track: #FFFFFF33;
    // 播放器控制行的按钮**没有底色**：官方 `.nfp-button-control{background:transparent}` +
    // `border:3px solid transparent`（底栏里播放/音量/字幕/音轨/全屏全是这一套）。
    // 旧版把 hero 视频圆钮的实测样式（`rgba(22,22,22,.7)` 底 + `1px solid rgba(128,128,128,.7)` 描边）
    // 套到了控制行上，那一层**已删除**——两处来源不同，不要混用（见 §7 / §11.6）。
    // hover 反馈：官方底栏 hover 只换 `fill`、没有底色；我们用一层极淡白
    //（取官方弹层 `li:hover{background:hsla(0,0%,100%,.1)}` 的同一个值）。
    in property <color> player-control-hover: #FFFFFF1A;
    // 官方按钮常驻 `border:3px solid transparent`，键盘焦点时换成 `3px solid #fff`；
    // 所以透明边框色在这里，宽度直接用 `player-focus-width`（3px）。
    in property <color> player-icon-border: #00000000;
    // 菜单 / 错误卡 / 气泡的不透明底：官方 `.nfp-popup-control .popup-content{background:#262626}`。
    in property <color> player-panel-solid: #262626;
    in property <color> player-menu-selected: #FFFFFF14;
    in property <color> warning: #E9A03C;

    // ---- 视口（vw 驱动尺寸的基准；AppWindow 在 init / 变宽时写回）----
    in-out property <length> viewport-width: 1280px;
    // 1vw = 视口宽的百分之一；留白与卡宽全部从这里派生。
    property <length> vw: root.viewport-width / 100;

    // ---- 间距（沿用 4·8·12·16·24·40·60）----
    in property <length> space-1: 4px;
    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-5: 24px;
    in property <length> space-6: 40px;
    in property <length> space-8: 48px;
    // 页面左右留白：4vw（1280 → 51px），≥1920 固定 60px。
    // 只剩「贴窗口边缘的装饰 / 空态面板最大宽度」在用；正文列留白见 `content-gutter`。
    in property <length> gutter: root.viewport-width >= 1920px ? 60px : root.viewport-width * 0.04;
    /// 正文列留白：首页行 / 详情页 / 媒体库 / 搜索页**共用这一个 token**。
    ///
    /// 官方原文（`/tmp/genre_inline.css`，Hawkins 版式的页面级 padding）：
    /// - `@media all{padding:0}`
    /// - `@media all and (min-width: 960px){padding:0 3rem}`（48px）
    /// - `@media all and (min-width: 1280px){padding:0 6.5rem}`（104px）
    /// - `@media all and (min-width: 1920px){padding:0 9.5rem}`（152px）
    /// 外层 `main` 另有 48px，所以内容起点 = 104+48 = **152px（1280–1919）**、
    /// 152+48 = **200px（≥1920）**；1920 下正文列宽 1520px。
    /// 1280 以下沿用 4vw 连续缩放（我们最小窗口就是 1280；官方 960–1279 是 48px 的
    /// padding，见 docs/ui-netflix-1to1.md §10 的偏差记录）。
    in property <length> content-gutter: root.viewport-width >= 1920px ? 200px
        : root.viewport-width >= 1280px ? 152px
        : root.viewport-width * 0.04;
    in property <length> block-gap: 40px;
    in property <length> section-gap: 40px;
    // 行内卡间距：Netflix 实测常量 12px（`margin-right: .75rem`，首末项归零）。
    in property <length> card-gap: 12px;
    // 首行距 billboard 底 24px。
    in property <length> first-row-gap: 24px;

    // ---- 行内卡尺寸：断点常量，不随视口线性缩放 ----
    //
    // Netflix 实测（netflix.com 详情页，同一套 row 组件；1920 视口）：
    // - 横版卡容器 `width: 20.4375rem` = 327px（`@media (min-width:1280px)`），
    //   图片 `aspect-ratio: 1.77515/1`，即 307×173。
    // - 竖版卡 `width: 15rem; height: 21rem` = 240×336（1920 断点），5:7。
    // - 卡间距 `margin-right: .75rem` = 12px，首末项归零。
    // 之前用「视口宽 × 0.166」线性缩放，1280→1920 之间会与 Netflix 明显偏离。
    // 1920 同样是 327px（实测「集數」行卡宽 327；447px 只属于「预告」行，我们没有那种行）。
    in property <length> card-landscape-w: root.viewport-width >= 1920px ? 327px
        : root.viewport-width >= 1280px ? 327px
        : min(root.viewport-width * 0.25, 283px);
    in property <length> card-landscape-h: root.card-landscape-w * 9 / 16;
    // 竖版海报固定 5:7：三档官方尺寸（150×210 / 184×257.6 / 240×336）全部是 5:7，
    // 所以高度统一由这一对比例常量推导，**不写字面高度**（改了宽就不会有第二份真相）。
    // 官方原文（`/tmp/genre_inline.css`，竖版卡容器）：
    //   `@media all{border-radius:0.5rem;width:8.25rem;height:11.55rem;}`
    //   `@media all and (min-width: 960px){width:9.375rem;height:13.125rem;border-radius:0.75rem;}`
    //   `@media all and (min-width: 1280px){width:11.5rem;height:16.1rem;border-radius:0.75rem;}`
    //   `@media all and (min-width: 1920px){width:15rem;height:21rem;border-radius:1rem;}`
    // 换算：9.375rem = 150px、13.125rem = 210px；11.5rem = 184px、16.1rem = 257.6px；
    // 15rem = 240px、21rem = 336px。
    in property <float> poster-ratio-w: 5;
    in property <float> poster-ratio-h: 7;
    in property <length> card-portrait-w: root.viewport-width >= 1920px ? 240px
        : root.viewport-width >= 1280px ? 184px
        : root.viewport-width >= 960px ? 150px
        : min(root.viewport-width * 0.16, 130px);
    in property <length> card-portrait-h: root.card-portrait-w * root.poster-ratio-h / root.poster-ratio-w;

    // ---- 卡片外框（Netflix 集数卡实测）----
    //
    // 卡片自带一层 8px 内衬：容器底 `rgba(255,255,255,.1)`、2px 描边
    // `rgba(255,255,255,.04)`、圆角 16px，图片内缩后圆角同为 16px。
    // 327 宽的卡：327 - 2×(8 + 2) = 307 宽缩略图，与实测 307×173 吻合。
    in property <color> card-frame-bg: #FFFFFF1A;
    in property <color> card-frame-border: #FFFFFF0A;
    in property <length> card-frame-padding: 8px;
    in property <length> card-frame-border-width: 2px;

    // ---- 卡下标题（官方卡片结构：海报在上、一行标题在下，**没有**悬停信息面板）----
    //
    // 官方原文（`/tmp/genre_inline.css`，`li` 里的标题 `p`，类名 `.…-xyhsll`）：
    //   `.…-xyhsll{color:#fff;text-align:center;font-weight:400;
    //              display:-webkit-box;-webkit-line-clamp:3;overflow:hidden;
    //              text-overflow:ellipsis}`
    //   `@media all{line-height:1.125rem;font-size:0.75rem}`
    //   `@media all and (min-width: 960px){line-height:1.3125rem;font-size:0.875rem}`
    //   `@media all and (min-width: 1280px){margin-top:0.25rem}`
    //   `@media all and (min-width: 1920px){margin-top:0.5rem;line-height:1.5rem;font-size:1rem}`
    // 换算：960–1919 → margin-top 4px + 行高 21px（字号 14px）；
    //       ≥1920 → margin-top 8px + 行高 24px（字号 16px）。
    // 即**标题块高 = margin-top + line-height**：1280–1919 = 4 + 21 = 25px、
    // ≥1920 = 8 + 24 = **32px**。竖向合计（≥1920）：
    // `li` = 10.4（padding）+ 336（图）+ 32（标题块）+ 10.4（padding）= 388.8 ✓
    // 与官方 `li` 实测高 388.78 对齐（15rem = 240 宽 / 21rem = 336 高，5:7）。
    // 字号直接复用 Hawkins 梯度（0.875rem = `text-label-size`、1rem = `text-body-size`）。
    in property <length> card-caption-gap: root.viewport-width >= 1920px ? 8px : 4px;
    in property <length> card-caption-line-height: root.viewport-width >= 1920px ? 24px : 21px;
    in property <length> card-caption-size: root.viewport-width >= 1920px ? root.text-body-size
        : root.text-label-size;
    // 标题块高：标题块就是卡片的最后一段，卡片总高 = 图高 + `card-caption-height`。
    in property <length> card-caption-height: root.card-caption-gap + root.card-caption-line-height;

    // ---- 卡片放大（官方 1.05 倍、延迟 400ms、`motion-zoom` ease-in-out、无位移）----
    //
    // 官方原文（`/tmp/genre_inline.css`，卡片的 anchor 元素）：
    //   `.…-dx6epf{transition:transform 0.2s ease-in-out}`
    //   `.…-dx6epf:hover{transform:scale(1.05);z-index:2}`
    // 官方**没有**悬停信息面板（`li` 里只有海报 + 一行标题），所以也没有"上移"。
    in property <float> zoom-factor: 1.05;
    // 延迟复用动效 token：400ms 是公开资料里的"悬停后展开延迟"，见第 9 节。
    in property <duration> zoom-delay: root.motion-delay;
    // 放大余量：1.05 倍在官方 240 宽海报上多 12px、336 高上多 16.8px。
    // 官方兜住这点溢出的正是 `li` 的 padding（`/tmp/genre_inline.css`）：
    //   `@media all and (min-width: 1280px){.…-mi00gi{padding:0.65rem 0.375rem}}`
    // 即左右 0.375rem = 6px、上下 0.65rem = 10.4px（上下合计 20.8px ≥ 16.8px）。
    // 我们的行距 / 卡间距按这两个值立下限：放大卡每边只溢出 allowance/2
    // （横向 6px、竖向 10px），12px 的 `card-gap` 与 12px 的标题下距都够，
    // 所以放大卡不可能盖住行标题、也不可能盖住下一行（原来 1.35 + 96px 预留是为了
    // 盖不住的 56px 信息面板，官方结构下不再需要）。
    in property <length> zoom-allowance-x: 12px;
    in property <length> zoom-allowance-y: 20px;
    // 骨架占位底：官方 CSS `background-color: rgb(35,35,35)`（即 #232323）。
    in property <color> skeleton-bg: #232323;
    // 骨架占位不透明度的上下限（近似做法：不循环，见 `poster_card.slint`）。
    in property <float> skeleton-opacity-low: 0.55;
    in property <float> skeleton-opacity-high: 0.75;
    // 行左右箭头尺寸见上方 `arrow-width` / `arrow-height`（官方 24×80）。
    // 顶栏链接间距：1.5vw（1280 → 19px）。
    in property <length> nav-link-gap: root.viewport-width * 0.015;
    // 顶栏 72px（Netflix header 实测 `height: 72px`），透明浮在 hero 上。
    in property <length> navbar-height: 72px;
    // 顶栏标签的**键盘焦点环**高度：只包住标签文字（与搜索胶囊同高 36px），
    // 不顶满 72px 顶栏——环贴满整条顶栏会看起来像一个选中面板，与"当前标签"的
    // 白色文字（选中态）混在一起。
    in property <length> nav-focus-height: 36px;
    // 未滚动态的压暗渐变：Netflix header 实测
    // `linear-gradient(to top, rgba(0,0,0,0) 0%, rgb(0,0,0) 100%)`。
    // CSS 的 `to top` = 底部透明 → 顶部黑；Slint 的 180deg 从顶部开始写 stops，
    // 所以这里 stops 反过来，视觉与实测一致（压暗顶部）。
    in property <brush> navbar-scroll-gradient: @linear-gradient(180deg, #000000 0%, #00000000 100%);
    // 渐变向下延伸量：72px 顶栏之外再淡出 56px，避免在 hero 上留一条硬边。
    in property <length> navbar-gradient-extend: 56px;
    // 顶部横幅（通知位）：贴顶方角，出现时内容整体下移。
    in property <length> banner-height: 48px;

    // ---- 字号 / 字重（48/34/22/16/14/12）----
    in property <string> font-family: "Inter, Noto Sans CJK SC, PingFang SC, DejaVu Sans";
    /// 等宽字体：**只用于会跳动的数字**（时间码、时长、码率、体积）。
    ///
    /// 为什么不做成全局字体：等宽会把中文标题拉宽、只剩两档字重，层级会塌
    /// （详见 docs/ui-netflix-1to1.md 的"客观限制"）。但 `12:34 / 2:18:00` 这类
    /// 数字用等宽不会左右跳动，是真正受益的地方。
    in property <string> font-mono: "Noto Sans Mono, JetBrains Mono, DejaVu Sans Mono, monospace";
    in property <int> weight-regular: 400;
    in property <int> weight-medium: 500;
    in property <int> weight-semibold: 600;
    in property <int> weight-bold: 700;
    // 官方 Hawkins 令牌 `Text-TextFontWeight` 最大档是 900（hero 主标题用）。
    in property <int> weight-black: 900;
    in property <length> font-12: 12px;
    in property <length> font-14: 14px;
    in property <length> font-16: 16px;
    in property <length> font-20: 20px;
    in property <length> font-22: 22px;
    // 详情页区块标题：实测 32px / 700 / 行高 46px / 下距 12px。
    in property <length> font-32: 32px;
    in property <length> font-34: 34px;
    in property <length> font-42: 42px;
    in property <length> font-48: 48px;

    // ---- 官方 Hawkins 排版梯度（`Text-*` 令牌，字号 + 字重成对）----
    //
    // 官方原文（`/tmp/tw_inline.css`，`--hcw--local-design--Text-*` 的全部取值）：
    //   TextFontSize: 4rem / 3.5rem / 2.5rem / 2rem / 1.5rem / 1.25rem /
    //                 1.125rem / 1rem / 0.875rem / 0.8125rem
    //   TextFontWeight: 400 / 500 / 700 / 900
    //   TextLineHeight: 125%
    // 下面 10 对就是那 10 档（字号→官方字重按 Hawkins 的档位搭配）。
    // 旧的 `font-*` token 全部保留（避免大面积改动），新代码优先用这一组。
    in property <length> text-h1-size: 64px; // 4rem
    in property <int> text-h1-weight: root.weight-black; // 900
    in property <length> text-h2-size: 56px; // 3.5rem
    in property <int> text-h2-weight: root.weight-black; // 900
    in property <length> text-h3-size: 40px; // 2.5rem
    in property <int> text-h3-weight: root.weight-bold; // 700
    in property <length> text-h4-size: 32px; // 2rem
    in property <int> text-h4-weight: root.weight-bold; // 700
    in property <length> text-h5-size: 24px; // 1.5rem
    in property <int> text-h5-weight: root.weight-medium; // 500
    in property <length> text-h6-size: 20px; // 1.25rem
    in property <int> text-h6-weight: root.weight-medium; // 500
    in property <length> text-body-lg-size: 18px; // 1.125rem
    in property <int> text-body-lg-weight: root.weight-medium; // 500
    in property <length> text-body-size: 16px; // 1rem
    in property <int> text-body-weight: root.weight-regular; // 400
    in property <length> text-label-size: 14px; // 0.875rem
    in property <int> text-label-weight: root.weight-regular; // 400
    in property <length> text-caption-size: 13px; // 0.8125rem
    in property <int> text-caption-weight: root.weight-regular; // 400
    /// 官方 `Text-TextLineHeight: 125%`。Slint 没有 CSS 那种全局行高：
    /// 逐元素用 `line-height-factor`。目前只落在行标题上（详情 / 正文的框高是实测值，
    /// 盲改会把已经定好的裁切边界撞坏，见 docs/ui-netflix-1to1.md §10）。
    in property <float> text-line-height: 1.25;

    // ---- 行标题三级断点（官方 Hawkins Text 断点）----
    //
    // - `<960px`：1.25rem / 500（= 20px）
    // - `960–1279`：1.5rem / 500（= 24px）
    // - `≥1280`：2rem / 700（= 32px；1920 实测文本框高 46px、下方留白 12px）
    in property <length> row-title-size-sm: 20px;
    in property <int> row-title-weight-sm: root.weight-medium;
    in property <length> row-title-size-md: 24px;
    in property <int> row-title-weight-md: root.weight-medium;
    in property <length> row-title-size-lg: 32px;
    in property <int> row-title-weight-lg: root.weight-bold;
    // 当前断点解析值（组件只引用这两个 + 下面的高度）。
    in property <length> row-title-size: root.viewport-width >= 1280px ? root.row-title-size-lg
        : root.viewport-width >= 960px ? root.row-title-size-md
        : root.row-title-size-sm;
    in property <int> row-title-weight: root.viewport-width >= 1280px ? root.row-title-weight-lg
        : root.viewport-width >= 960px ? root.row-title-weight-md
        : root.row-title-weight-sm;
    // 详情页 backdrop 占窗口高度比例：实测 hero 845px / 视口 1080px = 0.782。
    in property <float> detail-backdrop-ratio: 0.78;
    // 详情页内容块**底端**距 hero 下缘的距离。
    // 来源：Netflix 官方实测（1920×1080，`netflix.com/tw/title/<id>`，免登录）——
    //   hero 矩形 y 131..976（高 844.88），内容块 rect(136, 424.1, 1648×440)；
    //   内容块底端 424.1 + 440 = 864.1，hero 下缘 976 − 864.1 = 111.9 ≈ **112px**。
    // 内容块顶端因此落在 hero 的 ≈35%（(424.1−131)/844.88 = 34.7%），高度由内容撑开，
    // 所以布局用「底端锚定 + 自身高度反推 y」（见 detail.slint 的 `body`）。
    in property <length> detail-body-bottom-gap: 112px;
    // 顶栏搜索框：展开宽度 / 高度。
    in property <length> search-box-width: 240px;
    in property <length> search-box-height: 36px;
    // 搜索页顶部的大搜索框：高 48px（比顶栏的 240×36 大一档，字号用官方
    // `Text` 的 1.5rem/500 —— 即 `text-h5-size`，已从原来的 22px 正过来）。
    // 页内无 navbar，输入框本身就是页面头，所以尺寸不跟顶栏联动。
    in property <length> search-input-height: 48px;
    // 行内翻页箭头：官方原文（`/tmp/genre_inline.css`，行右缘的 handle 按钮）
    //   `.handle{height:5rem;width:1.5rem;border-radius:16rem;border:none;…
    //            background-color:rgba(128,128,128,0.4)}`
    //   `:hover{border-radius 不变;background-color:rgba(128,128,128,0.2)}`
    // 即 24 宽 × 80 高、胶囊圆角（16rem = 256px，大于半高 → 等价 pill）。
    // （会员端 `akiraClient.css` 的旧实现是 `.slider .handle{width:4%}`、宽屏 `width:60px`、
    //  `background:hsla(0,0%,8%,.5)`；两套来源都在 §10 列了，我们取新的 24×80。）
    in property <length> arrow-width: 24px;
    in property <length> arrow-height: 80px;
    in property <color> arrow-bg: #80808066; // rgba(128,128,128,0.4)
    // 官方 `:hover{background-color:rgba(128,128,128,0.2)}`。我们没改悬停的动画层
    // （上一轮定稿的是 `opacity → 0.85`，见 docs/ui-netflix-1to1.md §9），
    // 官方 hover 底色记在这里备查：`#80808033`。
    // 行左右箭头字形（‹ / ›）字号。
    // 官方是 SVG chevron；我们是字体字形，26px 字形塞进 24px 宽会横向裁切，取 20px。
    in property <length> arrow-glyph-size: 20px;

    // ---- 圆角 ----
    // 海报卡圆角：官方竖版卡容器三档（见上面 card-portrait-w 的原文摘录）
    //   <960 → 0.5rem = 8px；960–1919 → 0.75rem = 12px；≥1920 → 1rem = 16px。
    in property <length> radius-poster: root.viewport-width >= 1920px ? 16px
        : root.viewport-width >= 960px ? 12px
        : 8px;
    in property <length> radius-panel: 6px;
    in property <length> radius-pill: 999px;
    // 徽标 / 角标的方角。
    in property <length> radius-badge: 4px;
    // 按钮方角：官方 Hawkins 令牌 `Button-BorderRadius: 0.25rem` = 4px
    // （会员端按钮；营销页 CTA 是 `border-radius:100px` 的胶囊，见 §10 的两种来源）。
    in property <length> radius-button: 4px;
    // 输入框方角 / 描边：官方 Hawkins 令牌
    //   `Input-BorderRadius: 0.25rem`（4px）、`Input-BorderWidth: 0.0625rem`（1px）、
    //   `Input-Border: rgba(128,128,128,0.7)`。
    // 注意：任务书里写的 `Input-BorderRadius: 6.25rem`（胶囊）在三个样式表里都查不到，
    // 6.25rem 只作为 font-size / 容器 height 出现，令牌原文明确是 0.25rem。
    in property <length> radius-input: 4px;
    in property <color> input-border: #808080B3;
    in property <length> input-border-width: 1px;

    // ---- 动效 ----
    //
    // 全部时长 / 缓动集中在这里：组件里只许引用 token，不写裸时长
    // （`grep -n "duration: [0-9]" crates/nova-ui/ui/*.slint` 应为空）。
    //
    // 取值口径见 `docs/ui-netflix-1to1.md` 第 9 节：标「官方 CSS」的来自 Netflix
    // 一手样式表（`akiraClient.css` / 详情页内联 Hawkins CSS），其余是工程取值。
    in property <duration> motion-fast: 120ms; // 微交互（箭头悬停、字色）：我们自定
    in property <duration> motion: 180ms; // 默认过渡（透明度、顶栏变色、控件显隐）：我们自定
    in property <duration> motion-slow: 300ms; // 内容 / 页面入场：我们自定
    in property <duration> motion-page: 220ms; // 主要区域切换：我们自定
    // 官方 CSS 的骨架周期：`animation: loading 4000ms infinite linear`。
    // 我们**没有**做循环扫光（禁止定时器），骨架是静态占位；这个 token 留着对齐口径。
    in property <duration> motion-pulse: 4000ms;
    in property <duration> motion-delay: 400ms; // 卡片悬停后展开的延迟（公开资料 + 我们自定）
    // 官方 CSS：卡片悬停 `transition: transform 0.2s ease-in-out`。
    in property <duration> motion-zoom: 200ms;
    // 官方 Hawkins 令牌：Button-Duration 250ms / Button-DurationPressed 0ms。
    in property <duration> motion-button: 250ms;
    in property <duration> motion-press: 0ms;
    // 官方 CSS：`.lolomoRow,.rowContainer{transition:transform .54s cubic-bezier(.5,0,.1,1) 0s}`。
    // （官方用在"行展开"；官方没给行入场时长，我们借它当行入场的"大位移"缓动。）
    in property <duration> motion-row: 540ms;
    // 入场位移量：内容/行进场 6px，详情页标题块 +8px 归位。
    in property <length> motion-rise: 6px;
    in property <length> motion-rise-hero: 8px;
    in property <length> focus-offset: 4px;
    in property <length> focus-width: 2px;

    // ---- 缓动曲线（写在各 `animate` 里，原因见下）----
    //
    // 缓动没有做成 token：Slint 1.19 会为 `in property <easing>` 发
    // "Properties of type easing are not supported yet for public API" 的构建警告。
    // 所以曲线直接写在各个 `animate` 里，**只写官方原文里的值**，不自己编贝塞尔：
    //   - 官方 CSS（卡片悬停）：`ease-in-out`
    //   - 官方 Hawkins 令牌 Button-EasingHovered：`cubic-bezier(0.32, 0.94, 0.6, 1)`
    //   - 官方 Hawkins 令牌 Button-Easing（离开 / 按下）：`cubic-bezier(0.4, 0, 0.68, 0.06)`
    //   - 官方 CSS `.lolomoRow`（借作行入场）：`cubic-bezier(0.5, 0, 0.1, 1)`
    //   - 其余（我们自定）：`ease-out`

    // ---- 布局 ----
    // Billboard 高度：官方会员端原文（`/tmp/live_akira.css`）
    //   `.billboard{background-color:#000;height:56.25vw;position:absolute;width:100%;z-index:0}`
    //   `.billboard-row{background-color:#000;margin-bottom:20px;padding-bottom:40%;position:relative;…}`
    // 56.25vw 就是 16:9 满宽视频的高度（16:9 窗口下 = 100vh）。
    // 我们的 billboard 是内容流里的一个块（不是绝对定位的背景层），所以直接满屏会
    // 把整行挤出首屏；这里取 `min(56.25vw, 92vh)` —— **92vh 不是官方值**，是小窗口可用性
    // 折中（1280×800 这类非 16:9 窗口下 56.25vw = 90vh，双约束同时生效）。
    in property <length> billboard-height: root.viewport-width * 0.5625;
    // billboard 文案块左留白：官方会员端原文（`/tmp/live_akira.css`）
    //   `.billboard-row .billboard .info{left:4%;…}`
    //   `@media screen and (min-width:1500px){.billboard-row .billboard .info{left:60px}}`
    // 注意它和正文列（`content-gutter`）**不是一个数**：Netflix 自己的 hero 文案就是
    // 更靠左（4%），行与网格才从 152/200 起。
    in property <length> billboard-left: root.viewport-width >= 1500px ? 60px
        : root.viewport-width * 0.04;
    // 行标题区高度：官方 1920 实测 h2 框高 46px（字号 32），即字号 +14px；
    // 其它断点按同一增量推导（20px 字号 → 34px，与改动前一致）。
    in property <length> section-title-height: root.row-title-size + 14px;
    // 行标题下沿到卡片上沿的间距：官方 12px（1920 实测 h2 下距 12px）。
    // 同时必须 ≥ 放大卡向上的溢出（`zoom-allowance-y` / 2 = 10px），否则 1.05 放大
    // 会压到行标题——这正是旧 1.35 版的问题（见 docs/ui-netflix-1to1.md §10.8）。
    in property <length> row-title-gap: max(root.space-3, root.zoom-allowance-y / 2);
    in property <length> section-title-reveal: 96px;
    // 主按钮统一尺寸（billboard / 详情）：44 高。
    in property <length> button-primary-height: 44px;
    in property <length> play-button-width: 130px;
    in property <length> info-button-width: 150px;
    // ================= 播放器尺寸体系（官方整套播放器用 em）=================
    //
    // 官方原文（`/tmp/live_akira.css`）：
    //   `.NFPlayer.container-large{font-size:24px}`
    //   `.NFPlayer.container-small{font-size:18px}`
    //   `html.watch-video-root{font-size:10px!important}`，另有一串断点：
    //     `@media (max-width:1280px)/(max-height:720px){font-size:9px}`
    //     `(max-width:1152px)/(max-height:648px){8px}`、`(max-width:1024px)/(max-height:576px){7.2px}`、
    //     `(max-width:960px)/(max-height:540px){6.6px}` …
    // 三条线索互相矛盾（container-* 是 loading / postplay 小窗的 18/24px，
    // watch-video-root 才是全屏页面的 html 根），而我们**无法登录会员端**去确认
    // 真实播放器最终生效的基数。所以：
    //   - **比例全部照抄官方 em**；
    //   - **基数由我们选定 16px**（`player-unit`，桌面窗口折中，介于官方 18 与 24 之间）；
    //   - 所有播放器尺寸 = `player-unit × 官方 em 值`，组件里不再写零散 px。
    // 详见 docs/ui-netflix-1to1.md §11。
    in property <length> player-unit: 16px;
    // 控制层边距：官方 `.watch-video .player-loading .top-left-controls{margin:4.5em}`
    // （全屏层 `PlayerControlsNeo__core-controls .top-left-controls{margin:4em}`，
    //  进度行 `padding-left/right:3em`、按钮行 `padding:0 4em`——差异记在 §11）。
    in property <length> player-gutter: root.player-unit * 4.5;
    // 焦点环：官方 `.nf-kb-nav-wrapper.kb-nav … :focus{outline:3px solid #fff}` 与
    // 按钮常驻的 `border:3px solid transparent`。
    in property <length> player-focus-width: 3px;
    in property <color> player-focus-color: #FFFFFF;
    // 进度条（`.nfp .scrubber-container{height:3.3em}` / `.track{height:.5em}` /
    // `:hover/.is-scrubbing → 1em` / `.scrubber-head{height:2.3em;width:2.3em;margin:-1.15em}`）。
    in property <length> player-hit-height: root.player-unit * 3.3;
    in property <length> player-bar-height: root.player-unit * 0.5;
    in property <length> player-bar-height-hover: root.player-unit * 1;
    in property <length> player-bar-knob: root.player-unit * 2.3;
    in property <float> player-bar-knob-scale: 1.2;
    // 标题 / 副标题：官方 loading 层 `.title{font-size:2em;font-weight:500}`、
    // `.subtitle{font-size:1.33em}`；全屏层的 `video-title span{color:#adadad;font-size:2em}`。
    in property <length> player-title-size: root.player-unit * 2;
    in property <int> player-title-weight: root.weight-medium;
    in property <length> player-subtitle-size: root.player-unit * 1.33;
    in property <color> player-subtitle-color: #ADADAD;
    in property <length> player-title-row-height: root.player-title-size * root.text-line-height;
    // 左上返回：官方 `.player-exit{width:1.4em;height:1.4em;opacity:.5;transition:opacity .2s ease-out}`。
    in property <length> player-back-size: root.player-unit * 1.4;
    in property <float> player-back-opacity: 0.5;
    // 不可用控件（错误态下没有意义的 seek 类控件）的整控件透明度。
    // 禁用后仍保留布局位置与尺寸：错误卡弹出时底部控制行不跳动。
    in property <float> player-disabled-opacity: 0.45;
    // 顶部渐变高度：官方 loading 层 `height:11.11111111em`。
    in property <length> player-top-scrim-height: root.player-unit * 11.11111111;
    // 按钮盒：官方 `.nfp-button-control.default-control-button{height:3.22222222em}`；
    // 全屏底栏 `.PlayerControlsNeo__bottom-controls .nfp-button-control{height:3.6em;width:3.4em}`。
    in property <length> player-control-size: root.player-unit * 3.22222222;
    in property <length> player-play-size: root.player-unit * 3.6;
    in property <length> player-control-padding: root.player-unit * 0.83333333;
    // 中央大播放钮（我们自己的覆盖层，官方无对应规则，见 §11 的“自定”清单）。
    in property <length> player-icon-size: root.player-unit * 5.5;
    // 时间码：官方 `.time-remaining__time{font-size:1.8em}`。
    in property <length> player-time-size: root.player-unit * 1.8;
    // 音量滑杆：官方 `.volume-controller .slider-container{width:1.5em;height:8em}`（**垂直** popup）、
    // `.slider-bar-container{background:#5b5b5b;width:.4em}`、`.slider-bar-percentage{background:#e50914}`、
    // `.scrubber-target{height:1em;width:1em}` + `:hover{transform:scale(1.2)}`。
    // 我们按任务书做成**水平**内联展开（官方未给总宽，6em 是我们自定）；
    // 轨道/填充/手柄的比例与颜色照官方。
    in property <length> player-volume-slider-width: root.player-unit * 6;
    in property <length> player-volume-bar: root.player-unit * 0.4;
    in property <length> player-volume-knob: root.player-unit * 1;
    // 拖动时间气泡高（气泡是我们自加的，官方只有 trickplay 缩略图）。
    in property <length> player-bubble-height: root.player-unit * 1.75;
    // 缓冲角标高（自定：官方没有这个角标）。
    in property <length> player-badge-height: root.player-unit * 2.25;
    // ---- 播放器图标：官方 `svg-icon-*` 的 em 比例（宽 × 高）----
    //
    // 官方原文（`/tmp/live_akira.css`，`.watch-video .svg-icon.svg-icon-*` 全套）：
    //   nfplayerPlay/Pause 1.05555556 × 1.22222222
    //   volumeLow/Medium/Max/Muted 1.33333333 × 1.11111111
    //   nfplayerFullscreen/Windowed 1 × 1
    //   nfplayerSubtitles 1.33333333 × 1.11111111
    //   nfplayerEpisodes 1.5 × 1
    //   nfplayerNextEpisode .83333333 × 1
    //   nfplayerBackTen 1.11111111 × 1.33333333（nfplayerFastForward 官方没给单独尺寸，
    //     它和 BackTen 是同一套图形、镜像使用，这里复用同一对比例）
    //   nfplayerReplay 1.5 × 1.5
    //   nfplayerStop 1 × 1
    //   nfplayerMdx/MdxFull 1.22222222 × 1
    //   nfplayerCheck .94444444 × .83333333
    //   nfplayerBack .72222222 × 1
    //   nfplayerExit 1 × 1
    // 注意官方还有一层字号嵌套（`.nfp .svg-icon{font-size:1.1em}` 在 `font-size:2.8em` 的
    // 按钮里，再乘 `.nfp-button-control{font-size:2.8em}`），**我们不复制这层嵌套**：
    // 图标盒直接用 `player-unit × 比例`（任务书口径），比例本身照抄。
    in property <float> player-icon-play-w: 1.05555556;
    in property <float> player-icon-play-h: 1.22222222;
    in property <float> player-icon-volume-w: 1.33333333;
    in property <float> player-icon-volume-h: 1.11111111;
    in property <float> player-icon-fullscreen-w: 1;
    in property <float> player-icon-fullscreen-h: 1;
    in property <float> player-icon-subtitles-w: 1.33333333;
    in property <float> player-icon-subtitles-h: 1.11111111;
    in property <float> player-icon-episodes-w: 1.5;
    in property <float> player-icon-episodes-h: 1;
    in property <float> player-icon-next-episode-w: 0.83333333;
    in property <float> player-icon-next-episode-h: 1;
    in property <float> player-icon-back-ten-w: 1.11111111;
    in property <float> player-icon-back-ten-h: 1.33333333;
    in property <float> player-icon-forward-ten-w: root.player-icon-back-ten-w;
    in property <float> player-icon-forward-ten-h: root.player-icon-back-ten-h;
    in property <float> player-icon-replay-w: 1.5;
    in property <float> player-icon-replay-h: 1.5;
    in property <float> player-icon-stop-w: 1;
    in property <float> player-icon-stop-h: 1;
    in property <float> player-icon-mdx-w: 1.22222222;
    in property <float> player-icon-mdx-h: 1;
    in property <float> player-icon-check-w: 0.94444444;
    in property <float> player-icon-check-h: 0.83333333;
    in property <float> player-icon-back-w: 0.72222222;
    in property <float> player-icon-back-h: 1;
    in property <float> player-icon-exit-w: 1;
    in property <float> player-icon-exit-h: 1;
    // 控制块高度（标题行 + 12 + 进度条命中区 + 16 + 传输行）：
    // 官方底栏是 `height:20%` 的渐变 + 自带 padding，没给“控制块总高”；这个和用来算渐变最小高。
    in property <length> player-controls-block: root.player-title-row-height + root.space-3
        + root.player-hit-height + root.space-4 + root.player-play-size;
    // 渐变最小高度 = 控制块 + 上下各一份留白（官方 20% 在 1080 下是 216px，装不下我们的
    // 控制块；上面多留的那一份是给渐变淡出用的 ramp，否则标题正好压在透明端点上）。
    in property <length> player-scrim-min-height: root.player-controls-block + root.player-gutter * 2;
    // 字幕安全间距：控制块（标题行）顶边与字幕底边之间留的空隙。
    // 只在这一处定义，`player_overlay.slint` 把它并进推给引擎的安全区高度。
    in property <length> player-subtitle-gap: root.player-unit;
    in property <length> player-menu-width: 320px;
    in property <length> player-menu-row: 44px;
    in property <length> player-error-width: 420px;
}

//! 设计令牌：颜色 / 间距 / 字号 / 圆角 / 字体族。Netflix 视觉体系。
//!
//! 组件里不允许写死颜色或尺寸，一律引用这里的 token。

export global Theme {
    // ---- 颜色 ----
    // Netflix 是纯黑底，不是深灰。
    in property <color> bg: #000000;
    // 顶栏实底 / 菜单 / 面板。
    in property <color> surface: #141414;
    // 卡片 / 按钮悬停。
    in property <color> surface-raised: #1F1F1F;
    in property <color> hairline: #262626;
    in property <color> hairline-strong: #404040;
    in property <color> text: #FFFFFF;
    // 元信息（text-secondary）：在 #000 上对比度 8.9:1。
    in property <color> text-muted: #B3B3B3;
    // 次要说明。
    in property <color> text-faint: #808080;
    // 品牌红：只用于 logo 点、选中态、进度条，不大面积铺。
    in property <color> accent: #E50914;
    in property <color> accent-hover: #F6121D;
    // 红底上的文字 / 图标。
    in property <color> accent-contrast: #FFFFFF;
    in property <color> danger: #E50914;
    // 压图遮罩 / badge 底 / 悬停洗色。
    in property <color> scrim: #000000E6;
    in property <color> scrim-soft: #000000A6;
    in property <color> hero-scrim: #000000CC;
    in property <color> badge-bg: #000000B3;
    in property <color> wash: #FFFFFF1F;
    // 主按钮（播放）：白底黑字。
    in property <color> btn-primary-bg: #FFFFFF;
    in property <color> btn-primary-fg: #000000;
    // 次按钮（更多信息 / 我的列表）。
    in property <color> btn-secondary-bg: #FFFFFF26;
    in property <color> player-bg: #000000;
    // 播放控制层：底部渐变遮罩（比普通页面更深）。
    in property <color> player-scrim-bottom: #000000F0;
    in property <color> player-scrim-mid: #000000D9;
    in property <color> player-scrim-top: #00000000;
    // 进度条三层：轨道 / 已缓冲 / 已播（Netflix 红）。
    in property <color> player-track: #FFFFFF33;
    in property <color> player-buffered: #FFFFFF66;
    // 控件底：Netflix 风格去掉胶囊底，只在悬停时出现一层淡白。
    in property <color> player-icon-bg: transparent;
    // 菜单 / 错误卡 / 气泡的不透明底。
    in property <color> player-panel-solid: #141414;
    in property <color> player-menu-selected: #FFFFFF14;
    in property <color> warning: #E9A03C;

    // ---- 视口（vw 驱动尺寸的基准；AppWindow 在 init / 变宽时写回）----
    in-out property <length> viewport-width: 1280px;
    // 1vw = 视口宽的百分之一；留白与卡宽全部从这里派生。
    property <length> vw: root.viewport-width / 100;

    // ---- 间距（沿用 4·8·12·16·24·40·60）----
    in property <length> space-1: 4px;
    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-5: 24px;
    in property <length> space-6: 40px;
    in property <length> space-8: 48px;
    // 页面左右留白：4vw（1280 → 51px），≥1920 固定 60px。
    in property <length> gutter: root.viewport-width >= 1920px ? 60px : root.viewport-width * 0.04;
    in property <length> block-gap: 40px;
    in property <length> section-gap: 40px;
    // 行内卡间距：Netflix 实测常量 12px（`margin-right: .75rem`，首末项归零）。
    in property <length> card-gap: 12px;
    // 首行距 billboard 底 24px。
    in property <length> first-row-gap: 24px;

    // ---- 行内卡尺寸：断点常量，不随视口线性缩放 ----
    //
    // Netflix 实测（netflix.com 详情页，同一套 row 组件；1920 视口）：
    // - 横版卡容器 `width: 20.4375rem` = 327px（`@media (min-width:1280px)`），
    //   图片 `aspect-ratio: 1.77515/1`，即 307×173。
    // - 竖版卡 `width: 15rem; height: 21rem` = 240×336（1920 断点），5:7。
    // - 卡间距 `margin-right: .75rem` = 12px，首末项归零。
    // 之前用「视口宽 × 0.166」线性缩放，1280→1920 之间会与 Netflix 明显偏离。
    in property <length> card-landscape-w: root.viewport-width >= 1920px ? 447px
        : root.viewport-width >= 1280px ? 327px
        : min(root.viewport-width * 0.25, 283px);
    in property <length> card-landscape-h: root.card-landscape-w * 9 / 16;
    in property <length> card-portrait-w: root.viewport-width >= 1920px ? 240px
        : root.viewport-width >= 1280px ? 184px
        : min(root.viewport-width * 0.16, 130px);
    in property <length> card-portrait-h: root.card-portrait-w * 7 / 5;

    // ---- 卡片放大（清单：1.35 倍、延迟 400ms、200ms ease-out、上移 12px）----
    in property <float> zoom-factor: 1.35;
    in property <duration> zoom-delay: 400ms;
    in property <duration> zoom-duration: 200ms;
    in property <length> zoom-rise: 12px;
    // 放大卡底部信息面板：56px、#181818。
    in property <length> zoom-info-height: 56px;
    in property <color> zoom-panel-bg: #181818;
    // 行高里为放大卡下探预留的空间（覆盖 2:3 卡放大的最大下探量 ≈92px）。
    //
    // Netflix 的做法更含蓄：放大上限只有 scale(1.05)，余量预留在卡片容器的
    // padding 里（上下 10.4px ≥ 5% 放大所需的 8.4px），行高本身由内容撑开。
    // 我们放大到 1.35，余量必须显式留，否则会压到下一行。
    in property <length> zoom-allowance: 96px;
    // 行左右箭头：48×48 半透明黑圆角块。
    in property <length> arrow-size: 48px;
    // 顶栏链接间距：1.5vw（1280 → 19px）。
    in property <length> nav-link-gap: root.viewport-width * 0.015;
    // 顶栏 68px，透明浮在 hero 上。
    in property <length> navbar-height: 68px;
    // 顶部横幅（通知位）：贴顶方角，出现时内容整体下移。
    in property <length> banner-height: 48px;

    // ---- 字号 / 字重（48/34/22/16/14/12）----
    in property <string> font-family: "Inter, Noto Sans CJK SC, PingFang SC, DejaVu Sans";
    /// 等宽字体：**只用于会跳动的数字**（时间码、时长、码率、体积）。
    ///
    /// 为什么不做成全局字体：等宽会把中文标题拉宽、只剩两档字重，层级会塌
    /// （详见 docs/ui-netflix-1to1.md 的"客观限制"）。但 `12:34 / 2:18:00` 这类
    /// 数字用等宽不会左右跳动，是真正受益的地方。
    in property <string> font-mono: "Noto Sans Mono, JetBrains Mono, DejaVu Sans Mono, monospace";
    in property <int> weight-regular: 400;
    in property <int> weight-medium: 500;
    in property <int> weight-semibold: 600;
    in property <int> weight-bold: 700;
    in property <length> font-12: 12px;
    in property <length> font-14: 14px;
    in property <length> font-16: 16px;
    in property <length> font-20: 20px;
    in property <length> font-22: 22px;
    in property <length> font-34: 34px;
    in property <length> font-42: 42px;
    in property <length> font-48: 48px;
    // 详情页 backdrop 占窗口高度比例（60vh）。
    in property <float> detail-backdrop-ratio: 0.6;
    // 顶栏搜索框：展开宽度 / 高度。
    in property <length> search-box-width: 240px;
    in property <length> search-box-height: 36px;
    // 行左右箭头字形（‹ / ›）字号。
    in property <length> arrow-glyph-size: 26px;

    // ---- 圆角（4 / 6）----
    // 卡片圆角：Netflix 实测 1rem = 16px（图片与容器一致）。
    in property <length> radius-poster: 16px;
    in property <length> radius-panel: 6px;
    in property <length> radius-pill: 999px;
    in property <length> radius-badge: 4px;

    // ---- 动效（只这三种，180–200ms、ease-out）----
    in property <duration> motion: 180ms;
    in property <length> focus-offset: 4px;
    in property <length> focus-width: 2px;

    // ---- 布局 ----
    // Billboard：88vh、最大 720px（页面里按视口高度算）；左侧留白跟随 4vw gutter。
    in property <length> billboard-max: 720px;
    in property <length> billboard-left: root.gutter;
    // 媒体库列数断点：宽 ≥1440 用 7 列，否则 6 列。
    in property <length> library-breakpoint: 1440px;
    // 行标题行高与"至少露出标题"的可见性约束。
    in property <length> section-title-height: 34px;
    in property <length> section-title-reveal: 96px;
    // 主按钮统一尺寸（billboard / 详情）：44 高。
    in property <length> button-primary-height: 44px;
    in property <length> play-button-width: 130px;
    in property <length> info-button-width: 150px;
    // 播放页参数不变。
    in property <length> player-scrim-height: 264px;
    in property <length> player-bar-height: 4px;
    in property <length> player-hit-height: 28px;
    in property <length> player-control-size: 40px;
    in property <length> player-play-size: 56px;
    in property <length> player-icon-size: 88px;
    in property <length> player-menu-width: 320px;
    in property <length> player-menu-row: 44px;
    in property <length> player-controls-bottom: 24px;
    in property <length> player-error-width: 420px;
}

//! 搜索页（Netflix 式的独立结果页）。
//!
//! 与"在首页就地过滤"不同：输入即切到本页，结果是**独立路由**上的结果网格。
//! 结构（自上而下）：
//!
//! 1. 顶部大搜索框：`navbar-height` 之下再留 `space-6`，左右 `content-gutter`，
//!    高 `search-input-height`（48px）、字号用官方 Hawkins `Text` 的 1.5rem/500
//!    （`text-h5-size/weight`）、透明底 + 底部 1px `hairline`；
//! 2. 结果头：`「{term}」的搜索结果` + `共 {total} 部`（与 `library.slint` 的标题行同构）；
//! 3. 结果网格：`PosterGrid`（5:7 竖版卡、6 列、`content-gutter` / `card-gap`、
//!    放大覆盖层）——与媒体库页是**同一个组件**，不是第二份公式；
//! 4. 三态：`Loading` 文案 / `Empty` 空态 / `Error` 错误卡（带重试）。
//!
//! 页内不画顶栏：搜索框本身就是页头（避免出现两个搜索框）。`Esc` 清空并回首页，
//! 「×」只清空关键词、留在本页并聚焦输入框；
//! `Enter` 提交后把焦点还给全局键盘（方向键才能在结果网格里移动）。

import { Theme } from "theme.slint";
import { SearchData, Target, TargetBus } from "models.slint";
import { PosterGrid } from "poster_grid.slint";
import { EmptyState } from "empty_state.slint";
import { Navbar } from "navbar.slint";

export component SearchPage inherits Rectangle {
    in property <SearchData> data;
    in-out property <int> focus-index: 0;
    // 用户是否已开始导航；未激活时网格不放大任何卡（见 `poster_grid.slint`）。
    in property <bool> nav-active: false;
    // 键盘焦点层（体检 R2-2b）：`nav-focus` 是顶栏焦点下标（-1 = 不在顶栏）；
    // `content-focused` = 结果网格是否持有键盘焦点（焦点跑到顶栏时不再放大卡片）。
    in property <int> nav-focus: -1;
    in property <bool> content-focused: true;
    // 搜索框文本：与 AppWindow 双向同步（回填当前查询词）。
    in-out property <string> search-text;
    // 搜索输入框的真实焦点状态（顶栏用；由 `app.slint` 绑定到 `root.search-focused`）。
    in property <bool> search-focused: false;
    // 结果网格实例化窗口（Rust 写；见 `poster_grid.slint` 的 `window-start`）。
    in-out property <int> grid-window-start: 0;
    in-out property <int> grid-window-count: -1;
    // 结果区视口 / 网格几何变化：通知 Rust 重算实例化窗口。
    callback grid-viewport-changed();

    callback open-item(string);
    // 顶栏标签被点击：交给 AppWindow 统一切路由。
    callback tab-activated(string);
    // 顶栏搜索入口（搜索页内胶囊框隐藏，但回调仍接到 root，避免键盘事件黑洞）。
    callback search();
    // 输入即时反馈（每次编辑都发，参数是当前全文）。
    callback search-changed(string);
    // Enter 提交。
    callback search-submit();
    // 清空按钮 / Esc：清空查询并回首页。
    callback search-clear();
    // 清空按钮（×）：只清空查询词、留在搜索页，焦点回输入框。
    callback search-clear-input();
    // 顶栏输入框里的 Esc：交给上层退出聚焦。
    callback search-escape();
    // Esc 或 Enter 之后把焦点还给全局键盘（方向键导航结果网格）。
    callback search-blur();
    // 页内输入框 ↓：焦点交给结果网格的第一张卡（R7-D1）。
    // 输入框会把 ↑ / ↓ 当编辑键吃掉，事件也冒泡不到兄弟节点 `keyboard`，
    // 所以必须在这里主动上报（与 `global-shortcut` 同一类绕道）。
    callback search-grid-focus();
    // 页内输入框 ↑：进顶栏（与首页 / 媒体库的 chrome 层同一套）。
    callback search-navbar-focus();
    // 错误态的"重试"。
    callback search-retry();
    // 页内大输入框里仍要生效的全局快捷键（参数是 `AppWindow.key-intent` 的意图编号）。
    // 原因见 `navbar.slint` 的 `global-shortcut`：TextInput 会先吞掉 Ctrl 组合。
    callback global-shortcut(int);

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 页面直接摆放的搜索框与清除按钮声明式列出；结果卡片 / 顶栏标签 / 空态按钮
    // 由子组件自己登记到 `TargetBus`。
    // 清除按钮只在有输入时显示（`clear-button.visible`），隐藏时不能列为可点目标，
    // 否则交互扫描会把一个看不见的按钮记成"点了没反应"。
    out property <[Target]> targets: root.search-text == "" ? [
        {
            id: "search.input",
            kind: "input",
            label: "搜索页输入框",
            x: query.absolute-position.x,
            y: query.absolute-position.y,
            width: query.width,
            height: query.height,
        },
    ] : [
        {
            id: "search.input",
            kind: "input",
            label: "搜索页输入框",
            x: query.absolute-position.x,
            y: query.absolute-position.y,
            width: query.width,
            height: query.height,
        },
        {
            id: "search.clear",
            kind: "button",
            label: "清除搜索",
            x: clear-area.absolute-position.x,
            y: clear-area.absolute-position.y,
            width: clear-area.width,
            height: clear-area.height,
        },
    ];

    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.visible) {
                TargetBus.register(target);
            }
        }
    }

    // 见 `focus-input`：`set-selection-offsets` 用的是 UTF-8 字节偏移。
    property <int> text-end: 2147483647;

    // 本次聚焦期间是否还相信 `preedit-text` 反映“正在组字”（↑ / ↓ 让给输入法的判据）。
    //
    // `preedit-text` 是 Slint 的内部、未文档化属性（见 i-slint-compiler 的
    // `builtin_elements.rs`）；输入法异常时它可能一直不清空，把 ↑ / ↓ 永久拒绝。
    // 兜底（`changed` 不能挂在内置元素的属性上，只能在事件里判断）：
    // - 文本真的被编辑（`edited`，含提交）、`Enter` 提交、`Esc` 后置假，
    //   不再拿 `preedit-text` 拦方向键；
    // - 之后只要观察到 `preedit-text` 已回到空串（输入法恢复正常）就重新置真，
    //   真实组字仍然受保护。
    property <bool> ime-rely-on-preedit: true;

    /// 把焦点交给本页的搜索框（Ctrl+F / 从顶栏首次输入时由上层调到这里）。
    public function focus-input() {
        // 已经在本框里打字时不碰光标：否则在中间改字会被强行跳到末尾。
        if (query.has-focus) {
            return;
        }
        query.focus();
        // 从顶栏交接过来时，文本是经两向绑定**程序化**写进来的：TextInput 会把
        // 光标留在旧位置（这个框刚拿到文本时是 0），接着敲的字符就插到了开头——
        // 顶栏输入 `12345` 变成 `23451`（在本页大框里自己输入没有这个问题）。
        // 把光标（focus）与锚点（anchor）一起推到末尾。偏移超出文本时 TextInput
        // 会 clamp 到文本长度，所以给一个足够大的值最稳（`string.length` 是字素簇
        // 个数，不是 UTF-8 字节偏移，不能直接拿来用）。
        query.set-selection-offsets(root.text-end, root.text-end);
    }

    /// 键盘焦点移出可视区时，把结果网格滚到焦点卡**完全可见**。
    ///
    /// 与媒体库页同一套逻辑（几何都从 `PosterGrid` 读，不重写布局公式）：
    /// 本页的 Flickable 从 `results-y` 开始，`PosterGrid` 的内容区原点在里面，
    /// 所以只算网格内部的行位置即可。放大余量见 `theme.slint`。
    public function scroll-to-index(index: int) {
        if (index < 0 || index >= root.data.cards.length) {
            return;
        }
        let pad = Theme.zoom-allowance-y / 2;
        let top = grid.grid-top + floor(index / root.columns) * grid.row-height;
        let bottom = top + grid.card-height;
        let view-top = -results.content-y;
        let max-y = max(0px, grid.content-height - results.height);
        if (top - pad < view-top) {
            results.content-y = -clamp(top - pad, 0px, max-y);
        } else if (bottom + pad > view-top + results.height) {
            results.content-y = -clamp(bottom + pad - results.height, 0px, max-y);
        }
    }

    background: Theme.bg;

    // ---- 几何 ----
    property <int> columns: 6;
    // 搜索框：navbar 高度之下再留 40px。
    property <length> bar-y: Theme.navbar-height + Theme.space-6;
    property <length> bar-height: Theme.search-input-height;
    // 结果区起点：搜索框下沿 + 24px。
    property <length> results-y: root.bar-y + root.bar-height + Theme.space-5;
    // 结果头行高与网格起点（内容区坐标）。
    property <length> header-height: Theme.row-title-size;
    property <length> grid-top: root.header-height + Theme.space-4;

    // ---- 探针（测试用：6 列 / 5:7 / 起点 = content-gutter）----
    out property <int> probe-columns: root.columns;
    out property <length> probe-card-w: grid.card-width;
    // 图高（5:7）与卡片总高（图高 + 卡下标题块）分开报，别混。
    out property <length> probe-poster-h: grid.poster-height;
    out property <length> probe-card-h: grid.card-height;
    out property <length> probe-row-h: grid.row-height;
    out property <length> probe-card-step: grid.card-step;
    out property <length> probe-gutter: grid.content-gutter;
    out property <length> probe-first-x: grid.first-card-x;

    // ---- 顶部大搜索框 ----
    Rectangle {
        x: Theme.content-gutter;
        y: root.bar-y;
        width: parent.width - Theme.content-gutter * 2;
        height: root.bar-height;
        background: transparent;

        // 下划线（Netflix 搜索页的输入框只有底边一条 1px 线）。
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: 1px;
            background: query.has-focus ? Theme.hairline-strong : Theme.hairline;
        }

        // 占位文案（TextInput 在 1.19 没有 placeholder 属性，与顶栏同做法）。
        Text {
            x: 0;
            y: 0;
            width: parent.width - clear-button.width - Theme.space-4;
            height: parent.height;
            text: "搜索影片、剧集…";
            color: Theme.text-faint;
            font-family: Theme.font-family;
            // 官方 Hawkins Text 的 1.5rem/500 档（原来是 22px）。
            font-size: Theme.text-h5-size;
            font-weight: Theme.text-h5-weight;
            vertical-alignment: center;
            visible: root.search-text == "";
        }

        query := TextInput {
            x: 0;
            y: 0;
            width: parent.width - clear-button.width - Theme.space-4;
            height: parent.height;
            text <=> root.search-text;
            color: Theme.text;
            font-family: Theme.font-family;
            // 官方 Hawkins Text 的 1.5rem/500 档（原来是 22px）。
            font-size: Theme.text-h5-size;
            font-weight: Theme.text-h5-weight;
            vertical-alignment: center;
            single-line: true;

            edited => {
                // 文本真的变了：即使输入法没清 `preedit-text`（异常），也说明这次
                // 组字已被提交 / 被普通输入取代，不再拿它拦方向键。
                root.ime-rely-on-preedit = false;
                root.search-changed(root.search-text);
            }
            accepted => {
                root.search-submit();
                // 提交后组字一定结束了：`preedit-text` 可能没被输入法清掉，
                // 不再拿它拦方向键（`preedit-text` 回到空串时自动重新信任）。
                root.ime-rely-on-preedit = false;
                // 焦点还给全局键盘：方向键/Enter 才能在结果网格里用。
                query.clear-focus();
                root.search-blur();
            }
            key-pressed(event) => {
                // `preedit-text` 回到空串：输入法（又）正常了，重新信任它。
                // 只在按键时检查（`changed` 不能挂在内置元素的属性上）。
                if (query.preedit-text == "") {
                    root.ime-rely-on-preedit = true;
                }
                // Esc：清空并回首页（不需要先进文本框再退聚焦）。
                //
                // 清空之后必须**主动交还焦点**：与同文件的 `accepted` 分支同一
                // 处理。否则输入框仍然握着键盘，方向键 / Enter 全部无响应
                // （体检 R2-1 的页内 Esc 路径；顶栏输入框有 `search-escape`，
                // 这里以前漏了）。
                if (event.text == Key.Escape) {
                    root.search-clear();
                    // 失焦 / 离开搜索页：不再依赖 `preedit-text`（同上，它可能
                    // 没被输入法清掉）。
                    root.ime-rely-on-preedit = false;
                    query.clear-focus();
                    root.search-blur();
                    return accept;
                }
                // 输入法组字期间：↑ / ↓ 属于输入法（候选上下移 / 组字光标），
                // **不交接焦点**。`preedit-text` 是 Slint 暴露的预编辑状态
                // （`TextInput` 的内部、未文档化属性，见 i-slint-compiler 的
                // `builtin_elements.rs`）；非空 = 正在组字。这里 return reject，
                // 把键还给 TextInput / 上层输入法处理。
                //
                // 还要求 `ime-rely-on-preedit`：输入法异常时 `preedit-text`
                // 可能一直不清空，不能让它把方向键永久拒掉。
                if ((event.text == Key.UpArrow || event.text == Key.DownArrow)
                    && root.ime-rely-on-preedit && query.preedit-text != "") {
                    return reject;
                }
                // ↓：有结果时进结果网格（R7-D1）。以前它被 TextInput 当编辑键
                // 吃掉，用户必须 Tab / Esc 手动释放焦点才能用方向键——
                // 而进入搜索页时输入框本来就拿着焦点，网格等于完全不可达。
                // 结果为空时焦点留在输入框（Netflix 同款：不需要额外反馈）。
                if (event.text == Key.DownArrow) {
                    if (root.data.cards.length > 0) {
                        query.clear-focus();
                        root.search-blur();
                        root.search-grid-focus();
                        return accept;
                    }
                    return accept;
                }
                // ↑：离开输入框进顶栏（标签在任何时候都键盘可达）。
                if (event.text == Key.UpArrow) {
                    query.clear-focus();
                    root.search-blur();
                    root.search-navbar-focus();
                    return accept;
                }
                // 8 = Ctrl+N（打开“添加服务器”），7 = Ctrl+F（重新聚焦搜索）。
                // TextInput 会先吞掉 Ctrl 组合，所以这里主动上报（见 navbar.slint）。
                if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                    root.global-shortcut(8);
                    return accept;
                }
                if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                    root.global-shortcut(7);
                    return accept;
                }
                return reject;
            }
        }

        // 清空按钮：有输入时出现。
        clear-button := Rectangle {
            visible: root.search-text != "";
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-pill;
            background: clear-area.has-hover ? Theme.wash : transparent;
            animate background {
                // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                duration: Theme.motion-button;
                easing: cubic-bezier(0.32, 0.94, 0.6, 1);
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.press-wash;
                opacity: clear-area.pressed ? 1 : 0;
                animate opacity {
                    // 官方 Hawkins 令牌：Button-DurationPressed 0ms。
                    duration: Theme.motion-press;
                    easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-20;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            clear-area := TouchArea {
                clicked => {
                    // 「×」只清空关键词、留在本页；`Esc` 才是"清空并回首页"。
                    root.search-clear-input();
                }
            }
        }
    }

    // ---- Loading：不转圈（零依赖），只给一行文案 ----
    if (root.data.state == 1) :
        Text {
            x: Theme.content-gutter;
            y: root.results-y;
            width: parent.width - Theme.content-gutter * 2;
            height: Theme.font-22;
            text: "搜索中…";
            color: Theme.text-muted;
            font-family: Theme.font-family;
            font-size: Theme.font-14;
            vertical-alignment: center;
        }

    // ---- 结果网格（Ready 态可见；其余状态隐藏，但组件始终存在，
    //      这样探针属性与焦点索引在四态之间不会失效）----
    // 不按 `state` 门控 `visible`：Slint 首次求值不播动画，网格若在数据到达前
    // 是隐藏的，入场淡入会被跳过。空/错误态面板在它之后绘制，会盖在上面；
    // 卡片列表为空时网格本身不画东西，所以常驻是安全的（`interactive` 关掉）。
    results := Flickable {
        x: 0;
        y: root.results-y;
        width: parent.width;
        height: parent.height - root.results-y;
        interactive: root.data.state == 2;
        content-width: self.width;
        content-height: content.height;

        content := Rectangle {
            width: parent.width;
            height: grid.content-height;

            // 结果头：「{term}」的搜索结果 + 共 N 部（非 Ready 态藏起来，
            // 别在空/错误态面板后面露出空的"共 0 部"）。
            HorizontalLayout {
                visible: root.data.state == 2;
                x: Theme.content-gutter;
                y: 0;
                width: parent.width - Theme.content-gutter * 2;
                height: root.header-height;
                spacing: Theme.space-4;

                Text {
                    text: root.data.title;
                    color: Theme.text;
                    font-family: Theme.font-family;
                    // 与首页行标题同一组断点 token（<960 20/500、960–1279 24/500、≥1280 32/700）。
                    font-size: Theme.row-title-size;
                    font-weight: Theme.row-title-weight;
                    vertical-alignment: center;
                }

                Text {
                    text: root.data.count-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                    vertical-alignment: center;
                }

                // 占满剩余宽度：标题与数量保持各自的自然宽度（与 media 库标题行同构）。
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
            }

            // 结果网格：与媒体库页共用 `PosterGrid`（唯一一套 5:7 网格几何）。
            grid := PosterGrid {
                x: 0;
                y: 0;
                width: parent.width;
                target-prefix: "search.";
                targets-visible: root.data.state == 2;
                nav-active: root.nav-active && root.content-focused;
                columns: root.columns;
                grid-top: root.grid-top;
                // 放大覆盖层不许盖住结果头：上边界就是第一行卡片的顶边
                // （媒体库页是顶栏下沿，本页没有顶栏，改用结果头下沿）。
                overlay-clamp-top: root.grid-top;
                cards: root.data.cards;
                focus-index <=> root.focus-index;
                window-start: root.grid-window-start;
                window-count: root.grid-window-count;
                scroll-y: -results.content-y;
                viewport-height: results.height;
                viewport-changed => {
                    root.grid-viewport-changed();
                }
                open(id) => {
                    root.open-item(id);
                }
            }
        }
    }

    // ---- 探针（测试用：键盘焦点卡是否真的在可视区内）----
    out property <length> probe-scroll-y: results.content-y;
    out property <length> probe-viewport-h: results.height;
    // 探针：键盘焦点卡在**视口坐标**里的上下沿（内容坐标 + 结果区滚动偏移，体检 R3-2）：
    // `0 ≤ top` 且 `bottom ≤ viewport_h` 就是“焦点卡在视口内”。
    out property <length> probe-focus-top: grid.probe-focus-top + results.content-y;
    out property <length> probe-focus-bottom: grid.probe-focus-bottom + results.content-y;
    out property <bool> probe-zoom-on: grid.probe-zoom-on;
    // 窗口化探针：实例化区间 / 总张数 / 网格行高与起点（Rust 侧按这些算窗口）。
    out property <int> probe-window-start: grid.probe-window-start;
    out property <int> probe-window-count: grid.probe-window-count;
    out property <int> probe-total-count: grid.probe-total-count;
    out property <length> probe-row-height: grid.probe-row-height;
    out property <length> probe-grid-top: grid.probe-grid-top;
    // 顶栏键盘焦点的几何探针（`navbar.slint` 的 `probe-*` 转发）。
    out property <length> probe-focus-tab-left: nav.probe-focus-tab-left;
    out property <length> probe-focus-tab-right: nav.probe-focus-tab-right;
    out property <length> probe-tabs-viewport-w: nav.probe-tabs-viewport-w;
    out property <length> probe-tabs-scroll-x: nav.probe-tabs-scroll-x;

    // ---- Empty：没有命中 ----
    if (root.data.state == 3) :
        EmptyState {
            y: root.results-y;
            width: parent.width;
            height: parent.height - root.results-y;
            target-prefix: "search.";
            targets-visible: root.visible;
            title: "没有找到相关内容";
            message: "换个关键词试试";
        }

    // ---- Error：失败原因 + 重试 ----
    if (root.data.state == 4) :
        EmptyState {
            y: root.results-y;
            width: parent.width;
            height: parent.height - root.results-y;
            target-prefix: "search.";
            targets-visible: root.visible;
            title: "搜索失败";
            message: root.data.error;
            primary-label: "重试";
            primary => {
                root.search-retry();
            }
        }

    // ---- 顶栏 ----
    // Netflix 任何页面都有 header（logo / 导航 / 头像），搜索页也不例外。
    // 但顶栏的胶囊搜索框藏起来（`show-search: false`）——页内已经有一个更大的
    // 搜索框，两个输入框同屏会互相抢焦点。
    nav := Navbar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height;
        tabs: root.data.tabs;
        current-index: root.data.current-tab;
        // 结果区滚动超过 40px 后顶栏变实底（与 `library.slint` 同一阈值）。
        scrolled: results.content-y < -40px;
        show-search: false;
        target-prefix: "search.";
        targets-visible: root.visible;
        focus-index: root.nav-focus;
        search-focused: root.search-focused;
        search-text <=> root.search-text;
        tab-activated(id) => {
            root.tab-activated(id);
        }
        search => {
            root.search();
        }
        search-changed(text) => {
            root.search-changed(text);
        }
        search-submit => {
            root.search-submit();
        }
        search-clear => {
            root.search-clear();
        }
        search-escape => {
            root.search-escape();
        }
    }
}

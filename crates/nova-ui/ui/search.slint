//! 搜索页（Netflix 式的独立结果页）。
//!
//! 与"在首页就地过滤"不同：输入即切到本页，结果是**独立路由**上的结果网格。
//! 结构（自上而下）：
//!
//! 1. 顶部大搜索框：`navbar-height` 之下再留 `space-6`，左右 `content-gutter`，
//!    高 `search-input-height`（48px）、字号用官方 Hawkins `Text` 的 1.5rem/500
//!    （`text-h5-size/weight`）、透明底 + 底部 1px `hairline`；
//! 2. 结果头：`「{term}」的搜索结果` + `共 {total} 部`（与 `library.slint` 的标题行同构）；
//! 3. 结果网格：`PosterGrid`（5:7 竖版卡、6 列、`content-gutter` / `card-gap`、
//!    放大覆盖层）——与媒体库页是**同一个组件**，不是第二份公式；
//! 4. 三态：`Loading` 文案 / `Empty` 空态 / `Error` 错误卡（带重试）。
//!
//! 页内不画顶栏：搜索框本身就是页头（避免出现两个搜索框）。`Esc` 清空并回首页，
//! `Enter` 提交后把焦点还给全局键盘（方向键才能在结果网格里移动）。

import { Theme } from "theme.slint";
import { SearchData, Target, TargetBus } from "models.slint";
import { PosterGrid } from "poster_grid.slint";
import { EmptyState } from "empty_state.slint";
import { Navbar } from "navbar.slint";

export component SearchPage inherits Rectangle {
    in property <SearchData> data;
    in-out property <int> focus-index: 0;
    // 用户是否已开始导航；未激活时网格不放大任何卡（见 `poster_grid.slint`）。
    in property <bool> nav-active: false;
    // 搜索框文本：与 AppWindow 双向同步（回填当前查询词）。
    in-out property <string> search-text;
    // 搜索输入框的真实焦点状态（顶栏用；由 `app.slint` 绑定到 `root.search-focused`）。
    in property <bool> search-focused: false;

    callback open-item(string);
    // 顶栏标签被点击：交给 AppWindow 统一切路由。
    callback tab-activated(string);
    // 顶栏搜索入口（搜索页内胶囊框隐藏，但回调仍接到 root，避免键盘事件黑洞）。
    callback search();
    // 输入即时反馈（每次编辑都发，参数是当前全文）。
    callback search-changed(string);
    // Enter 提交。
    callback search-submit();
    // 清空按钮 / Esc：清空查询并回首页。
    callback search-clear();
    // 顶栏输入框里的 Esc：交给上层退出聚焦。
    callback search-escape();
    // Esc 或 Enter 之后把焦点还给全局键盘（方向键导航结果网格）。
    callback search-blur();
    // 错误态的"重试"。
    callback search-retry();

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 页面直接摆放的搜索框与清除按钮声明式列出；结果卡片 / 顶栏标签 / 空态按钮
    // 由子组件自己登记到 `TargetBus`。
    out property <[Target]> targets: [
        {
            id: "search.input",
            kind: "input",
            label: "搜索页输入框",
            x: query.absolute-position.x,
            y: query.absolute-position.y,
            width: query.width,
            height: query.height,
        },
        {
            id: "search.clear",
            kind: "button",
            label: "清除搜索",
            x: clear-area.absolute-position.x,
            y: clear-area.absolute-position.y,
            width: clear-area.width,
            height: clear-area.height,
        },
    ];

    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.visible) {
                TargetBus.register(target);
            }
        }
    }

    /// 把焦点交给本页的搜索框（Ctrl+F / 从顶栏首次输入时由上层调到这里）。
    public function focus-input() {
        query.focus();
    }

    background: Theme.bg;

    // ---- 几何 ----
    property <int> columns: 6;
    // 搜索框：navbar 高度之下再留 40px。
    property <length> bar-y: Theme.navbar-height + Theme.space-6;
    property <length> bar-height: Theme.search-input-height;
    // 结果区起点：搜索框下沿 + 24px。
    property <length> results-y: root.bar-y + root.bar-height + Theme.space-5;
    // 结果头行高与网格起点（内容区坐标）。
    property <length> header-height: Theme.row-title-size;
    property <length> grid-top: root.header-height + Theme.space-4;

    // ---- 探针（测试用：6 列 / 5:7 / 起点 = content-gutter）----
    out property <int> probe-columns: root.columns;
    out property <length> probe-card-w: grid.card-width;
    // 图高（5:7）与卡片总高（图高 + 卡下标题块）分开报，别混。
    out property <length> probe-poster-h: grid.poster-height;
    out property <length> probe-card-h: grid.card-height;
    out property <length> probe-row-h: grid.row-height;
    out property <length> probe-card-step: grid.card-step;
    out property <length> probe-gutter: grid.content-gutter;
    out property <length> probe-first-x: grid.first-card-x;

    // ---- 顶部大搜索框 ----
    Rectangle {
        x: Theme.content-gutter;
        y: root.bar-y;
        width: parent.width - Theme.content-gutter * 2;
        height: root.bar-height;
        background: transparent;

        // 下划线（Netflix 搜索页的输入框只有底边一条 1px 线）。
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: 1px;
            background: query.has-focus ? Theme.hairline-strong : Theme.hairline;
        }

        // 占位文案（TextInput 在 1.19 没有 placeholder 属性，与顶栏同做法）。
        Text {
            x: 0;
            y: 0;
            width: parent.width - clear-button.width - Theme.space-4;
            height: parent.height;
            text: "搜索影片、剧集…";
            color: Theme.text-faint;
            font-family: Theme.font-family;
            // 官方 Hawkins Text 的 1.5rem/500 档（原来是 22px）。
            font-size: Theme.text-h5-size;
            font-weight: Theme.text-h5-weight;
            vertical-alignment: center;
            visible: root.search-text == "";
        }

        query := TextInput {
            x: 0;
            y: 0;
            width: parent.width - clear-button.width - Theme.space-4;
            height: parent.height;
            text <=> root.search-text;
            color: Theme.text;
            font-family: Theme.font-family;
            // 官方 Hawkins Text 的 1.5rem/500 档（原来是 22px）。
            font-size: Theme.text-h5-size;
            font-weight: Theme.text-h5-weight;
            vertical-alignment: center;
            single-line: true;

            edited => {
                root.search-changed(root.search-text);
            }
            accepted => {
                root.search-submit();
                // 焦点还给全局键盘：方向键/Enter 才能在结果网格里用。
                query.clear-focus();
                root.search-blur();
            }
            key-pressed(event) => {
                // Esc：清空并回首页（不需要先进文本框再退聚焦）。
                if (event.text == Key.Escape) {
                    root.search-clear();
                    return accept;
                }
                return reject;
            }
        }

        // 清空按钮：有输入时出现。
        clear-button := Rectangle {
            visible: root.search-text != "";
            x: parent.width - self.width;
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-pill;
            background: clear-area.has-hover ? Theme.wash : transparent;
            animate background {
                // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                duration: Theme.motion-button;
                easing: cubic-bezier(0.32, 0.94, 0.6, 1);
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.press-wash;
                opacity: clear-area.pressed ? 1 : 0;
                animate opacity {
                    // 官方 Hawkins 令牌：Button-DurationPressed 0ms。
                    duration: Theme.motion-press;
                    easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: "×";
                color: Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-20;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            clear-area := TouchArea {
                clicked => {
                    root.search-clear();
                }
            }
        }
    }

    // ---- Loading：不转圈（零依赖），只给一行文案 ----
    if (root.data.state == 1) :
        Text {
            x: Theme.content-gutter;
            y: root.results-y;
            width: parent.width - Theme.content-gutter * 2;
            height: Theme.font-22;
            text: "搜索中…";
            color: Theme.text-muted;
            font-family: Theme.font-family;
            font-size: Theme.font-14;
            vertical-alignment: center;
        }

    // ---- 结果网格（Ready 态可见；其余状态隐藏，但组件始终存在，
    //      这样探针属性与焦点索引在四态之间不会失效）----
    // 不按 `state` 门控 `visible`：Slint 首次求值不播动画，网格若在数据到达前
    // 是隐藏的，入场淡入会被跳过。空/错误态面板在它之后绘制，会盖在上面；
    // 卡片列表为空时网格本身不画东西，所以常驻是安全的（`interactive` 关掉）。
    results := Flickable {
        x: 0;
        y: root.results-y;
        width: parent.width;
        height: parent.height - root.results-y;
        interactive: root.data.state == 2;
        content-width: self.width;
        content-height: content.height;

        content := Rectangle {
            width: parent.width;
            height: grid.content-height;

            // 结果头：「{term}」的搜索结果 + 共 N 部（非 Ready 态藏起来，
            // 别在空/错误态面板后面露出空的"共 0 部"）。
            HorizontalLayout {
                visible: root.data.state == 2;
                x: Theme.content-gutter;
                y: 0;
                width: parent.width - Theme.content-gutter * 2;
                height: root.header-height;
                spacing: Theme.space-4;

                Text {
                    text: root.data.title;
                    color: Theme.text;
                    font-family: Theme.font-family;
                    // 与首页行标题同一组断点 token（<960 20/500、960–1279 24/500、≥1280 32/700）。
                    font-size: Theme.row-title-size;
                    font-weight: Theme.row-title-weight;
                    vertical-alignment: center;
                }

                Text {
                    text: root.data.count-text;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                    vertical-alignment: center;
                }

                // 占满剩余宽度：标题与数量保持各自的自然宽度（与 media 库标题行同构）。
                Rectangle {
                    horizontal-stretch: 1;
                    height: 1px;
                    background: transparent;
                }
            }

            // 结果网格：与媒体库页共用 `PosterGrid`（唯一一套 5:7 网格几何）。
            grid := PosterGrid {
                x: 0;
                y: 0;
                width: parent.width;
                target-prefix: "search.";
                targets-visible: root.data.state == 2;
                nav-active: root.nav-active;
                columns: root.columns;
                grid-top: root.grid-top;
                // 放大覆盖层不许盖住结果头：上边界就是第一行卡片的顶边
                // （媒体库页是顶栏下沿，本页没有顶栏，改用结果头下沿）。
                overlay-clamp-top: root.grid-top;
                cards: root.data.cards;
                focus-index <=> root.focus-index;
                open(id) => {
                    root.open-item(id);
                }
            }
        }
    }

    // ---- Empty：没有命中 ----
    if (root.data.state == 3) :
        EmptyState {
            y: root.results-y;
            width: parent.width;
            height: parent.height - root.results-y;
            target-prefix: "search.";
            targets-visible: root.visible;
            title: "没有找到相关内容";
            message: "换个关键词试试";
        }

    // ---- Error：失败原因 + 重试 ----
    if (root.data.state == 4) :
        EmptyState {
            y: root.results-y;
            width: parent.width;
            height: parent.height - root.results-y;
            target-prefix: "search.";
            targets-visible: root.visible;
            title: "搜索失败";
            message: root.data.error;
            primary-label: "重试";
            primary => {
                root.search-retry();
            }
        }

    // ---- 顶栏 ----
    // Netflix 任何页面都有 header（logo / 导航 / 头像），搜索页也不例外。
    // 但顶栏的胶囊搜索框藏起来（`show-search: false`）——页内已经有一个更大的
    // 搜索框，两个输入框同屏会互相抢焦点。
    nav := Navbar {
        x: 0;
        y: 0;
        width: parent.width;
        height: Theme.navbar-height;
        tabs: root.data.tabs;
        current-index: root.data.current-tab;
        // 结果区滚动超过 40px 后顶栏变实底（与 `library.slint` 同一阈值）。
        scrolled: results.content-y < -40px;
        show-search: false;
        target-prefix: "search.";
        targets-visible: root.visible;
        search-focused: root.search-focused;
        search-text <=> root.search-text;
        tab-activated(id) => {
            root.tab-activated(id);
        }
        search => {
            root.search();
        }
        search-changed(text) => {
            root.search-changed(text);
        }
        search-submit => {
            root.search-submit();
        }
        search-clear => {
            root.search-clear();
        }
        search-escape => {
            root.search-escape();
        }
    }
}

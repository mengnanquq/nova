//! 详情页（Netflix 风格）：全宽 backdrop（78vh —— 实测 hero 845px / 视口 1080px = 0.782）+ 上下双向渐变、
//! 48px 标题、`·` 分隔的元信息、697px 简介、`▶ 播放` + `+ 我的列表`、
//! NETFLIX 风格的版本下拉（替换三行列表）。

import { Theme } from "theme.slint";
import { DetailData, Target, TargetBus } from "models.slint";
import { FocusRing } from "focus_ring.slint";

export component DetailPage inherits Rectangle {
    in property <DetailData> data;
    in-out property <int> focus-index: 0;

    callback back();
    callback play();
    callback source-selected(string);
    // 「+ 我的列表 / 已在列表」：切换本地列表状态（持久化在 Rust 侧）。
    callback my-list-toggle();

    // ---- 调试通道：可交互目标（见 docs/ui-architecture.md）----
    // 返回 / 播放 / 我的列表 / 版本下拉是页面直接摆放的常驻控件 → 声明式列出；
    // 展开后的版本行是条件子树里的重复元素 → 各自登记到 `TargetBus`。
    out property <[Target]> targets: [
        {
            id: "detail.back",
            kind: "button",
            label: "返回",
            x: back-area.absolute-position.x,
            y: back-area.absolute-position.y,
            width: back-area.width,
            height: back-area.height,
        },
        {
            id: "detail.play",
            kind: "button",
            label: root.data.play-label,
            x: play-area.absolute-position.x,
            y: play-area.absolute-position.y,
            width: play-area.width,
            height: play-area.height,
        },
        {
            id: "detail.my-list",
            kind: "toggle",
            label: root.in-my-list ? "已在列表" : "+  我的列表",
            x: list-area.absolute-position.x,
            y: list-area.absolute-position.y,
            width: list-area.width,
            height: list-area.height,
        },
        {
            id: "detail.drop",
            kind: "toggle",
            label: "播放版本：" + root.data.selected-source-label,
            x: drop-area.absolute-position.x,
            y: drop-area.absolute-position.y,
            width: drop-area.width,
            height: drop-area.height,
        },
    ];

    for target in root.targets : Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        property <int> target-gen: TargetBus.gen;
        changed target-gen => {
            if (root.visible) {
                TargetBus.register(target);
            }
        }
    }

    // 详情页底色：实测 rgb(15,15,15)，与其它页的纯黑不同。
    background: Theme.detail-bg;

    // "我的列表"是纯视觉态：点击切换，不落数据。
    // 是否已在「我的列表」：由 Rust 侧根据本地数据库决定（`DetailView.in_my_list`），
    // 界面只负责显示与发回调。以前这里是纯局部 bool，重开详情就归零。
    in property <bool> in-my-list: false;
    in-out property <bool> drop-open: false;

    property <length> backdrop-height: self.height * Theme.detail-backdrop-ratio;
    // ---- 入场（数据 / 页面到达）----
    // 标题块从 +8px 归位 + 淡入，backdrop 同时淡入：共用一条进度 `reveal`（0 → 1）。
    // 用自定义 float 而不是直接 `animate opacity`：opacity 默认 1，未被求值过的元素上
    // 动画会从 1 到 1（等于没动画）；float 默认 0 = 隐藏态（详见 home.slint CardRow 注释）。
    property <float> reveal: root.data.title != "" ? 1 : 0;
    animate reveal {
        duration: Theme.motion-slow;
        easing: ease-out;
    }

    // ---- 探针（测试用：内容块几何，见 `tests/detail_layout.rs`）----
    // 坐标系与 `content` 一致（无头测试里 Flickable 未滚动，即窗口坐标）。
    out property <length> probe-body-y: body.y;
    out property <length> probe-body-height: body.height;
    out property <length> probe-backdrop-height: root.backdrop-height;
    // 各区块的绝对上下沿：body 无 padding，子项 `y` 相对 body。
    out property <length> probe-title-top: body.y + title-wrap.y;
    out property <length> probe-title-bottom: body.y + title-wrap.y + title-wrap.height;
    out property <length> probe-overview-top: body.y + overview-wrap.y;
    out property <length> probe-overview-bottom: body.y + overview-wrap.y + overview-wrap.height;
    out property <length> probe-buttons-top: body.y + button-row.y;
    out property <length> probe-buttons-bottom: body.y + button-row.y + button-row.height;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        interactive: true;
        content-width: self.width;
        content-height: content.height;

        content := Rectangle {
            width: parent.width;
            // 页面总高 = max(可视高度, 内容块下缘 + 底部留白)。
            // 内容块叠在 hero 下半部，所以当内容块 + 112px 仍短于窗口时以窗口为主；
            // 内容块比 hero 高时（长简介 / 无 backdrop）body.y 会被兜底到 0，
            // 此时 content 由 body 下缘撑开，可滚动。
            // 底部留白官方未测，沿用现有 `Theme.space-8`（本仓库是 48px）。
            height: max(parent.height, body.y + body.height + Theme.space-8);

            // ---- Backdrop（78vh）----
            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.backdrop-height;
                source: root.data.backdrop;
                image-fit: cover;
                visible: root.data.backdrop.width > 0;
                // backdrop 到达时淡入（跟随页面级 `reveal`）。
                opacity: root.reveal;
            }

            // 无 backdrop 时的底板：只用一层极暗渐变，**不画首字母**。
            //
            // 之前在这里画了条目首字母，实测详情页在没有背景图时会正中冒出一个巨大的
            // `#`（真实条目「#家」），看着像渲染坏了。详情页已经有标题了，不需要再暗示。
            if (root.data.backdrop.width <= 0) :
                Rectangle {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: root.backdrop-height;
                    background: @linear-gradient(180deg, Theme.surface 0%, Theme.detail-bg 100%);
                }

            // 底部压暗渐变。实测 CSS 是作用在**整个 hero** 上的
            // `linear-gradient(rgba(0,0,0,0) 40%, …, rgba(0,0,0,.6) 100%)`：
            // 变暗从 hero 的 40% 处开始、到底部达到 0.6 不透明度。
            // Slint 里等价写法是「只盖 hero 下半段 60%，渐变从 0% 走到 100%」——
            // 若沿用 40%→100% 的 stops，变暗起点会被推迟到 hero 的 76%，画面明显不对。
            Rectangle {
                x: 0;
                y: root.backdrop-height * 0.4;
                width: parent.width;
                height: root.backdrop-height * 0.6;
                background: @linear-gradient(180deg, #00000000 0%, #00000099 100%);
            }

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: root.backdrop-height * 0.15;
                background: @linear-gradient(180deg, Theme.scrim-soft 0%, #00000000 100%);
                visible: root.data.backdrop.width > 0;
            }

            // ---- 内容列（单一纵向布局，叠在 hero 下半部）----
            //
            // 不可破坏的不变量：**这里的每个子项都不写 `y`**，先后顺序 + `spacing`
            // 就是唯一的位置来源。
            // 踩过的坑：标题块与简介块曾经各自绑 y（标题块 `alignment: end` 贴在 backdrop 下缘、
            // 简介块 `y = backdrop-height + space-5`），两块互不知情；那样只把简介块上移，
            // 标题块纹丝不动地“留在原地”——重叠的是标题压住简介。合并成一个布局后，
            // 任何一块的高度变化都会把它下面的块推开，不可能再重叠，
            // 回归断言见 `crates/nova-ui/tests/detail_layout.rs`。
            body := VerticalLayout {
                x: Theme.content-gutter;
                width: parent.width - Theme.content-gutter * 2;
                // 内容块**底端**锚定（Netflix 实测距 hero 下缘 112px，见 `Theme.detail-body-bottom-gap`）：
                // 高度由内容撑开，所以 y 由自身高度反推。
                //
                // 下界不是 0 而是 `Theme.navbar-height`：小窗口（800×600）下
                // 底端锚定会算出 0（实测 800×600 长简介条目 body_y = 0），
                // 标题贴到窗口顶端、与浮在上面的返回按钮（y=16..52）重叠。
                // 顶栏高度是各页一致的"顶部安全区"，内容不得入侵；
                // 被顶下来后内容总高仍由 `content.height` 撑开（可滚动），不丢内容。
                //
                // 末尾的 `motion-rise-hero * (1 - reveal)` 是入场 +8px 上浮归位；
                // reveal 结算到 1 后该项为 0，不影响上面这条底端锚定等式。
                //
                // `height` 必须显式写成 `self.preferred-height`：布局元素的默认高度是
                // **父元素的 100%**（不是内容高），留着默认值会让 `content.height` →
                // `body.height` → `body.y` → `content.height` 成环（编译期 binding loop），
                // 并且多出来的高度会被两个可拉伸的 `Text` 子项吃掉（实测各撑到 269px）。
                height: self.preferred-height;
                y: max(Theme.navbar-height, root.backdrop-height
                    - Theme.detail-body-bottom-gap - self.height)
                    + Theme.motion-rise-hero * (1 - root.reveal);
                spacing: Theme.space-4;
                // 子项按顺序从顶端排（高度 = 内容高，余量为 0；写死只是为了不让未来
                // 的 min-height 改动把内容居中/居底）。
                alignment: start;
                opacity: root.reveal;

                // 标题：48px bold（Netflix 实测）。Text 直接放进布局时，无头渲染器
                // 会按极窄宽度算 preferred-height（一行字撑成几十行），所以外面套一层
                // 定宽 Rectangle，用 Text 自己的 preferred-height 撑开（长标题换行不裁切）。
                title-wrap := Rectangle {
                    height: title-text.preferred-height;
                    background: transparent;

                    title-text := Text {
                        width: parent.width;
                        text: root.data.title;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-48;
                        // 官方 hero h1 字重是 Hawkins `Text` 的最大档 900。
                        font-weight: Theme.weight-black;
                        min-height: 56px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        visible: root.data.title != "";
                    }
                }

                Text {
                    text: root.data.original-title;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    min-height: 20px;
                    overflow: elide;
                    wrap: no-wrap;
                    visible: root.data.original-title != "";
                }

                // 元信息：实测 14px / 字重 500。
                // 注意：`·` 分隔与项间距 30px 都在数据层（`detail_meta_line`）拼好的
                // 单串里，Slint 侧无法逐字符上色 / 逐项调间距（见 docs/ui-netflix-1to1.md 第 7 节）。
                Text {
                    text: root.data.meta-line;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    font-weight: Theme.weight-medium;
                    min-height: 20px;
                    overflow: elide;
                    wrap: no-wrap;
                    visible: root.data.meta-line != "";
                }

                // 简介：实测宽 697px、16px / 行高 24px、不限行数（Slint 无 line-height，
                // 行距用字体默认；高度由文字行数自适应，不再 90px 截断 + elide）。
                overview-wrap := Rectangle {
                    width: 697px;
                    height: overview-text.preferred-height;
                    background: transparent;

                    overview-text := Text {
                        width: parent.width;
                        text: root.data.overview;
                        color: Theme.text;
                        font-family: Theme.font-family;
                        font-size: Theme.font-16;
                        wrap: word-wrap;
                        visible: root.data.overview != "";
                    }
                }

                button-row := HorizontalLayout {
                    spacing: Theme.space-3;

                    // ▶ 播放：白底黑字。
                    Rectangle {
                        width: root.data.play-label == "播放" ? Theme.play-button-width
                            : play-label.preferred-width + Theme.space-5;
                        height: Theme.button-primary-height;
                        // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                        border-radius: Theme.radius-button;
                        background: Theme.btn-primary-bg;

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.wash;
                            opacity: play-area.has-hover ? 1 : 0;
                            animate opacity {
                                // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                                duration: Theme.motion-button;
                                easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                            }
                        }

                        // 按压反馈（scale 0.98 的近似，见 Theme.press-wash）。
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.press-wash;
                            opacity: play-area.pressed ? 1 : 0;
                            animate opacity {
                                // 官方 Hawkins 令牌：Button-DurationPressed 0ms。
                                duration: Theme.motion-press;
                                easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                            }
                        }

                        play-label := Text {
                            x: Theme.space-4;
                            height: parent.height;
                            text: "▶  " + root.data.play-label;
                            color: Theme.btn-primary-fg;
                            font-family: Theme.font-family;
                            font-size: Theme.font-14;
                            font-weight: Theme.weight-semibold;
                            vertical-alignment: center;
                        }

                        play-area := TouchArea {
                            clicked => {
                                root.focus-index = 0;
                                root.play();
                            }
                        }

                        FocusRing {
                            x: -Theme.focus-offset;
                            y: -Theme.focus-offset;
                            width: parent.width + Theme.focus-offset * 2;
                            height: parent.height + Theme.focus-offset * 2;
                            active: root.focus-index == 0;
                            ring-radius: Theme.radius-button + Theme.focus-offset;
                        }
                    }

                    // + 我的列表：次要按钮，点击只做视觉态。
                    Rectangle {
                        width: Theme.info-button-width;
                        height: Theme.button-primary-height;
                        // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                        border-radius: Theme.radius-button;
                        background: Theme.btn-secondary-bg;

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.wash;
                            opacity: list-area.has-hover ? 1 : 0;
                            animate opacity {
                                duration: Theme.motion-button;
                                easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                            }
                        }

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.press-wash;
                            opacity: list-area.pressed ? 1 : 0;
                            animate opacity {
                                duration: Theme.motion-press;
                                easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                            }
                        }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.in-my-list ? "已在列表" : "+  我的列表";
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-14;
                            font-weight: Theme.weight-medium;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        list-area := TouchArea {
                            clicked => {
                                root.my-list-toggle();
                            }
                        }
                    }
                }

                // 版本下拉：一行 NETFLIX 风格入口 + 展开面板。
                VerticalLayout {
                    width: parent.width > 640px ? 640px : parent.width;
                    spacing: Theme.space-2;

                    Rectangle {
                        width: drop-label.preferred-width + Theme.space-5;
                        height: 40px;
                        // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                        border-radius: Theme.radius-button;
                        background: drop-area.has-hover
                            ? Theme.surface-raised : Theme.btn-secondary-bg;

                        drop-label := Text {
                            x: Theme.space-3;
                            height: parent.height;
                            text: "播放版本：" + root.data.selected-source-label + "  ▼";
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-14;
                            vertical-alignment: center;
                        }

                        drop-area := TouchArea {
                            clicked => {
                                root.drop-open = !root.drop-open;
                            }
                        }
                    }

                    if (root.drop-open) :
                        VerticalLayout {
                            spacing: 0;

                            for source[i] in root.data.sources : Rectangle {
                                width: 100%;
                                height: 48px;
                                background: source-row.has-hover
                                    ? Theme.surface-raised : Theme.surface;

                                // 选中态：左侧 3px accent 竖条。
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 3px;
                                    height: parent.height;
                                    background: source.selected ? Theme.accent : transparent;
                                }

                                VerticalLayout {
                                    x: Theme.space-4;
                                    y: Theme.space-1;
                                    width: parent.width - Theme.space-4 * 2;
                                    height: parent.height - Theme.space-1 * 2;
                                    spacing: 2px;

                                    Text {
                                        text: source.title;
                                        color: source.selected ? Theme.text : Theme.text-muted;
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-14;
                                        font-weight: source.selected
                                            ? Theme.weight-semibold : Theme.weight-regular;
                                        overflow: elide;
                                        wrap: no-wrap;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: source.subtitle;
                                        color: Theme.text-faint;
                                        font-family: Theme.font-family;
                                        font-size: Theme.font-12;
                                        overflow: elide;
                                        wrap: no-wrap;
                                        visible: source.subtitle != "";
                                        vertical-alignment: center;
                                    }
                                }

                                source-row := TouchArea {
                                    clicked => {
                                        root.focus-index = i + 1;
                                        root.drop-open = false;
                                        root.source-selected(source.id);
                                    }
                                }

                                // 版本行只在展开时实例化，自己登记目标。
                                property <int> target-gen: TargetBus.gen;
                                changed target-gen => {
                                    if (root.visible) {
                                        TargetBus.register({
                                            id: "detail.source." + i,
                                            kind: "button",
                                            label: source.title,
                                            x: source-row.absolute-position.x,
                                            y: source-row.absolute-position.y,
                                            width: source-row.width,
                                            height: source-row.height,
                                        });
                                    }
                                }

                                FocusRing {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    active: root.focus-index == i + 1;
                                    ring-radius: 0px;
                                }
                            }
                        }
                }
            }

            // 返回按钮（左上）。位置固定，**绘制顺序在 body 之后**，所以即使内容块
            // 很高（body.y 兜底到 0）也不会遮住它；反过来它会压在内容上——与 Netflix 一致
            // （官方也是返回钮浮在 hero 之上）。
            Rectangle {
                x: Theme.content-gutter;
                y: Theme.space-4;
                width: back-label.preferred-width + Theme.space-5;
                height: 36px;
                // 官方 Hawkins `Button-BorderRadius: 0.25rem` = 4px。
                border-radius: Theme.radius-button;
                background: back-area.has-hover ? Theme.btn-secondary-bg : Theme.btn-secondary-bg;

                back-label := Text {
                    x: Theme.space-3;
                    height: parent.height;
                    text: "←  返回";
                    color: Theme.text;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    vertical-alignment: center;
                }

                back-area := TouchArea {
                    clicked => {
                        root.back();
                    }
                }
            }
        }
    }
}

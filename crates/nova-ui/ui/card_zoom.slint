//! 放大覆盖层卡片：行/网格里被聚焦或悬停的卡片按 zoom-factor（1.35）放大并上移
//! 12px，底部展开 56px 的 `#181818` 信息面板（标题 14px bold / 元信息 12px
//! `#B3B3B3` / 3px 红进度条）。
//!
//! 它是**独立覆盖层**，不参与行布局：行内基础卡片尺寸恒定，放大只改这张
//! 后绘制的覆盖卡（后绘制的兄弟元素优先，能盖住相邻卡片），所以布局零跳动。
//! 放大动画（400ms 延迟 + 200ms ease-out）由父级的 zoom-factor 状态动画驱动。

import { Theme } from "theme.slint";
import { CardData } from "models.slint";

export component CardZoom inherits Rectangle {
    in property <CardData> card;
    // 基础卡尺寸（放大前的行内尺寸）。
    in property <length> base-width: 260px;
    in property <length> base-height: 390px;
    // 缩放系数：1.0（未放大）→ 1.35。由父级的状态动画驱动。
    in property <float> zoom-factor: 1.0;
    callback clicked();
    // 覆盖层是否正被悬停（放大完成后才接管，供父级锁存行激活态）。
    out property <bool> hovered: zoom-area.has-hover;

    width: root.base-width * root.zoom-factor;
    height: image-height + Theme.zoom-info-height;
    background: transparent;

    property <length> image-height: root.base-height * root.zoom-factor;
    // 圆角 4 → 6 随放大走。
    property <length> image-radius: root.zoom-factor > 1.04 ? Theme.radius-panel : Theme.radius-poster;

    image := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: image-height;
        clip: true;
        border-radius: image-radius;
        background: Theme.surface;

        // 占位底色 + 首字母（图片为空时才可见）。
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.card.image.width > 0 ? transparent : Theme.surface-raised;
            border-radius: image-radius;

            Text {
                text: root.card.initial;
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-34;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: root.card.image.width <= 0;
            }
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: root.card.image;
            image-fit: cover;
        }
    }

    // 放大卡底部信息面板：56px、#181818。
    panel := Rectangle {
        x: 0;
        y: image-height;
        width: parent.width;
        height: Theme.zoom-info-height;
        border-radius: Theme.radius-panel;
        background: Theme.zoom-panel-bg;

        // 标题：14px bold。
        panel-title := Text {
            x: Theme.space-3;
            y: Theme.space-2;
            width: parent.width - Theme.space-3 * 2;
            height: 18px;
            text: root.card.title;
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.font-14;
            font-weight: Theme.weight-bold;
            overflow: elide;
            wrap: no-wrap;
        }

        // 元信息：12px #B3B3B3。
        panel-meta := Text {
            x: Theme.space-3;
            y: panel-title.y + panel-title.height;
            width: parent.width - Theme.space-3 * 2;
            height: 16px;
            text: root.card.subtitle;
            color: Theme.text-muted;
            font-family: Theme.font-family;
            font-size: Theme.font-12;
            overflow: elide;
            wrap: no-wrap;
            visible: root.card.subtitle != "";
        }

        // 迷你进度条：3px 红条，距面板底 6px，左右各 6px。
        if (root.card.progress >= 0) :
            Rectangle {
                x: Theme.space-2 + 2px;
                y: parent.height - self.height - 6px;
                width: parent.width - (Theme.space-2 + 2px) * 2;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.player-track;

                Rectangle {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    width: parent.width * clamp(root.card.progress, 0, 1);
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
            }
    }

    // 覆盖层的点击/悬停接管分两阶段：放大未完成时禁用（点击与悬停都穿透
    // 给下面的基础卡，避免覆盖层一出现就抢走悬停导致抖动）；放大完成后启用，
    // 指针在放大后的加宽区域里也能维持行激活。
    zoom-area := TouchArea {
        enabled: root.zoom-factor > 1.3;
        clicked => {
            root.clicked();
        }
    }
}

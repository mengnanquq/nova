//! 放大覆盖层：把行/网格里被聚焦或悬停的卡片按 `zoom-factor`（官方 **1.05**）放大。
//!
//! 官方结构（`/tmp/genre_inline.css`）：`li` = 海报 + 一行卡下标题，悬停
//! `transform:scale(1.05); transition:transform .2s ease-in-out; z-index:2`，
//! **没有**任何悬停信息面板。所以这里只画"同一张卡放大 1.05"：
//! 海报 + HDR/4K 角标 + 进度条 + 卡下标题（直接复用 `PosterCard`，避免两份绘制）。
//!
//! 它是**独立覆盖层**，不参与行/网格布局：基础卡片尺寸恒定，放大只改这张后绘制的
//! 覆盖卡（后绘制的兄弟元素优先，能盖住相邻卡片），所以布局零跳动。
//! 覆盖卡比基础卡每边只多 `zoom-allowance/2`（横向 6px、竖向 ≤10px），而行距 / 卡
//! 间距都是 12px —— 这是"放大卡绝不盖住行标题"的几何依据（见 `theme.slint`）。
//! 放大动画（400ms 延迟 + 200ms ease-in-out）由父级的 zoom-factor 状态动画驱动。

import { Theme } from "theme.slint";
import { CardData } from "models.slint";
import { PosterCard } from "poster_card.slint";

export component CardZoom inherits Rectangle {
    in property <CardData> card;
    // 基础卡尺寸（放大前）：图区宽 / 图高。
    in property <length> base-width: 260px;
    in property <length> base-image-height: 390px;
    // 缩放系数：1.0（未放大）→ `Theme.zoom-factor`（1.05）。由父级的状态动画驱动。
    in property <float> zoom-factor: 1.0;
    callback clicked();
    // 覆盖层是否正被悬停（放大完成后才接管，供父级锁存行激活态）。
    out property <bool> hovered: face.hovered;

    // 整张卡（海报 + 卡下标题）等比放大：与官方 `scale(1.05)` 的观感一致。
    width: root.base-width * root.zoom-factor;
    height: (root.base-image-height + Theme.card-caption-height) * root.zoom-factor;
    // 不透明底：覆盖卡比基础卡大一圈（1.05 → 每边 2.5%），底色必须盖住下面那张
    // 基础卡（含它的卡下标题），否则会看到两份标题叠在一起。
    background: Theme.bg;

    face := PosterCard {
        card: root.card;
        card-width: root.base-width;
        image-height: root.base-image-height;
        scale: root.zoom-factor;
        // 点击/悬停接管分两阶段：放大没走完之前禁用（点击与悬停都穿透给下面的
        // 基础卡，避免"覆盖层一出现就抢走悬停"导致的抖动）；走到 80% 之后启用，
        // 指针在放大后的加宽区域里也能维持行激活。
        interactive: root.zoom-factor > 1 + (Theme.zoom-factor - 1) * 0.8;
        clicked => {
            root.clicked();
        }
    }
}

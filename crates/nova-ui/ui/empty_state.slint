//! 空状态：与错误卡同一套面板样式（surface + hairline + 10 圆角）+ 语义图标 + 主/次按钮。
//!
//! 图标是胶片（Path 画的语义形状），不依赖字体里有没有某个字形。

import { Theme } from "theme.slint";

export component EmptyState inherits Rectangle {
    in property <string> title: "这里还没有内容";
    in property <string> message: "";
    in property <string> primary-label: "";
    in property <string> secondary-label: "";
    callback primary();
    callback secondary();

    background: transparent;

    // ---- 入场：**没做**（如实记录）----
    //
    // 原计划的"opacity 0 → 1 + 上浮 6px"在 Slint 里做不到：空态是
    // **元素被创建/从隐藏变可见的那一刻**出现的，而 Slint 对"属性第一次求值"
    // 不播动画（`animate` 只在后续变化时过渡；已用无头测试实测：init 里置位、
    // 或从 `visible: false` 变 true 的第一帧，都是直接到终值）。
    // 补这一下就需要定时器/每帧轮询（任务硬约束禁止），所以这里保持即时显示。
    // 另外 `scale 0.98 → 1` 也做不到：Slint 1.19 的 `Transform` 是 internal 元素。

    // 面板：直接按中心定位（不靠 layout 的 alignment 做外层居中）。
    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width - Theme.gutter * 2, 560px);
        height: body.preferred-height + Theme.space-6 * 2;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.hairline;
        border-radius: Theme.radius-panel;

        body := VerticalLayout {
            x: Theme.space-6;
            y: Theme.space-6;
            width: parent.width - Theme.space-6 * 2;
            height: self.preferred-height;
            alignment: center;
            spacing: Theme.space-3;

            // 图标底座：圆形 surface-raised + 胶片。
            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 64px;
                    height: 64px;
                    border-radius: Theme.radius-pill;
                    background: Theme.surface-raised;
                    border-width: 1px;
                    border-color: Theme.hairline;

                    Path {
                        x: (parent.width - 40px) / 2;
                        y: (parent.height - 28px) / 2;
                        width: 40px;
                        height: 28px;
                        stroke: Theme.text-faint;
                        stroke-width: 2px;
                        fill: transparent;
                        // 胶片：外框 + 两侧齿孔带 + 三格画面分隔。
                        commands: "M 0 0 L 40 0 L 40 28 L 0 28 Z M 7 0 L 7 28 M 33 0 L 33 28 M 7 7 L 33 7 M 7 14 L 33 14 M 7 21 L 33 21";
                    }
                }
            }

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-family: Theme.font-family;
                    font-size: Theme.font-22;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.message;
                    color: Theme.text-muted;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    visible: root.message != "";
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: Theme.space-3;

                    // 主按钮：连接服务器（唯一带 accent 的动作）。
                    Rectangle {
                        height: Theme.button-primary-height;
                        width: primary-label.preferred-width + Theme.space-6 * 2;
                        border-radius: Theme.radius-pill;
                        // 官方 Hawkins 令牌：Button-Surface / Hovered / Pressed。
                        background: primary-area.pressed ? Theme.accent-pressed
                            : (primary-area.has-hover ? Theme.accent-hover : Theme.accent);
                        visible: root.primary-label != "";
                        animate background {
                            // Button-Duration 250ms / Button-DurationPressed 0ms；
                            // Button-EasingHovered / Button-Easing 照抄官方贝塞尔。
                            duration: primary-area.pressed ? Theme.motion-press : Theme.motion-button;
                            easing: primary-area.has-hover
                                ? cubic-bezier(0.32, 0.94, 0.6, 1) : cubic-bezier(0.4, 0, 0.68, 0.06);
                        }

                        primary-label := Text {
                            x: Theme.space-6;
                            width: parent.width - Theme.space-6 * 2;
                            height: parent.height;
                            text: root.primary-label;
                            color: Theme.accent-contrast;
                            font-family: Theme.font-family;
                            font-size: Theme.font-14;
                            font-weight: Theme.weight-semibold;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        primary-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.primary();
                            }
                        }
                    }

                    // 次级动作：中性底 + hairline。
                    Rectangle {
                        height: Theme.button-primary-height;
                        width: secondary-label.preferred-width + Theme.space-6 * 2;
                        border-radius: Theme.radius-pill;
                        background: secondary-area.has-hover ? Theme.surface-raised : Theme.surface;
                        border-width: 1px;
                        border-color: Theme.hairline;
                        visible: root.secondary-label != "";
                        animate background {
                            // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
                            duration: Theme.motion-button;
                            easing: cubic-bezier(0.32, 0.94, 0.6, 1);
                        }

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            border-radius: parent.border-radius;
                            background: Theme.press-wash;
                            opacity: secondary-area.pressed ? 1 : 0;
                            animate opacity {
                                duration: Theme.motion-press;
                                easing: cubic-bezier(0.4, 0, 0.68, 0.06);
                            }
                        }

                        secondary-label := Text {
                            x: Theme.space-6;
                            width: parent.width - Theme.space-6 * 2;
                            height: parent.height;
                            text: root.secondary-label;
                            color: Theme.text;
                            font-family: Theme.font-family;
                            font-size: Theme.font-14;
                            font-weight: Theme.weight-medium;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        secondary-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.secondary();
                            }
                        }
                    }
                }
            }
        }
    }

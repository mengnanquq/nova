//! 播放控制层。
//!
//! 尺寸 / 颜色 / 时长全部来自 `theme.slint` 的播放器 token 组，而那一组是照
//! `/tmp/live_akira.css`（Netflix 会员端 CSS）的 em 值写的：
//! `Theme.player-unit × 官方 em 值`（基数 16px 由我们选定，见 docs/ui-netflix-1to1.md §11）。
//!
//! 布局自下而上：底部渐变（标题 → 进度条 → 传输控件）、顶部渐变 + 左上返回、
//! 中央暂停图标、缓冲角标、错误卡、音轨 / 字幕弹出层。
//!
//! 这里**只**做摆放与指针/键位分派：进度、菜单开合、自动隐藏计时都在
//! `viewmodel::PlayerView` 里（`PlayerData.controls-visible` 决定显隐）。
//! `Timer` 只是把真实窗口的时间增量喂回视图模型（见 `pages::player::TICK_INTERVAL`）。

import { Theme } from "theme.slint";
import { PlayerData, TrackData } from "models.slint";

// 播放三角。官方 `.watch-video .svg-icon.svg-icon-nfplayerPlay{width:1.05555556em;height:1.22222222em}`。
// `Path` 会按 width/height 等比缩放（`fit` 默认 contain），所以外框给官方比例即可。
component PlayGlyph inherits Path {
    in property <color> tint: Theme.text;
    width: Theme.player-unit * Theme.player-icon-play-w;
    height: Theme.player-unit * Theme.player-icon-play-h;
    commands: "M 0 0 L 16 9 L 0 18 Z";
    fill: root.tint;
}

// 暂停双竖条。官方与 play 同一组尺寸（`.svg-icon-nfplayerPause{1.05555556em × 1.22222222em}`）。
component PauseGlyph inherits Path {
    in property <color> tint: Theme.text;
    width: Theme.player-unit * Theme.player-icon-play-w;
    height: Theme.player-unit * Theme.player-icon-play-h;
    commands: "M 0 0 L 6 0 L 6 20 L 0 20 Z M 12 0 L 18 0 L 18 20 L 12 20 Z";
    fill: root.tint;
}

// 喇叭图标：壳体填充 + 波纹 / 静音斜线描边。用 Path 画，不依赖字体里的字形。
// 官方 `.svg-icon-volumeLow/Medium/Max/Muted{width:1.33333333em;height:1.11111111em}`；
// 内部图形沿用原来的 20×18 归一化坐标，等比缩进官方盒子里居中。
component VolumeGlyph inherits Rectangle {
    in property <bool> muted: false;
    in property <color> tint: Theme.text;

    property <length> box-w: Theme.player-unit * Theme.player-icon-volume-w;
    property <length> box-h: Theme.player-unit * Theme.player-icon-volume-h;
    property <length> u: min(root.box-w / 20, root.box-h / 18);
    property <length> ox: (root.box-w - 20 * root.u) / 2;
    property <length> oy: (root.box-h - 18 * root.u) / 2;

    width: root.box-w;
    height: root.box-h;
    background: transparent;

    // 喇叭壳体（20×18 归一后的 bbox 9×18）。
    Path {
        x: root.ox;
        y: root.oy;
        width: 9 * root.u;
        height: 18 * root.u;
        fill: root.tint;
        commands: "M 0 6 L 4 6 L 9 0 L 9 18 L 4 12 L 0 12 Z";
    }

    // 有声：一道向外扩散的弧（bbox 5×10）。
    Path {
        x: root.ox + 10 * root.u;
        y: root.oy + 3 * root.u;
        width: 5 * root.u;
        height: 10 * root.u;
        stroke: root.tint;
        stroke-width: 2 * root.u;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 0 1 Q 5 6 0 11";
        visible: !root.muted;
    }

    // 静音：一道斜线（bbox 8×12）。
    Path {
        x: root.ox + 10 * root.u;
        y: root.oy + 2 * root.u;
        width: 8 * root.u;
        height: 12 * root.u;
        stroke: root.tint;
        stroke-width: 2 * root.u;
        stroke-line-cap: round;
        fill: transparent;
        commands: "M 0 0 L 8 12";
        visible: root.muted;
    }
}

// 返回箭头（左上）。官方 `.player-exit{width:1.4em;height:1.4em;opacity:.5}` 是个小图标钮；
// 官方 SVG 的路径不在 CSS 里，这个箭头图形是我们自己画的（描边，末端圆头）。
component BackGlyph inherits Path {
    in property <color> tint: Theme.text;
    width: Theme.player-back-size;
    height: Theme.player-back-size;
    stroke: root.tint;
    stroke-width: Theme.player-back-size / 14 * 1.8;
    stroke-line-cap: round;
    stroke-line-join: round;
    fill: transparent;
    commands: "M 13 7 L 1.5 7 M 6.5 2 L 1.5 7 L 6.5 12";
}

// 音量控件：喇叭图标 + 悬停时向右展开的水平滑杆。
//
// 官方原文（`/tmp/live_akira.css`）：
//   `.nfp .volume-controller .scrubber-target{height:1em;width:1em;transform:scale(1);transition:transform .2s ease}`
//   `.nfp .volume-controller .scrubber-target:hover{transform:scale(1.2)}`
//   `.nfp .volume-controller .scrubber-head{background:#e50914;border-radius:50%;height:100%;width:100%}`
//   `.nfp .volume-controller .slider-bar-container{background:#5b5b5b;width:.4em}`
//   `.nfp .volume-controller .slider-bar-percentage{background:#e50914}`
// 官方那套是**垂直** popup（`.slider-container{width:1.5em;height:8em}`）；我们按任务书做水平内联展开，
// 滑杆总宽 6em 是自定（官方没给）。颜色直接用进度条同一套 token：轨道 `#5B5B5B` / 已填充 `#E50914`。
component VolumeControl inherits Rectangle {
    in property <float> volume: 0;
    in property <bool> muted: false;
    callback mute-toggle();
    callback volume-set(float);

    property <bool> dragging: false;
    // 展开状态：鼠标进来 / 拖滑杆中（键盘焦点本应用同样展开，但播放页没有逐控件焦点，见 §11.6）。
    property <bool> hot: area.has-hover || root.dragging;
    property <length> track-inset: Theme.space-2;
    // 已填充 / 手柄的归一位置。
    property <float> ratio: clamp(root.volume, 0, 1);
    property <length> slider-left: Theme.player-control-size + root.track-inset;
    property <length> slider-travel: max(root.width - Theme.player-control-size - root.track-inset * 2, 1px);

    width: root.hot ? Theme.player-control-size + Theme.player-volume-slider-width + Theme.space-2
        : Theme.player-control-size;
    height: Theme.player-control-size;
    background: transparent;
    // 展开 / 收起：`Theme.motion` + ease-out，不用定时器。
    animate width {
        duration: Theme.motion;
        easing: ease-out;
    }

    // 喇叭（点击 = 静音 / 取消静音）。
    Rectangle {
        x: 0;
        y: 0;
        width: Theme.player-control-size;
        height: parent.height;
        border-radius: Theme.radius-pill;
        background: root.hot ? Theme.player-control-hover : transparent;
        animate background {
            duration: Theme.motion-button;
            easing: cubic-bezier(0.32, 0.94, 0.6, 1);
        }

        VolumeGlyph {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            muted: root.muted;
            tint: root.muted ? Theme.text-muted : Theme.text;
        }
    }

    // 滑杆（收起时 `opacity:0` 且不参与命中测试）。
    Rectangle {
        x: Theme.player-control-size;
        y: 0;
        width: parent.width - Theme.player-control-size;
        height: parent.height;
        background: transparent;
        opacity: root.hot ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity {
            duration: Theme.motion;
            easing: ease-out;
        }

        // 轨道：官方 `.slider-bar-container{background:#5b5b5b}`
        Rectangle {
            x: root.track-inset;
            y: (parent.height - self.height) / 2;
            width: parent.width - root.track-inset * 2;
            height: Theme.player-volume-bar;
            background: Theme.player-track;
        }

        // 已填充：官方 `.slider-bar-percentage{background:#e50914}`
        Rectangle {
            x: root.track-inset;
            y: (parent.height - self.height) / 2;
            width: root.slider-travel * root.ratio;
            height: Theme.player-volume-bar;
            background: Theme.player-progress;
        }

        // 手柄：官方 `scrubber-target` 1em，hover 放大 1.2（拖动中也算 hot）。
        Rectangle {
            x: root.track-inset + root.slider-travel * root.ratio - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: Theme.player-volume-knob * (root.hot ? Theme.player-bar-knob-scale : 1);
            height: self.width;
            border-radius: Theme.radius-pill;
            background: Theme.player-progress;
        }
    }

    // 整个控件一个命中区：左半（图标）点击 = 静音，右侧（滑杆）按下 / 拖动 = 设置音量。
    area := TouchArea {
        mouse-cursor: pointer;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (self.mouse-x > Theme.player-control-size) {
                    root.dragging = true;
                    root.volume-set(clamp((self.mouse-x - root.slider-left) / root.slider-travel, 0, 1));
                }
            } else if (event.kind == PointerEventKind.move) {
                if (root.dragging) {
                    root.volume-set(clamp((self.mouse-x - root.slider-left) / root.slider-travel, 0, 1));
                }
            } else if (event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.dragging = false;
                }
            } else if (event.kind == PointerEventKind.cancel) {
                root.dragging = false;
            }
        }

        clicked => {
            // 点在图标上 = 静音开关；点在滑杆上已在 pointer-event 里处理。
            if (area.mouse-x <= Theme.player-control-size) {
                root.mute-toggle();
            }
        }
    }
}

// 普通传输按钮（-15 / +15 / 音轨 / 字幕 / 倍速 / 全屏）。
//
// **统一控件语言**（官方底栏）：`background:transparent`、`border:3px solid transparent`、
// 图标/文字 `#fff`、hover 只有极淡高亮（官方底栏 hover 只换 `fill`，没有底色；
// 这里用弹层 hover 的 `hsla(0,0%,100%,.1)`）。边框只用于焦点环（官方 `:focus{outline:3px solid #fff}`）。
component TransportButton inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    width: label-text.preferred-width + Theme.player-control-padding * 2;
    height: Theme.player-control-size;
    border-radius: Theme.radius-pill;
    background: area.has-hover ? Theme.player-control-hover : transparent;
    border-width: Theme.player-focus-width;
    // 官方 `:focus{outline:3px solid #fff}`。播放页目前没有逐控件的键盘焦点模型
    // （键位由 app.slint 的全局 FocusScope 分派给 Rust），所以把官方焦点环画在
    // “这个按钮当前被打开 / 选中”的状态上（最接近的可见状态）。
    border-color: root.active ? Theme.player-focus-color : Theme.player-icon-border;
    animate background {
        // 官方 Hawkins 令牌：Button-Duration 250ms + Button-EasingHovered。
        duration: Theme.motion-button;
        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
    }
    animate border-color {
        duration: Theme.motion-button;
        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    label-text := Text {
        text: root.label;
        // 统一为白色（官方底栏图标/文字都是 `fill:#fff`）；active 时靠焦点环区分，不换色。
        color: Theme.text;
        font-family: Theme.font-family;
        font-size: Theme.font-12;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: Theme.player-control-padding;
        width: parent.width - Theme.player-control-padding * 2;
        height: parent.height;
        overflow: elide;
    }
}

// 播放 / 暂停主按钮。
//
// 官方底栏里播放钮就是一枚白色图标按钮：`.nfp-button-control{background:transparent;fill:#fff}`
// （`circle-control-button:before` 的深色圆底只用于别的场景；hero 视频圆钮的
// `rgba(22,22,22,.7)` + 描边是另一处来源，**不要混用**，见 §7 / §11.6）。
component PlayButton inherits Rectangle {
    in property <bool> playing: true;
    callback clicked();

    width: Theme.player-play-size;
    height: Theme.player-play-size;
    border-radius: Theme.radius-pill;
    background: area.has-hover ? Theme.player-control-hover : transparent;
    border-width: Theme.player-focus-width;
    border-color: Theme.player-icon-border;
    animate background {
        duration: Theme.motion-button;
        easing: cubic-bezier(0.32, 0.94, 0.6, 1);
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    if !root.playing : PlayGlyph {
        x: (parent.width - self.width) / 2 + self.width / 8;
        y: (parent.height - self.height) / 2;
        tint: Theme.text;
    }

    if root.playing : PauseGlyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        tint: Theme.text;
    }
}

// 音轨 / 字幕列表项。
component TrackRow inherits Rectangle {
    in property <TrackData> track;
    in property <bool> selected: root.track.selected;
    callback activated();

    height: Theme.player-control-size;
    border-radius: Theme.radius-poster;
    background: area.has-hover ? Theme.surface-raised : (root.selected ? Theme.player-menu-selected : transparent);

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }

    // 选中标记用圆点，不依赖 "✓" 字形。
    Rectangle {
        x: Theme.space-3;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: Theme.radius-pill;
        background: root.selected ? Theme.accent : Theme.hairline-strong;
    }

    VerticalLayout {
        x: Theme.space-5 + Theme.space-2;
        y: Theme.space-2;
        width: parent.width - Theme.space-5 - Theme.space-2 - Theme.space-3;
        height: parent.height - Theme.space-2 * 2;
        spacing: 2px;
        alignment: center;

        Text {
            text: root.track.label;
            color: root.selected ? Theme.accent : Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.font-14;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            // 图形字幕当场说明样式不可改，避免用户以为能调字体。
            text: root.track.bitmap ? "引擎渲染，样式不可改" : root.track.detail;
            color: Theme.text-muted;
            font-family: Theme.font-family;
            font-size: Theme.font-12;
            overflow: elide;
            visible: self.text != "";
            vertical-alignment: center;
        }
    }
}

// "关闭字幕"行（字幕菜单顶部）。
component OffRow inherits Rectangle {
    in property <bool> selected;
    callback activated();

    height: Theme.player-control-size;
    border-radius: Theme.radius-poster;
    background: area.has-hover ? Theme.surface-raised : (root.selected ? Theme.player-menu-selected : transparent);

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }

    Rectangle {
        x: Theme.space-3;
        y: (parent.height - 8px) / 2;
        width: 8px;
        height: 8px;
        border-radius: Theme.radius-pill;
        background: root.selected ? Theme.accent : Theme.hairline-strong;
    }

    Text {
        x: Theme.space-5 + Theme.space-2;
        y: 0;
        width: parent.width - Theme.space-5 - Theme.space-3;
        height: parent.height;
        text: "关闭";
        color: root.selected ? Theme.accent : Theme.text;
        font-family: Theme.font-family;
        font-size: Theme.font-14;
        vertical-alignment: center;
    }
}

// 菜单里的动作行（字幕延迟 ±0.5s / 加载外挂字幕）：不是选中项，不画选中圆点。
// 层级低于轨道行：字号 14 → **12**、行高 `player-menu-row`(44px) < 轨道行 51.6px，
// 上面还有一道 `Theme.hairline` 分隔线（官方弹层里没有这些动作，它们是我们的真功能，
// 不能删；降层级是为了让“轨道列表”仍然是菜单主体，见 docs §11.6）。
component ActionRow inherits Rectangle {
    in property <string> label: "";
    callback activated();

    height: Theme.player-menu-row;
    border-radius: Theme.radius-poster;
    background: action-area.has-hover ? Theme.surface-raised : transparent;

    action-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }

    Text {
        x: Theme.space-5 + Theme.space-2;
        y: 0;
        width: parent.width - Theme.space-5 - Theme.space-3;
        height: parent.height;
        text: root.label;
        color: Theme.text-muted;
        font-family: Theme.font-family;
        font-size: Theme.font-12;
        vertical-alignment: center;
        overflow: elide;
    }
}

// 弹出层外框。
component TrackMenu inherits Rectangle {
    in property <string> heading: "";
    in property <[TrackData]> tracks;
    in property <bool> show-close: false;
    in property <bool> close-selected: false;
    // 字幕菜单底部多三行动作（延迟 -0.5s / +0.5s / 外挂字幕）。
    in property <bool> show-subtitle-actions: false;
    callback item-selected(int);
    callback close-activated();
    callback delay-step(float);
    callback external-subtitle();

    property <int> row-count: root.tracks.length + (root.show-close ? 1 : 0);
    property <length> actions-height: root.show-subtitle-actions
        ? Theme.space-2 + 1px + Theme.player-menu-row * 3
        : 0px;

    width: Theme.player-menu-width;
    // 行高跟控制层一致（`Theme.player-control-size` = 官方 3.2222em），标题条 24px。
    height: Theme.space-4 + Theme.space-5 + Theme.player-control-size * root.row-count + root.actions-height;
    background: Theme.player-panel-solid;
    border-radius: Theme.radius-panel;
    border-width: 1px;
    border-color: Theme.hairline-strong;

    VerticalLayout {
        x: Theme.space-2;
        y: Theme.space-2;
        width: parent.width - Theme.space-2 * 2;
        height: parent.height - Theme.space-4;
        spacing: 0;

        Text {
            height: Theme.space-5;
            text: root.heading;
            color: Theme.text-muted;
            font-family: Theme.font-family;
            font-size: Theme.font-12;
            vertical-alignment: center;
            horizontal-alignment: left;
        }

        OffRow {
            // 用 `visible` + 高度归零代替 `if` 条件元素：布局数学一致，
            // 也不会在 software renderer 下让紧随其后的行留下合成接缝。
            visible: root.show-close;
            height: root.show-close ? Theme.player-control-size : 0px;
            selected: root.close-selected;

            activated => {
                root.close-activated();
            }
        }

        for item in root.tracks : TrackRow {
            track: item;
            activated => {
                root.item-selected(item.index);
            }
        }

        // ---- 字幕动作行 ----
        if root.show-subtitle-actions : Rectangle {
            height: 1px;
            background: Theme.hairline;
        }

        if root.show-subtitle-actions : Rectangle {
            height: Theme.space-2;
            background: transparent;
        }

        if root.show-subtitle-actions : ActionRow {
            label: "字幕延迟 −0.5s";
            activated => {
                root.delay-step(-0.5);
            }
        }

        if root.show-subtitle-actions : ActionRow {
            label: "字幕延迟 +0.5s";
            activated => {
                root.delay-step(0.5);
            }
        }

        if root.show-subtitle-actions : ActionRow {
            label: "加载外挂字幕…";
            activated => {
                root.external-subtitle();
            }
        }
    }
}

// 进度条：轨道 / 已缓冲 / 已播 + 拖动气泡。拖动只更新气泡，松手才回调 commit。
component PlayerProgress inherits Rectangle {
    in property <float> played: 0;
    in property <float> buffered: 0;
    in property <bool> scrubbing: false;
    in property <string> bubble: "";
    callback bar-start();
    callback bar-move(float);
    callback bar-commit(float);
    callback bar-cancel();

    property <bool> dragging: false;
    // 官方 `.nfp .scrubber-container{height:3.3em}`：可点区就是这 3.3em（16px 基数 ≈ 53px）。
    height: Theme.player-hit-height;
    background: transparent;

    // 官方 `.scrubber-container:hover .track` / `.nfp .is-scrubbing .track{height:1em}`（静息 `.5em`），
    // 两条都是 `transition:height .2s ease`。
    property <bool> hot: bar-area.has-hover || root.scrubbing;
    property <length> bar-height: root.hot ? Theme.player-bar-height-hover : Theme.player-bar-height;
    // 官方 `.scrubber-head{height:2.3em;width:2.3em;margin:-1.15em;transition:transform .2s ease}`，
    // `:hover` 与 `.is-scrubbing` 都 `scale(1.2)`。
    property <length> knob-size: Theme.player-bar-knob * (root.hot ? Theme.player-bar-knob-scale : 1);
    animate bar-height {
        duration: Theme.motion-zoom;
        easing: cubic-bezier(0.25, 0.1, 0.25, 1);
    }
    animate knob-size {
        duration: Theme.motion-zoom;
        easing: cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    property <float> buffered-ratio: max(root.buffered, root.played);
    // 已缓冲的那一段占比。
    property <float> buffered-part: clamp(root.buffered-ratio, 0, 1);

    // 轨道整条铺满：官方 `.track{background:#5b5b5b}` 是不透明灰，
    // `.buffered{background:hsla(0,0%,100%,.2)}` 是**叠在轨道上**的半透明白，
    // 所以不能在缓冲段把轨道挖空（旧实现挖空了，缓冲段会比官方暗）。
    // 官方 `.track` / `.buffered` / `.current-progress` 都没有 border-radius：方头。
    Rectangle {
        x: 0;
        y: (parent.height - root.bar-height) / 2;
        width: parent.width;
        height: root.bar-height;
        background: Theme.player-track;
    }

    Rectangle {
        x: 0;
        y: (parent.height - root.bar-height) / 2;
        width: parent.width * root.buffered-part;
        height: root.bar-height;
        background: Theme.player-buffered;
    }

    // `.current-progress{background:#e50914}`
    Rectangle {
        x: 0;
        y: (parent.height - root.bar-height) / 2;
        width: parent.width * clamp(root.played, 0, 1);
        height: root.bar-height;
        background: Theme.player-progress;
    }

    // 拖动头：官方 `.scrubber-head{opacity:1}` 是**常驻**的红色圆点（不是 hover 才出现），
    // 直径 2.3em，hover / 拖动中放大到 1.2 倍。
    Rectangle {
        x: parent.width * clamp(root.played, 0, 1) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: root.knob-size;
        height: root.knob-size;
        border-radius: Theme.radius-pill;
        background: Theme.player-progress;
    }

    // 时间气泡：跟随把手，靠近两端时夹住不越界。
    // （官方没有文字气泡，只有 trickplay 缩略图；气泡是我们自加的，见 docs §11）
    if root.scrubbing && root.bubble != "" : Rectangle {
        x: clamp(
            parent.width * clamp(root.played, 0, 1) - self.width / 2,
            0,
            parent.width - self.width
        );
        y: -self.height - Theme.space-2;
        width: bubble-text.preferred-width + Theme.space-3 * 2;
        height: Theme.player-bubble-height;
        border-radius: Theme.radius-poster;
        background: Theme.player-panel-solid;
        border-width: 1px;
        border-color: Theme.hairline-strong;

        bubble-text := Text {
            text: root.bubble;
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.font-12;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: Theme.space-3;
            width: parent.width - Theme.space-3 * 2;
            height: parent.height;
        }
    }

    bar-area := TouchArea {
        mouse-cursor: pointer;

        // 按下开始拖动，移动只更新气泡与把手（不发 seek），松手才提交。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dragging = true;
                root.bar-start();
                root.bar-move(clamp(self.mouse-x / self.width, 0, 1));
            } else if (event.kind == PointerEventKind.move) {
                if (root.dragging) {
                    root.bar-move(clamp(self.mouse-x / self.width, 0, 1));
                }
            } else if (event.kind == PointerEventKind.up) {
                if (root.dragging) {
                    root.dragging = false;
                    root.bar-commit(clamp(self.mouse-x / self.width, 0, 1));
                }
            } else if (event.kind == PointerEventKind.cancel) {
                root.dragging = false;
                root.bar-cancel();
            }
        }
    }
}

export component PlayerOverlay inherits Rectangle {
    in property <PlayerData> data;
    in property <string> scrub-text: "";
    in property <bool> fullscreen: false;

    callback back();
    callback play-pause();
    callback seek-relative(int);
    callback scrub-start();
    callback scrub-move(float);
    callback scrub-commit(float);
    callback scrub-cancel();
    callback input();
    callback tick();
    callback audio-toggle();
    callback subtitle-toggle();
    callback audio-selected(int);
    callback subtitle-selected(int);
    callback retry();
    callback fullscreen-toggle();
    callback rate-cycle();
    callback time-toggle();
    callback mute-toggle();
    callback volume-set(float);
    callback subtitle-delay(float);
    callback subtitle-external();

    background: transparent;

    property <bool> controls-visible: root.data.controls-visible;
    // ---- 控制层显隐：opacity 过渡 ----
    //
    // 直接用 `visible` 切控制层会把淡出掐断，所以改成"保持结构、opacity 过渡"：
    // 淡出期间 `visible: controls-fade > 0.01` 仍为真（能看到渐变），
    // 归零后元素不再参与命中测试，透明层不会吃掉点击。
    property <float> controls-fade: root.controls-visible ? 1 : 0;
    animate controls-fade {
        duration: Theme.motion;
        easing: ease-out;
    }
    property <bool> scrubbing: false;
    property <float> drag-ratio: 0;
    property <float> shown-ratio: root.scrubbing ? root.drag-ratio : root.data.progress;
    property <bool> show-center-play: !root.data.playing && !root.data.buffering && !root.data.has-error;
    // 传输行底边到进度条顶的距离由这几个量反推（菜单锚点也用它，不能侵入命中区）。
    property <length> progress-top: Theme.player-gutter + Theme.player-play-size
        + Theme.space-4 + Theme.player-hit-height;
    // 底部渐变高度：官方 `PlayerControlsNeo__gradient-bottom{height:20%}`；
    // 20%（1080 下 216px）装不下我们的控制块，所以取“20% 与最小高”的较大者。
    property <length> scrim-height: max(root.height * 0.2, Theme.player-scrim-min-height);

    // 真实窗口：每 250ms 把时间增量交给视图模型（`pages::player::TICK_INTERVAL`）。
    // testing backend 不跑 Timer，测试直接调 `App::tick_player`。
    Timer {
        interval: 250ms;
        running: root.visible;
        triggered => {
            root.tick();
        }
    }

    // 整屏输入层：任何移动/点击都唤醒控制层；隐藏时连光标都不显示。
    TouchArea {
        mouse-cursor: root.controls-visible ? MouseCursor.default : MouseCursor.none;

        pointer-event(event) => {
            if (event.kind == PointerEventKind.move) {
                root.input();
            } else if (event.kind == PointerEventKind.down) {
                root.input();
            }
        }

        clicked => {
            root.input();
        }
    }

    // ---- 顶部渐变（官方 loading 层 `.gradient`：高 11.11111111em、rgba(0,0,0,.651)）----
    Rectangle {
        visible: root.controls-fade > 0.01;
        opacity: root.controls-fade;
        x: 0;
        y: 0;
        width: 100%;
        height: Theme.player-top-scrim-height;
        background: Theme.player-top-gradient;
    }

    // ---- 整屏压暗：**没有**采用 ----
    //
    // 官方确实有一条 `.PlayerControlsNeo__layout--dimmed{background-color:rgba(0,0,0,.5)}`，
    // 但同一个逗号组里还写着 `--dimmed .PlayerControlsNeo__core-controls{opacity:0}`：
    // 即“压暗”时控制层本身是**隐藏**的，它是另一个状态（我们无法登录确认是哪个场景）。
    // 所以这里不把它当成“控制层可见就压暗整帧”用，只保留官方两条渐变。§11 有记录。

    // ---- 左上返回（官方 `.player-exit{width:1.4em;height:1.4em;opacity:.5;
    //      transition:opacity .2s ease-out}` + hover `opacity:1`）----
    // 命中区比图标大一圈（图标 1.4em ≈ 22px，单靠它点不中）。
    Rectangle {
        visible: root.controls-fade > 0.01;
        opacity: root.controls-fade;
        x: Theme.player-gutter - Theme.space-3;
        y: Theme.player-gutter - Theme.space-3;
        width: Theme.player-back-size + Theme.space-3 * 2;
        height: Theme.player-back-size + Theme.space-3 * 2;
        background: transparent;

        BackGlyph {
            x: Theme.space-3;
            y: Theme.space-3;
            tint: Theme.text;
            opacity: back-area.has-hover ? 1 : Theme.player-back-opacity;
            animate opacity {
                // 官方 `transition:opacity .2s ease-out`。
                duration: Theme.motion-zoom;
                easing: ease-out;
            }
        }

        back-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.back();
            }
        }
    }

    // ---- 缓冲角标（不随控制层隐藏）----
    Rectangle {
        visible: root.data.buffering;
        x: root.width - self.width - Theme.player-gutter;
        y: Theme.player-gutter;
        width: buffering-text.preferred-width + Theme.space-4 * 2;
        height: Theme.player-badge-height;
        border-radius: Theme.radius-pill;
        background: Theme.player-panel-solid;
        border-width: 1px;
        border-color: Theme.hairline;

        buffering-text := Text {
            x: Theme.space-4;
            width: parent.width - Theme.space-4 * 2;
            height: parent.height;
            text: "缓冲中…";
            color: Theme.text;
            font-family: Theme.font-family;
            font-size: Theme.font-12;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    // ---- 中央大播放图标（暂停时）----
    //
    // 官方 `.nf-big-play-pause button .svg-icon-nfplayerOpticalCenterPlay{opacity:.7}`：
    // **一枚半透明的大图标，没有底色也没有描边**。这里去掉原来的深色圆底 + 1px 描边
    // （那是 hero 视频圆钮的实测样式，不属于播放器，见 §7 / §11.6）。
    if root.show-center-play && root.controls-fade > 0.01 : Rectangle {
        opacity: root.controls-fade;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.player-icon-size;
        height: Theme.player-icon-size;
        background: transparent;

        PlayGlyph {
            width: Theme.player-unit * Theme.player-icon-play-w * 3;
            height: Theme.player-unit * Theme.player-icon-play-h * 3;
            x: (parent.width - self.width) / 2 + self.width / 8;
            y: (parent.height - self.height) / 2;
            tint: Theme.text;
            opacity: 0.7;
        }
    }

    // ---- 错误卡 ----
    if root.data.has-error : Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: Theme.player-error-width;
        height: 184px;
        border-radius: Theme.radius-panel;
        background: Theme.player-panel-solid;
        border-width: 1px;
        border-color: Theme.danger;

        VerticalLayout {
            x: Theme.space-5;
            y: Theme.space-4;
            width: parent.width - Theme.space-5 * 2;
            height: parent.height - Theme.space-4 - Theme.space-4;
            spacing: Theme.space-3;

            Text {
                height: 24px;
                text: "播放失败";
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-16;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }

            Text {
                height: 48px;
                text: root.data.error;
                color: Theme.text-muted;
                font-family: Theme.font-family;
                font-size: Theme.font-14;
                wrap: word-wrap;
                vertical-alignment: top;
                overflow: elide;
            }

            Rectangle {
                height: Theme.button-primary-height;
                width: retry-text.preferred-width + Theme.space-6 * 2;
                border-radius: Theme.radius-pill;
                // 官方 Hawkins 令牌：Button-Surface / Hovered / Pressed。
                background: retry-area.pressed ? Theme.accent-pressed
                    : (retry-area.has-hover ? Theme.accent-hover : Theme.accent);
                animate background {
                    duration: retry-area.pressed ? Theme.motion-press : Theme.motion-button;
                    easing: retry-area.has-hover
                        ? cubic-bezier(0.32, 0.94, 0.6, 1) : cubic-bezier(0.4, 0, 0.68, 0.06);
                }

                retry-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.retry();
                    }
                }

                retry-text := Text {
                    x: Theme.space-6;
                    width: parent.width - Theme.space-6 * 2;
                    height: parent.height;
                    text: root.data.error-action;
                    color: Theme.accent-contrast;
                    font-family: Theme.font-family;
                    font-size: Theme.font-14;
                    font-weight: Theme.weight-semibold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // ---- 底部渐变 ----
    // 官方（`/tmp/live_akira.css`）：`.PlayerControlsNeo__gradient-bottom{background-image:
    // linear-gradient(0deg,rgba(0,0,0,.7) 0,transparent);bottom:0;height:20%}`，激活时整层
    // 再乘 `opacity:.75`。不是我们原来的两段式（0.94 不透明平台）。
    Rectangle {
        visible: root.controls-fade > 0.01;
        // 官方 `--active` 的 `.75` 已预乘进 `player-scrim-bottom`（否则会把子控件也变半透明）。
        opacity: root.controls-fade;
        x: 0;
        y: root.height - self.height;
        width: 100%;
        height: root.scrim-height;
        // 底部 75% 是官方那条 `rgba(0,0,0,.7)` 不降的 plateau，上面 25% 才淡出：
        // 官方是纯线性 ramp，但我们的控制块（标题在顶、进度条、按钮）装不下 20% 的渐变，
        // 标题会落在几乎透明的顶端 → 亮画面上直接糊掉。颜色 / 叠层仍是官方两个值，
        // 只把 stop 位置往下拉（见 docs §11 的偏差记录）。
        background: @linear-gradient(0deg, Theme.player-scrim-bottom 0%, Theme.player-scrim-bottom 75%, Theme.player-scrim-top 100%);

        // 第二层（官方另一条同区渐变）：`.watch-video--bottom-controls-container-scrim{
        // background-image:linear-gradient(0deg,rgba(0,0,0,.3) 0,transparent)}`。
        // 两层叠起来底部 = 1-(1-.525)*(1-.3) ≈ .67，纯白画面上白字实测 8.3:1。
        Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: @linear-gradient(0deg, Theme.player-scrim-floor 0%, Theme.player-scrim-floor 75%, Theme.player-scrim-top 100%);
        }

        VerticalLayout {
            // 左右留白与控制层同一个 token（官方 `.top-left-controls{margin:4.5em}`）。
            x: Theme.player-gutter;
            width: parent.width - Theme.player-gutter * 2;
            // 底部只留 player-gutter；顶部剩余空间全归渐变的淡出区。
            y: 0;
            height: parent.height - Theme.player-gutter;
            // 内容全部贴底，多余空间留在遮罩顶部的淡出区（不会把控件撕成两坨）。
            alignment: end;
            spacing: 0;

            // 第一行：标题 + 副标题。
            //
            // Netflix 播放器在这行只有标题（loading 层是“返回 + 标题 + 副标题”），
            // **没有**任何常驻诊断/状态文字。引擎诊断（直连/转码、hwdec、1080p60）已经从画面上
            // 整块拿掉：数据仍在 `PlayerData.transport-mode / engine-line / hwdec-notice`，
            // 由 `--debug-socket` 的 `view` 读（见 docs/ui-netflix-1to1.md §11.6）。
            // 标题字号/字重照官方 loading 层 `.title{font-size:2em;font-weight:500}`。
            HorizontalLayout {
                height: Theme.player-title-row-height;
                spacing: Theme.space-3;
                cross-axis-alignment: center;

                Text {
                    text: root.data.title;
                    color: Theme.text;
                    font-family: Theme.font-family;
                    font-size: Theme.player-title-size;
                    font-weight: Theme.player-title-weight;
                    overflow: elide;
                    vertical-alignment: center;
                }

                // 官方 `video-title span{color:#adadad;font-size:2em}` / loading `.subtitle{1.33em}`。
                Text {
                    text: root.data.subtitle;
                    color: Theme.player-subtitle-color;
                    font-family: Theme.font-family;
                    font-size: Theme.player-subtitle-size;
                    overflow: elide;
                    vertical-alignment: center;
                    visible: self.text != "";
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }

            // 标题 → 进度条：固定 12px。
            Rectangle {
                height: Theme.space-3;
                background: transparent;
            }

            // 第二行：进度条（3.3em = 53px 命中区）。
            PlayerProgress {
                height: Theme.player-hit-height;
                played: root.shown-ratio;
                buffered: max(root.data.buffered, root.shown-ratio);
                scrubbing: root.scrubbing;
                bubble: root.scrub-text;

                bar-start => {
                    root.scrubbing = true;
                    root.scrub-start();
                }

                bar-move(ratio) => {
                    root.drag-ratio = ratio;
                    root.scrub-move(root.drag-ratio);
                }

                bar-commit(ratio) => {
                    root.drag-ratio = ratio;
                    root.scrub-commit(ratio);
                    root.scrubbing = false;
                }

                bar-cancel => {
                    root.scrubbing = false;
                    root.scrub-cancel();
                }
            }

            // 进度条 → 传输行：固定 16px。
            Rectangle {
                height: Theme.space-4;
                background: transparent;
            }

            // 第三行：传输控件（官方底栏的分组）。
            //
            // 左组：播放/暂停、音量、-15s、+15s；右组：字幕、音轨、倍速、全屏；
            // **剩余时间**在最右（官方 `.time-remaining`；数据层默认已改成剩余）。
            // 组间只放**一个** `horizontal-stretch: 1`——弹性间距在组与组之间，不在组内
            // （旧实现把时间文本和弹性间距混在组内，才出现"中间一个大空档"）。
            HorizontalLayout {
                height: Theme.player-play-size;
                spacing: Theme.space-2;
                cross-axis-alignment: center;

                // ---- 左组 ----
                PlayButton {
                    playing: root.data.playing;
                    clicked => {
                        root.play-pause();
                    }
                }

                VolumeControl {
                    volume: root.data.volume;
                    muted: root.data.muted;

                    mute-toggle => {
                        root.mute-toggle();
                    }

                    volume-set(volume) => {
                        root.volume-set(volume);
                    }
                }

                // 官方图标是 ±10s（`nfplayerBackTen` / `nfplayerFastForward`）；我们是 ±15s
                // （与键盘 ←/→ 一致），形态统一但步长是我们的选择，见 §11.6。
                TransportButton {
                    label: "-15s";
                    clicked => {
                        root.seek-relative(-15);
                    }
                }

                TransportButton {
                    label: "+15s";
                    clicked => {
                        root.seek-relative(15);
                    }
                }

                // ---- 组间弹性间距（唯一一个）----
                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                // ---- 右组 ----
                TransportButton {
                    label: "字幕";
                    active: root.data.subtitle-menu-open;
                    clicked => {
                        root.subtitle-toggle();
                    }
                }

                TransportButton {
                    label: "音轨";
                    active: root.data.audio-menu-open;
                    clicked => {
                        root.audio-toggle();
                    }
                }

                // 倍速：官方有对应控件（`.PlayerControlsNeo__core-controls .button-nfplayerSpeed` +
                // `.speed-controller` 弹层），不是我们自加的。
                TransportButton {
                    label: root.data.rate-text;
                    clicked => {
                        root.rate-cycle();
                    }
                }

                TransportButton {
                    label: root.fullscreen ? "退出全屏" : "全屏";
                    clicked => {
                        root.fullscreen-toggle();
                    }
                }

                // 右组与时间之间留一个固定间隔，避免时间码贴住"全屏"。
                Rectangle {
                    width: Theme.space-4;
                    background: transparent;
                }

                // 剩余时间（最右）：点击在"剩余"与"已播/总长"之间切换，不同时渲染两份。
                Rectangle {
                    width: time-label.preferred-width + Theme.space-2 * 2;
                    height: Theme.player-control-size;
                    border-radius: Theme.radius-poster;
                    background: time-area.has-hover ? Theme.player-control-hover : transparent;

                    time-label := Text {
                        x: Theme.space-2;
                        y: 0;
                        width: parent.width - Theme.space-2 * 2;
                        height: parent.height;
                        text: root.data.time-text;
                        color: Theme.text;
                        // 时间码用等宽：秒数跳动时不会左右抖。
                        // 字号照官方 `.time-remaining__time{font-size:1.8em}`。
                        font-family: Theme.font-mono;
                        font-size: Theme.player-time-size;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    time-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.time-toggle();
                        }
                    }
                }
            }
        }
    }

    // ---- 音轨弹出层 ----
    // 锚点：进度条顶 − 16px − 菜单高（不侵入 3.3em 命中区，也不遮时间行）。
    if root.data.audio-menu-open : TrackMenu {
        x: root.width - self.width - Theme.player-gutter;
        y: root.height - root.progress-top - Theme.space-4 - self.height;
        heading: "音轨";
        tracks: root.data.audio-tracks;

        item-selected(index) => {
            root.audio-selected(index);
        }
    }

    // ---- 字幕弹出层（顶部是"关闭"，图形字幕标注样式不可改，底部是延迟 / 外挂字幕）----
    if root.data.subtitle-menu-open : TrackMenu {
        x: root.width - self.width - Theme.player-gutter;
        y: root.height - root.progress-top - Theme.space-4 - self.height;
        heading: "字幕";
        tracks: root.data.subtitle-tracks;
        show-close: true;
        close-selected: root.data.subtitles-off;
        show-subtitle-actions: true;

        item-selected(index) => {
            root.subtitle-selected(index);
        }

        close-activated => {
            root.subtitle-selected(-1);
        }

        delay-step(seconds) => {
            root.subtitle-delay(seconds);
        }

        external-subtitle => {
            root.subtitle-external();
        }
    }
}

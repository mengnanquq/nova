//! Slint 侧的数据形状。与 Rust 视图模型一一对应，由 `src/pages/convert.rs` 填充。

export struct CardData {
    id: string,
    title: string,
    subtitle: string,
    // 简介（只有 billboard 用到；行卡片为空串）。
    overview: string,
    badge: string,
    progress: float, // < 0 表示没有进度
    progress-text: string,
    initial: string,
    image: image,
}

export struct RowData {
    title: string,
    cards: [CardData],
}

export struct TabData {
    id: string,
    title: string,
}

// 搜索页：结果头文案在 Rust 侧拼好（`「沙丘」的搜索结果` / `共 5 部`）。
export struct SearchData {
    // 顶栏标签：搜索页也要画顶栏（Netflix 所有页面都有 header），
    // 标签数据从首页视图借来，避免再复制一份导航状态。
    tabs: [TabData],
    // 当前标签下标。
    current-tab: int,
    // 当前查询词（回填搜索框）。
    term: string,
    // 结果头主文案。
    title: string,
    // 命中数文案。
    count-text: string,
    cards: [CardData],
    // 0 idle / 1 loading / 2 ready / 3 empty / 4 error（与 `SearchState::index` 一致）。
    state: int,
    // 失败说明（state == 4 时显示）。
    error: string,
}

export struct SourceData {
    id: string,
    title: string,
    subtitle: string,
    selected: bool,
}

export struct HomeData {
    hero: CardData,
    has-hero: bool,
    continue-watching: [CardData],
    recently-added: [CardData],
    // 各媒体库前 20 条的行（16:9，标题 = 库名）。
    library-rows: [RowData],
    // 非空库行数（内容高度计算用）。
    library-row-count: int,
    tabs: [TabData],
    current-tab: int,
    empty: bool,
}



export struct LibraryData {
    id: string,
    title: string,
    count-text: string,
    sort-label: string,
    tabs: [TabData],
    current-tab: int,
    cards: [CardData],
    empty: bool,
}

export struct DetailData {
    item-id: string,
    title: string,
    original-title: string,
    meta-line: string,
    overview: string,
    genres: [string],
    play-label: string,
    badge: string,
    initial: string,
    poster: image,
    backdrop: image,
    sources: [SourceData],
    // 当前选中版本的展示文案（"4K HDR · 简体中文"），下拉收起时显示。
    selected-source-label: string,
    // 类型标签整行（"科幻 · 冒险 · 剧情"），单 Text 渲染避免布局拉伸。
    genres-line: string,
}

export struct TrackData {
    index: int,
    label: string,
    detail: string,
    selected: bool,
    bitmap: bool,
}

export struct PlayerData {
    item-id: string,
    title: string,
    subtitle: string,
    // "12:34 / 2:18:00"
    time-line: string,
    // "-2:05:26"（Infuse 风格）；空字符串表示不显示
    remaining-text: string,
    // 实际渲染的那一行时间（已播/总长 或 剩余，二选一）
    time-text: string,
    progress: float,
    buffered: float,
    has-progress: bool,
    playing: bool,
    buffering: bool,
    volume: float,
    volume-text: string,
    // 音量数字短时可见（正在调节 / 刚静音）
    volume-hint: bool,
    muted: bool,
    rate-text: string,
    audio-tracks: [TrackData],
    subtitle-tracks: [TrackData],
    // 当前没有选中字幕（字幕菜单里"关闭"打勾）
    subtitles-off: bool,
    audio-menu-open: bool,
    subtitle-menu-open: bool,
    error: string,
    has-error: bool,
    error-action: string,
    // hwdec_notice 优先于 engine_line
    status-line: string,
    has-status-line: bool,
    // 提示是"需要用户注意"（hwdec 未生效）还是普通诊断行
    status-warning: bool,
    // 常驻的短标签："直连" / "转码"（由诊断行的第一段得出，空串表示没有）
    transport-mode: string,
    // 完整诊断行：只在 show-engine-detail 打开时渲染
    engine-line: string,
    show-engine-detail: bool,
    // 硬件解码未生效的完整提示（warning 色），空串表示正常
    hwdec-notice: string,
    controls-visible: bool,
    // 当前画面（引擎首帧到达前的背景图 / 缓冲时保留的最后一帧）。
    frame: image,
    has-frame: bool,
}


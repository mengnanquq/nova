//! 应用窗口：组合五个页面、把按键意图交给 Rust 绑定层。
//!
//! .slint 只做“按键 → 意图编号”的映射与页面切换；焦点索引、导航栈都在 Rust 里。

import { Theme } from "theme.slint";
import { HomeData, LibraryData, DetailData, PlayerData, SearchData, Target, TargetBus } from "models.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { DetailPage } from "detail.slint";
import { PlayerShellPage } from "player_shell.slint";
import { SearchPage } from "search.slint";
import { Banner } from "components/banner.slint";
import { AddServerDialog } from "components/add_server.slint";

export { Theme }
// 调试通道的目标注册总线：Rust 侧要能读写 `gen` 并安装 `register` 回调。
export { TargetBus }

export component AppWindow inherits Window {
    // 窗口初始逻辑宽（真实启动 1280×800）。绑定只作初始值：用户手动缩窗时
    // 窗口系统会直接写 width（覆盖本绑定）；测试可改 window-w 验证 vw 缩放。
    in-out property <length> window-w: 1280px;
    in-out property <length> window-h: 800px;
    width: root.window-w;
    height: root.window-h;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    forward-focus: keyboard;

    // vw 驱动尺寸：视口宽度写回 Theme（gutter / 卡宽 / 链接间距都从这里派生）。
    init => {
        Theme.viewport-width = self.width;
    }
    changed width => {
        Theme.viewport-width = self.width;
    }
    // 代码/测试直接设逻辑宽时（testing 后端不会为 Window.width 发 changed），
    // 也必须同步——否则整棵树按旧 vw 算尺寸，塞进新窗口里就是压扁的布局。
    changed window-w => {
        Theme.viewport-width = root.window-w;
    }
    out property <length> probe-card-h: Theme.card-landscape-h;

    // 测试用：继续观看行的放大覆盖层几何（「放大不跳布局」断言）。
    out property <length> zoom-rect-x: home-page.zoom-rect-x;
    out property <length> zoom-rect-y: home-page.zoom-rect-y;
    out property <length> zoom-rect-w: home-page.zoom-rect-w;
    out property <length> zoom-rect-h: home-page.zoom-rect-h;
    out property <bool> row0-zoom-on: home-page.row0-zoom-on;
    out property <length> row0-y: home-page.row0-y;
    out property <length> row0-arrow-y: home-page.row0-arrow-y;
    // 测试用：继续观看行的行标题下沿 / 图高 / 卡片总高（验收"放大不盖标题"
    // 与"卡片总高 = 图高 + 卡下标题块"）。
    out property <length> row0-title-bottom: home-page.row0-title-bottom;
    out property <length> row0-poster-width: home-page.row0-poster-width;
    out property <length> row0-poster-height: home-page.row0-poster-height;
    out property <length> row0-card-height: home-page.row0-card-height;
    // 竖版行（最近添加）：官方 240×336 的 5:7 海报。
    out property <length> row1-poster-width: home-page.row1-poster-width;
    out property <length> row1-poster-height: home-page.row1-poster-height;
    out property <length> row1-card-height: home-page.row1-card-height;

    // 测试用：搜索页结果网格几何（6 列 / 5:7 / 起点 = content-gutter）。
    out property <int> search-columns: search-page.probe-columns;
    out property <length> search-card-w: search-page.probe-card-w;
    out property <length> search-poster-h: search-page.probe-poster-h;
    out property <length> search-card-h: search-page.probe-card-h;
    out property <length> search-row-h: search-page.probe-row-h;
    out property <length> search-card-step: search-page.probe-card-step;
    out property <length> search-content-gutter: search-page.probe-gutter;
    out property <length> search-first-card-x: search-page.probe-first-x;

    // 测试用：详情页内容块几何（单一纵向布局叠在 hero 下半部）。
    // `detail-body-y + detail-body-height + Theme.detail-body-bottom-gap` 应等于
    // `detail-backdrop-height`（±2px）——即内容块整体落在 hero 内。
    out property <length> detail-body-y: detail-page.probe-body-y;
    out property <length> detail-body-height: detail-page.probe-body-height;
    out property <length> detail-backdrop-height: detail-page.probe-backdrop-height;
    // 三个区块的绝对上下沿（标题 / 简介 / 按钮），用于"互不重叠"回归断言。
    out property <length> detail-title-top: detail-page.probe-title-top;
    out property <length> detail-title-bottom: detail-page.probe-title-bottom;
    out property <length> detail-overview-top: detail-page.probe-overview-top;
    out property <length> detail-overview-bottom: detail-page.probe-overview-bottom;
    out property <length> detail-buttons-top: detail-page.probe-buttons-top;
    out property <length> detail-buttons-bottom: detail-page.probe-buttons-bottom;

    in property <HomeData> home;
    in property <LibraryData> library;
    in property <DetailData> detail;
    in property <PlayerData> player;
    // 注意：不能叫 `search`——那会和下面的 `search()` 回调重名。
    in property <SearchData> search-data;

    // 0 = 首页，1 = 媒体库，2 = 详情，3 = 播放页，4 = 搜索页。
    in-out property <int> page: 0;
    in-out property <int> home-focus: 0;
    in-out property <int> library-focus: 0;
    in-out property <int> detail-focus: 0;
    in-out property <int> search-focus: 0;
    in-out property <bool> search-focused: false;
    // 用户是否已经真的在导航（按过方向键 / 悬停过卡片）。
    //
    // 页面一创建 `keyboard` FocusScope 就拿到焦点、`*-focus` 默认是 0，如果放大层
    // 直接绑 `focus-index`，程序一打开第一张卡就是放大状态 —— Netflix 不会这样，
    // 它只在指针悬停或真的按了方向键之后才放大。所以这里加一道"导航已激活"的门。
    // 换页时复位，回到"没有放大"的干净状态。
    in-out property <bool> nav-active: false;
    changed page => {
        root.nav-active = false;
    }
    // 搜索框文本：与导航栏的 TextInput 双向同步，Rust 侧读写这里。
    in-out property <string> search-text: "";
    // 顶部横幅（通知位）：不遮挡导航栏，出现时内容整体下移。
    in property <bool> banner-visible: false;
    // 语义级别：0 info / 1 warning / 2 danger。
    in property <int> banner-level: 0;
    in property <string> banner-text: "";
    // 空字符串表示没有动作按钮。
    in property <string> banner-action-label: "";
    // “添加服务器”对话框：覆盖层，不参与下层布局。
    // 0 = 空闲，1 = 连接中（禁用重复提交）。
    in-out property <bool> add-server-open: false;
    in property <int> add-server-state: 0;
    in-out property <string> add-server-address: "";
    in-out property <string> add-server-user: "";
    in-out property <string> add-server-password: "";
    // 地址的内联提示（空串 = 无提示）。
    in property <string> add-server-hint: "";
    in property <bool> add-server-plaintext: false;
    // 错误区：主文案 + 可选补充说明。
    in property <string> add-server-error: "";
    in property <string> add-server-error-detail: "";
    // 钥匙环退化等提示。
    in property <string> add-server-note: "";
    // 拖动进度条时的气泡文本（Rust 侧用视图模型格式化）。
    in-out property <string> player-scrub-text: "";
    in-out property <bool> player-fullscreen: false;
    // 网格列数：与 `PosterGrid` 实际绘制保持一致——Netflix 1920 实测正文列宽 1520，
    // 6 张 240 宽海报 + 12px 间距正好铺满，所以 1920 也是 6 列（不是 7）。
    // 媒体库 / 搜索页 / 键盘焦点数学必须用同一个数，否则方向键步长与画面不符。
    out property <int> grid-columns: 6;

    // ---- 调试通道：当前页面的可交互目标（见 docs/ui-architecture.md）----
    // 只含"当前页面直接摆放、常驻"的控件（即各页 `targets` 数组）。重复元素
    // （卡片 / 标签 / 菜单行）与条件子树（hero / 空态 / 横幅 / 对话框）在 Slint 1.19
    // 里没法拼进数组，它们通过 `TargetBus` 登记；调试通道在 Rust 侧把两路合并。
    out property <[Target]> targets: root.page == 0 ? home-page.targets
        : root.page == 1 ? lib-page.targets
        : root.page == 2 ? detail-page.targets
        : root.page == 3 ? player-page.targets
        : search-page.targets;
    // testing 快照用：压缩首页 billboard，让行区进入首屏。
    in-out property <float> billboard-ratio: 0.88;

    // 回调只把事件送出去，业务判断留在 Rust。
    callback open-item(string);
    callback play-item(string);
    callback hero-play();
    callback back();
    callback search();
    callback search-changed(string);
    // 搜索页自己的大输入框（与顶栏的 search-changed 同一套行为，单独一条便于区分来源）。
    callback search-input(string);
    callback search-submit();
    callback search-clear();
    // 搜索页错误态的“重试”。
    callback search-retry();
    callback banner-action();
    callback connect-server();
    callback add-server-close();
    callback add-server-submit();
    callback add-server-address-edited(string);
    callback sort();
    callback tab-activated(string);
    callback source-selected(string);
    // 1 ← / 2 → / 3 ↑ / 4 ↓ / 5 Enter·Space / 6 Esc·Backspace / 7 Ctrl+F
    callback key-intent(int);

    // 播放页：键位在这里只做分派，射出什么行为由 Rust 决定。
    // 1 Space/K / 2 ← / 3 → / 4 Shift+← / 5 Shift+→ / 6 ↑ / 7 ↓ / 8 M / 9 A / 10 S / 11 F / 12 Esc
    callback player-key(int);
    callback player-back();
    callback player-play-pause();
    callback player-seek-relative(int);
    callback player-scrub-start();
    callback player-scrub-move(float);
    callback player-scrub-commit(float);
    callback player-scrub-cancel();
    callback player-input();
    callback player-tick();
    callback player-audio-toggle();
    callback player-subtitle-toggle();
    callback player-audio-selected(int);
    callback player-subtitle-selected(int);
    callback player-retry();
    callback player-fullscreen-toggle();
    callback player-rate-cycle();
    callback player-time-toggle();
    callback player-mute-toggle();
    callback player-volume-set(float);
    callback player-subtitle-delay(float);
    // 控制层显隐变化时把字幕应该抬多高（px）报出去（mpv 的 sub-margin-y）。

    keyboard := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        init => {
            keyboard.focus();
        }

        key-pressed(event) => {
            // 任何按键都算"用户开始操作"，之后才允许放大焦点卡。
            root.nav-active = true;
            // 播放页有自己的快捷键表，且 Esc 必须先提交进度再退出。
            if (root.page == 3) {
                // 任何键都算一次输入：立刻显示控制层并重置 3 秒计时。
                root.player-input();
                if (event.text == Key.Space || event.text == "k" || event.text == "K") {
                    root.player-key(1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.player-key(event.modifiers.shift ? 4 : 2);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.player-key(event.modifiers.shift ? 5 : 3);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.player-key(6);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.player-key(7);
                    return accept;
                }
                if (event.text == "m" || event.text == "M") {
                    root.player-key(8);
                    return accept;
                }
                if (event.text == "a" || event.text == "A") {
                    root.player-key(9);
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.player-key(10);
                    return accept;
                }
                if (event.text == "f" || event.text == "F") {
                    root.player-key(11);
                    return accept;
                }
                // Ctrl+D（完整诊断行）已移除：Netflix 播放器画面上没有常驻/可展开的诊断文字，
                // 引擎诊断只走 `--debug-socket` 的 `view`。这里不再占一个键，也不留“按了没反应”的键。
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.player-key(12);
                    return accept;
                }
            }
            // 对话框打开时：Esc 关闭，其余按键不透给被遮罩的首页。
            if (root.add-server-open) {
                if (event.text == Key.Escape) {
                    root.add-server-close();
                    return accept;
                }
                // Enter / Space / 方向键都吞掉，避免误触首页焦点或播放。
                if (event.text == Key.Return || event.text == Key.Space
                    || event.text == Key.LeftArrow || event.text == Key.RightArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    return accept;
                }
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.key-intent(7);
                return accept;
            }
            // Ctrl+N：打开“添加服务器”对话框（与首页空态按钮、横幅动作同一路径）。
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.key-intent(8);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.key-intent(1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-intent(2);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.key-intent(3);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.key-intent(4);
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.key-intent(5);
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.key-intent(6);
                return accept;
            }
            return reject;
        }
    }

    // 横幅在最上方：出现时把页面整体下移 48px，不遮挡导航栏；隐藏时完全不占位。
    // 不用布局器，直接显式偏移，避免布局对隐藏元素的预留空间。
    Banner {
        y: 0;
        width: root.width;
        height: root.banner-visible ? Theme.banner-height : 0px;
        visible: root.banner-visible;
        clip: true;
        level: root.banner-level;
        text: root.banner-text;
        action-label: root.banner-action-label;
        action => {
            root.banner-action();
        }
    }

    content := Rectangle {
        y: root.banner-visible ? Theme.banner-height : 0px;
        width: root.width;
        // 高度不随横幅缩短：内部几何与无横幅时完全一致（卡片等元素尺寸逐像素不变），
        // 底部超出窗口的部分由窗口裁掉（页面自身有 48px 底部留白，且内容可滚动）。
        height: parent.height;

            home-page := HomePage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 0;
                data: root.home;
                billboard-ratio: root.billboard-ratio;
                focus-index <=> root.home-focus;
                nav-active: root.nav-active;
                search-focused: root.search-focused;
                search-text <=> root.search-text;
                open-item(id) => {
                    root.open-item(id);
                }
                hero-play => {
                    root.hero-play();
                }
                connect-server => {
                    root.connect-server();
                }
                tab-activated(id) => {
                    root.tab-activated(id);
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-changed(text);
                }
                search-submit => {
                    root.search-submit();
                }
                search-clear => {
                    root.search-clear();
                }
                search-escape => {
                    // 焦点还给全局键盘处理；Rust / 测试从 search-focused 读状态。
                    keyboard.focus();
                    root.search-focused = false;
                }
            }

            lib-page := LibraryPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 1;
                data: root.library;
                focus-index <=> root.library-focus;
                nav-active: root.nav-active;
                search-focused: root.search-focused;
                search-text <=> root.search-text;
                open-item(id) => {
                    root.open-item(id);
                }
                tab-activated(id) => {
                    root.tab-activated(id);
                }
                sort => {
                    root.sort();
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-changed(text);
                }
                search-submit => {
                    root.search-submit();
                }
                search-clear => {
                    root.search-clear();
                }
                search-escape => {
                    keyboard.focus();
                    root.search-focused = false;
                }
            }

            detail-page := DetailPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 2;
                data: root.detail;
                focus-index <=> root.detail-focus;
                back => {
                    root.back();
                }
                play => {
                    root.play-item(root.detail.item-id);
                }
                source-selected(id) => {
                    root.source-selected(id);
                }
            }

            search-page := SearchPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 4;
                data: root.search-data;
                focus-index <=> root.search-focus;
                nav-active: root.nav-active;
                search-text <=> root.search-text;
                search-focused: root.search-focused;
                open-item(id) => {
                    root.open-item(id);
                }
                tab-activated(id) => {
                    root.tab-activated(id);
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-input(text);
                }
                search-submit => {
                    root.search-submit();
                }
                search-clear => {
                    root.search-clear();
                }
                search-escape => {
                    keyboard.focus();
                    root.search-focused = false;
                }
                search-blur => {
                    keyboard.focus();
                    root.search-focused = false;
                }
                search-retry => {
                    root.search-retry();
                }
            }

            player-page := PlayerShellPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 3;
                data: root.player;
                scrub-text: root.player-scrub-text;
                fullscreen: root.player-fullscreen;

        back => {
            root.player-back();
        }

        play-pause => {
            root.player-play-pause();
        }

        seek-relative(seconds) => {
            root.player-seek-relative(seconds);
        }

        scrub-start => {
            root.player-scrub-start();
        }

        scrub-move(ratio) => {
            root.player-scrub-move(ratio);
        }

        scrub-commit(ratio) => {
            root.player-scrub-commit(ratio);
        }

        scrub-cancel => {
            root.player-scrub-cancel();
        }

        input => {
            root.player-input();
        }

        tick => {
            root.player-tick();
        }

        audio-toggle => {
            root.player-audio-toggle();
        }

        subtitle-toggle => {
            root.player-subtitle-toggle();
        }

        audio-selected(index) => {
            root.player-audio-selected(index);
        }

        subtitle-selected(index) => {
            root.player-subtitle-selected(index);
        }

        retry => {
            root.player-retry();
        }

        fullscreen-toggle => {
            root.player-fullscreen-toggle();
        }

        rate-cycle => {
            root.player-rate-cycle();
        }

        time-toggle => {
            root.player-time-toggle();
        }

        mute-toggle => {
            root.player-mute-toggle();
        }

        volume-set(volume) => {
            root.player-volume-set(volume);
        }

        subtitle-delay(seconds) => {
            root.player-subtitle-delay(seconds);
        }

        }
    }

    /// 把焦点交给对话框的地址输入框（打开对话框时由 Rust 侧调到这里）。
    public function focus-add-server-address() {
        add-server.focus-input();
    }

    /// 把焦点交给当前页的搜索输入框（Ctrl+F 由 Rust 侧调到这里）。
    public function focus-search-input() {
        if (root.page == 0) {
            home-page.focus-input();
        }
        if (root.page == 1) {
            lib-page.focus-input();
        }
        if (root.page == 4) {
            search-page.focus-input();
        }
    }

    /// 直接设置首页纵向滚动偏移（testing 快照用，不经过滚轮动画）。
    public function scroll-home-to(y: length) {
        home-page.scroll-to-offset(y);
    }

    out property <length> home-scroll-y: home-page.scroll-y;
    // 测试 / 调试用：详情页的版本下拉是否展开、「我的列表」是否已加入
    // （调试状态摘要要读；两者都只存在于 .slint 局部状态里）。
    out property <bool> detail-drop-open: detail-page.drop-open;
    out property <bool> detail-in-my-list: detail-page.in-my-list;
    out property <int> debug-nav-tabs: home-page.debug-nav-tabs;
    out property <length> home-content-h: home-page.content-h;

    // “添加服务器”对话框：绝对定位覆盖层（不进布局器，关闭后零残留）。
    add-server := AddServerDialog {
        open: root.add-server-open;
        state: root.add-server-state;
        address <=> root.add-server-address;
        user <=> root.add-server-user;
        password <=> root.add-server-password;
        address-hint: root.add-server-hint;
        plaintext-warning: root.add-server-plaintext;
        error-text: root.add-server-error;
        error-detail: root.add-server-error-detail;
        note-text: root.add-server-note;
        close => {
            // 焦点还给全局键盘处理（与搜索框退出聚焦同一路径）。
            keyboard.focus();
            root.add-server-close();
        }
        submit => {
            root.add-server-submit();
        }
        address-edited(text) => {
            root.add-server-address-edited(text);
        }
    }
}

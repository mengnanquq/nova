//! 应用窗口：组合五个页面、把按键意图交给 Rust 绑定层。
//!
//! .slint 只做“按键 → 意图编号”的映射与页面切换；焦点索引、导航栈都在 Rust 里。

import { Theme } from "theme.slint";
import { HomeData, LibraryData, DetailData, PlayerData, SearchData, Target, TargetBus } from "models.slint";
import { HomePage } from "home.slint";
import { LibraryPage } from "library.slint";
import { DetailPage } from "detail.slint";
import { PlayerShellPage } from "player_shell.slint";
import { SearchPage } from "search.slint";
import { Banner } from "components/banner.slint";
import { AddServerDialog } from "components/add_server.slint";

export { Theme }
// 调试通道的目标注册总线：Rust 侧要能读写 `gen` 并安装 `register` 回调。
export { TargetBus }

export component AppWindow inherits Window {
    // 窗口的逻辑尺寸**镜像**（只读观察值），用来在测试里模拟视口宽度。
    //
    // 这里**绝对不能**写 `width: root.window-w`：那会把窗口尺寸绑死在这个属性上，
    // 用户拖窗口边框时窗口系统写进来的新尺寸会立刻被绑定拉回初始值——
    // 表现就是"窗口拉不大"。之前就是这么写的（注释还误以为窗口系统会覆盖绑定）。
    //
    // 真实尺寸由窗口系统决定，我们在 `changed width` 里把它同步给 Theme。
    // 测试里若要模拟某个视口宽度，用 `AppWindow::window().set_size()`（show 之前），
    // 或改 `window-w` 触发布局（见下面的 `changed window-w`）。
    in-out property <length> window-w: 1280px;
    in-out property <length> window-h: 800px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    forward-focus: keyboard;

    // vw 驱动尺寸：视口宽度写回 Theme（gutter / 卡宽 / 链接间距都从这里派生）。
    init => {
        Theme.viewport-width = self.width;
    }
    changed width => {
        Theme.viewport-width = self.width;
    }
    // 代码/测试直接设逻辑宽时（testing 后端不会为 Window.width 发 changed），
    // 也必须同步——否则整棵树按旧 vw 算尺寸，塞进新窗口里就是压扁的布局。
    changed window-w => {
        Theme.viewport-width = root.window-w;
    }
    out property <length> probe-card-h: Theme.card-landscape-h;
    // 窗口尺寸驱动的视口宽度（`vw` 的源头）：断言"窗口能自由缩放"用。
    out property <length> probe-viewport-width: Theme.viewport-width;
    // 断点派生值（1280 档 152 / 1920 档 200）：断点真的切换了才变。
    out property <length> probe-content-gutter: Theme.content-gutter;
    out property <length> probe-portrait-w: Theme.card-portrait-w;

    // 测试用：继续观看行的放大覆盖层几何（「放大不跳布局」断言）。
    out property <length> zoom-rect-x: home-page.zoom-rect-x;
    out property <length> zoom-rect-y: home-page.zoom-rect-y;
    out property <length> zoom-rect-w: home-page.zoom-rect-w;
    out property <length> zoom-rect-h: home-page.zoom-rect-h;
    out property <bool> row0-zoom-on: home-page.row0-zoom-on;
    out property <length> row0-y: home-page.row0-y;
    out property <length> row0-arrow-y: home-page.row0-arrow-y;
    // 测试用：继续观看行的行标题下沿 / 图高 / 卡片总高（验收"放大不盖标题"
    // 与"卡片总高 = 图高 + 卡下标题块"）。
    out property <length> row0-title-bottom: home-page.row0-title-bottom;
    out property <length> row0-poster-width: home-page.row0-poster-width;
    out property <length> row0-poster-height: home-page.row0-poster-height;
    out property <length> row0-card-height: home-page.row0-card-height;
    // 竖版行（最近添加）：官方 240×336 的 5:7 海报。
    out property <length> row1-poster-width: home-page.row1-poster-width;
    out property <length> row1-poster-height: home-page.row1-poster-height;
    out property <length> row1-card-height: home-page.row1-card-height;
    out property <length> hero-bottom: home-page.hero-bottom;
    out property <length> row1-title-bottom: home-page.row1-title-bottom;

    // 测试用：搜索页结果网格几何（6 列 / 5:7 / 起点 = content-gutter）。
    out property <int> search-columns: search-page.probe-columns;
    out property <length> search-card-w: search-page.probe-card-w;
    out property <length> search-poster-h: search-page.probe-poster-h;
    out property <length> search-card-h: search-page.probe-card-h;
    out property <length> search-row-h: search-page.probe-row-h;
    out property <length> search-card-step: search-page.probe-card-step;
    out property <length> search-content-gutter: search-page.probe-gutter;
    out property <length> search-first-card-x: search-page.probe-first-x;

    // 测试用：详情页内容块几何（单一纵向布局叠在 hero 下半部）。
    // `detail-body-y + detail-body-height + Theme.detail-body-bottom-gap` 应等于
    // `detail-backdrop-height`（±2px）——即内容块整体落在 hero 内。
    out property <length> detail-body-y: detail-page.probe-body-y;
    out property <length> detail-body-height: detail-page.probe-body-height;
    out property <length> detail-backdrop-height: detail-page.probe-backdrop-height;
    // 三个区块的绝对上下沿（标题 / 简介 / 按钮），用于"互不重叠"回归断言。
    out property <length> detail-title-top: detail-page.probe-title-top;
    out property <length> detail-title-bottom: detail-page.probe-title-bottom;
    out property <length> detail-overview-top: detail-page.probe-overview-top;
    out property <length> detail-overview-bottom: detail-page.probe-overview-bottom;
    out property <length> detail-buttons-top: detail-page.probe-buttons-top;
    out property <length> detail-buttons-bottom: detail-page.probe-buttons-bottom;
    // 字幕安全区（逻辑像素）：控制块顶边到窗口底边 + theme 的安全间距。
    // `pages::app::player_push_subtitle_margin` 读它，再交给引擎换算成 `sub-pos` 百分比。
    out property <length> player-subtitle-inset: player-page.subtitle-safe-inset;

    in property <HomeData> home;
    in property <LibraryData> library;
    in property <DetailData> detail;
    in property <PlayerData> player;
    // 注意：不能叫 `search`——那会和下面的 `search()` 回调重名。
    in property <SearchData> search-data;

    // 0 = 首页，1 = 媒体库，2 = 详情，3 = 播放页，4 = 搜索页。
    in-out property <int> page: 0;
    in-out property <int> home-focus: 0;
    in-out property <int> library-focus: 0;
    in-out property <int> detail-focus: 0;
    in-out property <int> search-focus: 0;
    in-out property <bool> search-focused: false;
    // 用户是否已经真的在导航（按过方向键 / 悬停过卡片）。
    //
    // 页面一创建 `keyboard` FocusScope 就拿到焦点、`*-focus` 默认是 0，如果放大层
    // 直接绑 `focus-index`，程序一打开第一张卡就是放大状态 —— Netflix 不会这样，
    // 它只在指针悬停或真的按了方向键之后才放大。所以这里加一道"导航已激活"的门。
    // 换页时复位，回到"没有放大"的干净状态。
    in-out property <bool> nav-active: false;
    // ---- 键盘焦点层（体检 R2-2b）----
    //
    // 纯键盘 / 遥控器要能到达顶栏（库标签 / 搜索）与首页 hero 的两个按钮。
    // 内容层的扁平焦点不变，上面叠两层"chrome"：
    //
    // ```
    //   顶栏（2）  ← / → 在 标签 0..N → 搜索按钮 之间移动，Enter 激活，↓ 回下一层
    //     ↑↓
    //   hero（1）  首页 billboard 的「▶ 播放」/「更多信息」，← / → 切换，Enter 激活
    //     ↑↓
    //   内容（0）  卡片 / 网格（原来的扁平焦点）
    // ```
    //
    // 只有键盘导航能进入这两层（鼠标点击不会让 `focus-layer` 非 0），所以焦点环
    // 不会因为鼠标点击而留下来；Esc 在任何 chrome 层只回内容层，不返回上一页。
    in-out property <int> focus-layer: 0;
    // 顶栏焦点下标：`0..标签数-1` = 库标签，`标签数` = 搜索按钮，`-1` = 不在顶栏。
    in-out property <int> nav-focus: -1;
    // 首页 hero 按钮行的焦点（0 = 播放、1 = 更多信息，-1 = 不在 hero 层）。
    in-out property <int> hero-focus: -1;
    changed page => {
        root.nav-active = false;
        // 换页还要把键盘焦点还给全局 `keyboard` FocusScope（R2-1：`keyboard` 是页面
        // 树的兄弟节点，`TextInput` 拿到焦点后按键不会再冒泡到它；输入框随换页隐藏
        // 时 Slint 直接把焦点丢掉，此后方向键 / Enter / Esc 都没有接收者）。
        //
        // 这一步**不能**写在 `changed` 里：Slint 的 `changed` 处理器延迟到当前事件
        // 处理完才跑，会把上层随后的输入框聚焦（顶栏 → 搜索页的焦点交接）抢回来
        // （实测后续字符全部丢失，见 `tests/search_handoff.rs`）。统一在 Rust 的切页
        // 入口 `set_page()` 里同步调用 `focus-global()`（见 `pages/app.rs`）。
    }
    // 搜索框文本：与导航栏的 TextInput 双向同步，Rust 侧读写这里。
    in-out property <string> search-text: "";
    // 顶部横幅（通知位）：不遮挡导航栏，出现时内容整体下移。
    in property <bool> banner-visible: false;
    // 语义级别：0 info / 1 warning / 2 danger。
    in property <int> banner-level: 0;
    in property <string> banner-text: "";
    // 空字符串表示没有动作按钮。
    in property <string> banner-action-label: "";
    // “添加服务器”对话框：覆盖层，不参与下层布局。
    // 0 = 空闲，1 = 连接中（禁用重复提交）。
    in-out property <bool> add-server-open: false;
    // 关框（Esc / 取消 / 点上遮罩 / 上层直接关）之后，键盘焦点必须回到全局
    // `keyboard`：地址输入框抢过焦点，不还回去同样会变成"按键没人收"（R2-1）。
    changed add-server-open => {
        if (!root.add-server-open) {
            root.focus-global();
        }
    }
    in property <int> add-server-state: 0;
    in-out property <string> add-server-address: "";
    in-out property <string> add-server-user: "";
    in-out property <string> add-server-password: "";
    // 地址的内联提示（空串 = 无提示）。
    in property <string> add-server-hint: "";
    in property <bool> add-server-plaintext: false;
    // 错误区：主文案 + 可选补充说明。
    in property <string> add-server-error: "";
    in property <string> add-server-error-detail: "";
    // 钥匙环退化等提示。
    in property <string> add-server-note: "";
    // 拖动进度条时的气泡文本（Rust 侧用视图模型格式化）。
    in-out property <string> player-scrub-text: "";
    in-out property <bool> player-fullscreen: false;
    // 网格列数：与 `PosterGrid` 实际绘制保持一致——Netflix 1920 实测正文列宽 1520，
    // 6 张 240 宽海报 + 12px 间距正好铺满，所以 1920 也是 6 列（不是 7）。
    // 媒体库 / 搜索页 / 键盘焦点数学必须用同一个数，否则方向键步长与画面不符。
    out property <int> grid-columns: 6;

    // ---- 调试通道：当前页面的可交互目标（见 docs/ui-architecture.md）----
    // 只含"当前页面直接摆放、常驻"的控件（即各页 `targets` 数组）。重复元素
    // （卡片 / 标签 / 菜单行）与条件子树（hero / 空态 / 横幅 / 对话框）在 Slint 1.19
    // 里没法拼进数组，它们通过 `TargetBus` 登记；调试通道在 Rust 侧把两路合并。
    out property <[Target]> targets: root.page == 0 ? home-page.targets
        : root.page == 1 ? lib-page.targets
        : root.page == 2 ? detail-page.targets
        : root.page == 3 ? player-page.targets
        : search-page.targets;
    // testing 快照用：压缩首页 billboard，让行区进入首屏。
    in-out property <float> billboard-ratio: 0.88;
    // 首页图片窗口代次：数据真变了时 Rust 推一档，让每个卡片行重新上报可见区间
    // （行内的可见区间是事件驱动的，数据变化不一定改几何）。
    in-out property <int> home-image-gen: 0;
    // 首页悬停锁存复位序号：内容变化时 Rust 推一档，让各行的 `hot` / `latch` 失效，
    // 再由仍有 `has-hover` 的卡重新点亮（卡片实例已复用，悬停不会因数据重贴而丢）。
    in-out property <int> home-hover-reset: 0;
    // 首页悬停硬清序号：数据变少、焦点被钳回 0 时 Rust 推一档，只清不重算
    // （数据变少会挪行，指针不动的 `has-hover` 是旧位置的悬停）。
    in-out property <int> home-hover-clear: 0;

    // 回调只把事件送出去，业务判断留在 Rust。
    callback open-item(string);
    callback play-item(string);
    callback hero-play();
    callback back();
    callback search();
    callback search-changed(string);
    // 搜索页自己的大输入框（与顶栏的 search-changed 同一套行为，单独一条便于区分来源）。
    callback search-input(string);
    callback search-submit();
    callback search-clear();
    // 搜索页「×」：只清空关键词、留在搜索页（Esc 的「清空 + 回首页」仍走 search-clear）。
    callback search-clear-input();
    // 搜索页错误态的“重试”。
    callback search-retry();
    // 搜索页输入框 ↓ / ↑：焦点交给结果网格 / 顶栏（R7-D1，见 `search.slint`）。
    callback search-grid-focus();
    callback search-navbar-focus();
    callback banner-action();
    callback connect-server();
    callback add-server-close();
    callback add-server-submit();
    callback add-server-address-edited(string);
    callback sort();
    // 网格实例化窗口（大库窗口化）：页面报视口变化，Rust 据此重算实例化区间。
    callback library-grid-viewport-changed();
    callback search-grid-viewport-changed();
    // 首页某一行（或 hero，`row = -1`）当前可见的图片区间：`(row, first, count)`。
    // 只在区间变化 / 行重新进入视口 / 首页数据更新时发，Rust 据此按可见窗口请求海报。
    callback home-image-window(int, int, int);
    callback tab-activated(string);
    callback source-selected(string);
    // 「我的列表」切换（本地持久化，Rust 侧处理）。
    callback detail-my-list-toggle();
    // 1 ← / 2 → / 3 ↑ / 4 ↓ / 5 Enter·Space / 6 Esc·Backspace / 7 Ctrl+F
    callback key-intent(int);

    // 播放页：键位在这里只做分派，射出什么行为由 Rust 决定。
    // 1 Space/K / 2 ← / 3 → / 4 Shift+← / 5 Shift+→ / 6 ↑ / 7 ↓ / 8 M / 9 A / 10 S / 11 F / 12 Esc
    callback player-key(int);
    callback player-back();
    callback player-play-pause();
    callback player-seek-relative(int);
    callback player-scrub-start();
    callback player-scrub-move(float);
    callback player-scrub-commit(float);
    callback player-scrub-cancel();
    callback player-input();
    callback player-tick();
    callback player-audio-toggle();
    callback player-subtitle-toggle();
    callback player-audio-selected(int);
    callback player-subtitle-selected(int);
    callback player-retry();
    callback player-fullscreen-toggle();
    callback player-rate-cycle();
    callback player-time-toggle();
    callback player-mute-toggle();
    callback player-volume-set(float);
    callback player-subtitle-delay(float);
    // 控制层布局 / 窗口高度变化时重算字幕安全区（值从 `player-subtitle-inset` 读）。
    callback player-subtitle-reflow();
    // 控制层显隐变化时把字幕应该抬多高（px）报出去（mpv 的 sub-margin-y）。

    keyboard := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        init => {
            keyboard.focus();
        }

        key-pressed(event) => {
            // 任何按键都算"用户开始操作"，之后才允许放大焦点卡。
            root.nav-active = true;
            // 播放页有自己的快捷键表，且 Esc 必须先提交进度再退出。
            if (root.page == 3) {
                // 控制层隐藏时的 ↑ / ↓：这一下**只**算“唤醒”，不改音量。
                //
                // 两个键同时是唤醒键和音量键，之前对所有键都先 `player-input()`，
                // 结果每次想把控制层叫出来音量就被无声降 5%（体检 R2-5：0.95 → 0.35）。
                // `docs/debugging.md` 一直拿 `key Down` 当唤醒键用，唤醒不该附带音量副作用。
                // ←/→ 的快进快退、Space 的暂停在隐藏时仍**直接生效**（常见播放器行为，不改）。
                if ((event.text == Key.UpArrow || event.text == Key.DownArrow)
                    && !root.player.controls-visible) {
                    root.player-input();
                    return accept;
                }
                // 任何键都算一次输入：立刻显示控制层并重置 3 秒计时。
                root.player-input();
                // 字母键一律要求**没有按住 Ctrl**：Ctrl+F / Ctrl+N 是全局快捷键，
                // 不能被播放页的 f / k / m / a / s 吞掉（体检 R5-3）。
                if (!event.modifiers.control
                    && (event.text == Key.Space || event.text == "k" || event.text == "K")) {
                    root.player-key(1);
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.player-key(event.modifiers.shift ? 4 : 2);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.player-key(event.modifiers.shift ? 5 : 3);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.player-key(6);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.player-key(7);
                    return accept;
                }
                if (!event.modifiers.control && (event.text == "m" || event.text == "M")) {
                    root.player-key(8);
                    return accept;
                }
                if (!event.modifiers.control && (event.text == "a" || event.text == "A")) {
                    root.player-key(9);
                    return accept;
                }
                if (!event.modifiers.control && (event.text == "s" || event.text == "S")) {
                    root.player-key(10);
                    return accept;
                }
                if (!event.modifiers.control && (event.text == "f" || event.text == "F")) {
                    root.player-key(11);
                    return accept;
                }
                // Ctrl+D（完整诊断行）已移除：Netflix 播放器画面上没有常驻/可展开的诊断文字，
                // 引擎诊断只走 `--debug-socket` 的 `view`。这里不再占一个键，也不留“按了没反应”的键。
                if (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.player-key(12);
                    return accept;
                }
            }
            // 按键能到达这里 = 没有任何输入框持有焦点：撤销搜索框的"聚焦态"，
            // 否则顶栏会留着一个已失焦的展开输入框（例如 Ctrl+F 之后又关掉了对话框）。
            root.search-focused = false;
            // 对话框打开时：Esc 关闭，其余按键不透给被遮罩的首页。
            if (root.add-server-open) {
                if (event.text == Key.Escape) {
                    root.add-server-close();
                    return accept;
                }
                // Enter / Space / 方向键都吞掉，避免误触首页焦点或播放。
                if (event.text == Key.Return || event.text == Key.Space
                    || event.text == Key.LeftArrow || event.text == Key.RightArrow
                    || event.text == Key.UpArrow || event.text == Key.DownArrow) {
                    return accept;
                }
            }
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                root.key-intent(7);
                return accept;
            }
            // Ctrl+N：打开“添加服务器”对话框（与首页空态按钮、横幅动作同一路径）。
            if (event.modifiers.control && (event.text == "n" || event.text == "N")) {
                root.key-intent(8);
                return accept;
            }
            // 详情页的版本下拉展开时：Esc / Backspace 先收起下拉，**不**返回上一页
            // （返回要再按一次）。下拉是页面局部状态，这里只改它，不发 `key-intent`。
            if (root.page == 2 && root.detail-drop-open
                && (event.text == Key.Escape || event.text == Key.Backspace)) {
                root.detail-drop-open = false;
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.key-intent(1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-intent(2);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.key-intent(3);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.key-intent(4);
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                root.key-intent(5);
                return accept;
            }
            if (event.text == Key.Escape || event.text == Key.Backspace) {
                root.key-intent(6);
                return accept;
            }
            return reject;
        }
    }

    // 横幅在最上方：出现时把页面整体下移 48px，不遮挡导航栏；隐藏时完全不占位。
    // 不用布局器，直接显式偏移，避免布局对隐藏元素的预留空间。
    Banner {
        y: 0;
        width: root.width;
        height: root.banner-visible ? Theme.banner-height : 0px;
        visible: root.banner-visible;
        clip: true;
        level: root.banner-level;
        text: root.banner-text;
        action-label: root.banner-action-label;
        action => {
            root.focus-global();
            root.banner-action();
        }
    }

    content := Rectangle {
        y: root.banner-visible ? Theme.banner-height : 0px;
        width: root.width;
        // 高度不随横幅缩短：内部几何与无横幅时完全一致（卡片等元素尺寸逐像素不变），
        // 底部超出窗口的部分由窗口裁掉（页面自身有 48px 底部留白，且内容可滚动）。
        height: parent.height;

            home-page := HomePage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 0;
                data: root.home;
                billboard-ratio: root.billboard-ratio;
                focus-index <=> root.home-focus;
                nav-active: root.nav-active;
                content-focused: root.focus-layer == 0;
                hero-focus: root.nav-active && root.focus-layer == 1 ? root.hero-focus : -1;
                nav-focus: root.nav-active && root.focus-layer == 2 ? root.nav-focus : -1;
                search-focused: root.search-focused;
                search-text <=> root.search-text;
                image-gen: root.home-image-gen;
                hover-reset: root.home-hover-reset;
                hover-clear: root.home-hover-clear;
                image-window(row, first, count) => {
                    root.home-image-window(row, first, count);
                }
                open-item(id) => {
                    root.focus-global();
                    root.open-item(id);
                }
                hero-play => {
                    root.focus-global();
                    root.hero-play();
                }
                connect-server => {
                    root.focus-global();
                    root.connect-server();
                }
                tab-activated(id) => {
                    root.focus-global();
                    root.tab-activated(id);
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-changed(text);
                }
                search-submit => {
                    root.focus-global();
                    root.search-submit();
                }
                search-clear => {
                    root.focus-global();
                    root.search-clear();
                }
                search-escape => {
                    // 焦点还给全局键盘处理；Rust / 测试从 search-focused 读状态。
                    root.focus-global();
                }
                global-shortcut(code) => {
                    root.key-intent(code);
                }
            }

            lib-page := LibraryPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 1;
                data: root.library;
                focus-index <=> root.library-focus;
                nav-active: root.nav-active;
                content-focused: root.focus-layer == 0;
                nav-focus: root.nav-active && root.focus-layer == 2 ? root.nav-focus : -1;
                search-focused: root.search-focused;
                search-text <=> root.search-text;
                open-item(id) => {
                    root.focus-global();
                    root.open-item(id);
                }
                tab-activated(id) => {
                    root.focus-global();
                    root.tab-activated(id);
                }
                sort => {
                    root.focus-global();
                    root.sort();
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-changed(text);
                }
                search-submit => {
                    root.focus-global();
                    root.search-submit();
                }
                search-clear => {
                    root.focus-global();
                    root.search-clear();
                }
                search-escape => {
                    root.focus-global();
                }
                global-shortcut(code) => {
                    root.key-intent(code);
                }
                grid-viewport-changed => {
                    root.library-grid-viewport-changed();
                }
            }

            detail-page := DetailPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 2;
                data: root.detail;
                // 「我的列表」的真实状态来自 Rust（本地数据库），界面不再自己改。
                in-my-list: root.detail.in-my-list;
                focus-index <=> root.detail-focus;
                my-list-toggle => {
                    root.focus-global();
                    root.detail-my-list-toggle();
                }
                back => {
                    root.focus-global();
                    root.back();
                }
                play => {
                    root.focus-global();
                    root.play-item(root.detail.item-id);
                }
                source-selected(id) => {
                    root.focus-global();
                    root.source-selected(id);
                }
            }

            search-page := SearchPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 4;
                data: root.search-data;
                focus-index <=> root.search-focus;
                nav-active: root.nav-active;
                content-focused: root.focus-layer == 0;
                nav-focus: root.nav-active && root.focus-layer == 2 ? root.nav-focus : -1;
                search-text <=> root.search-text;
                search-focused: root.search-focused;
                open-item(id) => {
                    root.focus-global();
                    root.open-item(id);
                }
                tab-activated(id) => {
                    root.focus-global();
                    root.tab-activated(id);
                }
                search => {
                    root.search();
                }
                search-changed(text) => {
                    root.search-input(text);
                }
                search-submit => {
                    root.focus-global();
                    root.search-submit();
                }
                search-clear => {
                    root.focus-global();
                    root.search-clear();
                }
                search-clear-input => {
                    // 「×」的语义就是"留在本页继续输入"：焦点必须回输入框，
                    // 还交全局键盘反而是错的（由 Rust 侧重新聚焦，见 N3）。
                    root.search-clear-input();
                }
                search-escape => {
                    root.focus-global();
                }
                search-blur => {
                    root.focus-global();
                }
                search-retry => {
                    root.focus-global();
                    root.search-retry();
                }
                search-grid-focus => {
                    root.search-grid-focus();
                }
                search-navbar-focus => {
                    root.search-navbar-focus();
                }
                grid-viewport-changed => {
                    root.search-grid-viewport-changed();
                }
                global-shortcut(code) => {
                    root.key-intent(code);
                }
            }

            player-page := PlayerShellPage {
                width: parent.width;
                height: parent.height;
                visible: root.page == 3;
                data: root.player;
                scrub-text: root.player-scrub-text;
                fullscreen: root.player-fullscreen;

        back => {
            root.player-back();
        }

        play-pause => {
            root.player-play-pause();
        }

        seek-relative(seconds) => {
            root.player-seek-relative(seconds);
        }

        scrub-start => {
            root.player-scrub-start();
        }

        scrub-move(ratio) => {
            root.player-scrub-move(ratio);
        }

        scrub-commit(ratio) => {
            root.player-scrub-commit(ratio);
        }

        scrub-cancel => {
            root.player-scrub-cancel();
        }

        input => {
            root.player-input();
        }

        tick => {
            root.player-tick();
        }

        audio-toggle => {
            root.player-audio-toggle();
        }

        subtitle-toggle => {
            root.player-subtitle-toggle();
        }

        audio-selected(index) => {
            root.player-audio-selected(index);
        }

        subtitle-selected(index) => {
            root.player-subtitle-selected(index);
        }

        retry => {
            root.player-retry();
        }

        fullscreen-toggle => {
            root.player-fullscreen-toggle();
        }

        rate-cycle => {
            root.player-rate-cycle();
        }

        time-toggle => {
            root.player-time-toggle();
        }

        mute-toggle => {
            root.player-mute-toggle();
        }

        volume-set(volume) => {
            root.player-volume-set(volume);
        }

        subtitle-delay(seconds) => {
            root.player-subtitle-delay(seconds);
        }

        subtitle-inset-changed => {
            root.player-subtitle-reflow();
        }

        }
    }

    /// 把键盘焦点还给全局 `keyboard` FocusScope。
    ///
    /// 全局按键只由 `keyboard`（`init` 里 `focus()`）处理，而它是页面树的兄弟
    /// 节点；`TextInput` 抢到焦点之后，同页点击别的控件 / 换页 / 关框都没有归还
    /// 路径，焦点随隐藏的输入框被丢掉后方向键 / Enter / Esc 就永久无响应
    /// （体检 R2-1）。所有"用户明确离开了输入"的入口都走这里，而不是逐条补
    /// `clear-focus()`：换页（`changed page`）、关框（`changed add-server-open`）、
    /// 页面上的非输入动作（各回调）、输入框自己的 Esc / Enter。
    public function focus-global() {
        // 输入框不再是按键目标：顶栏 / 搜索页的"聚焦态"跟着撤销，
        // 否则会留着一个已失焦的展开输入框。
        root.search-focused = false;
        keyboard.focus();
    }

    /// 把焦点交给对话框的地址输入框（打开对话框时由 Rust 侧调到这里）。
    public function focus-add-server-address() {
        add-server.focus-input();
    }

    /// 把焦点交给当前页的搜索输入框（Ctrl+F / 搜索页交接由 Rust 侧调到这里）。
    ///
    /// 这是 `focus-global()` 的反方向：属性 `search-focused` 必须始终等于
    /// "搜索输入框当前是按键目标"。`set_search` 靠它决定要不要回填旧查询词
    /// （打字过程中回填会重置光标，见 `search_page.rs` 的回归用例）。
    public function focus-search-input() {
        if (root.page == 0 || root.page == 1 || root.page == 4) {
            root.search-focused = true;
        }
        if (root.page == 0) {
            home-page.focus-input();
        }
        if (root.page == 1) {
            lib-page.focus-input();
        }
        if (root.page == 4) {
            search-page.focus-input();
        }
    }

    /// 直接设置首页纵向滚动偏移（testing 快照用，不经过滚轮动画）。
    public function scroll-home-to(y: length) {
        home-page.scroll-to-offset(y);
    }

    /// 把首页滚到键盘焦点行 / 焦点卡（方向键移动后由 Rust 调用，R2-2）。
    ///
    /// `row` 是可视行号（0 = 继续观看、1 = 最近添加、2 + n = 库行），由 Rust 的
    /// `HomeView::focus_row_at` 给出——`.slint` 不做焦点数学，只按行号算几何。
    public function scroll-home-to-index(index: int, row: int) {
        home-page.scroll-to-index(index, row);
    }

    /// 把媒体库 / 搜索页的结果网格滚到键盘焦点卡（方向键移动后由 Rust 调用）。
    public function scroll-library-to-index(index: int) {
        lib-page.scroll-to-index(index);
    }

    /// 换库时把媒体库网格滚回顶部（R6-2）。同名库的刷新 / 详情返回不走这里。
    public function reset-library-scroll() {
        lib-page.reset-scroll();
    }

    /// 同上，搜索页。
    public function scroll-search-to-index(index: int) {
        search-page.scroll-to-index(index);
    }

    out property <length> home-scroll-y: home-page.scroll-y;
    // 测试 / 调试用：首页焦点行的纵向可见性 + 焦点卡的横向可见性
    // （方向键把焦点移出可视区时必须跟随滚动，断言见 `tests/home_focus_scroll.rs`）。
    out property <length> home-viewport-h: home-page.probe-viewport-h;
    out property <length> home-focus-top: home-page.probe-focus-top;
    out property <length> home-focus-bottom: home-page.probe-focus-bottom;
    out property <length> home-row-scroll-x: home-page.probe-row-content-x;
    out property <length> home-row-viewport-w: home-page.probe-row-viewport-w;
    out property <length> home-focus-left: home-page.probe-focus-left;
    out property <length> home-focus-right: home-page.probe-focus-right;
    // 测试 / 调试用：媒体库与搜索页结果网格的滚动偏移与键盘焦点卡位置
    // （键盘导航把焦点移出可视区时必须自动滚动，断言见 `tests/grid_focus_scroll.rs`）。
    out property <length> library-scroll-y: lib-page.probe-scroll-y;
    out property <length> library-viewport-h: lib-page.probe-viewport-h;
    out property <length> library-focus-top: lib-page.probe-focus-top;
    out property <length> library-focus-bottom: lib-page.probe-focus-bottom;
    out property <bool> library-zoom-on: lib-page.probe-zoom-on;
    // 网格窗口化（大库）探针：Rust 按这些几何算实例化区间，测试断"实例数有上界"。
    in-out property <int> library-window-start <=> lib-page.grid-window-start;
    in-out property <int> library-window-count <=> lib-page.grid-window-count;
    out property <int> library-probe-window-start: lib-page.probe-window-start;
    out property <int> library-probe-window-count: lib-page.probe-window-count;
    out property <int> library-total-count: lib-page.probe-total-count;
    out property <length> library-grid-row-h: lib-page.probe-row-height;
    out property <length> library-grid-top: lib-page.probe-grid-top;
    in-out property <int> search-window-start <=> search-page.grid-window-start;
    in-out property <int> search-window-count <=> search-page.grid-window-count;
    out property <int> search-probe-window-start: search-page.probe-window-start;
    out property <int> search-probe-window-count: search-page.probe-window-count;
    out property <int> search-total-count: search-page.probe-total-count;
    out property <length> search-grid-row-h: search-page.probe-row-height;
    out property <length> search-grid-top: search-page.probe-grid-top;
    out property <length> search-scroll-y: search-page.probe-scroll-y;
    out property <length> search-viewport-h: search-page.probe-viewport-h;
    out property <length> search-focus-top: search-page.probe-focus-top;
    out property <length> search-focus-bottom: search-page.probe-focus-bottom;
    out property <bool> search-zoom-on: search-page.probe-zoom-on;
    // 测试 / 调试用：详情页的版本下拉是否展开、「我的列表」是否已加入
    // （调试状态摘要要读；两者都只存在于 .slint 局部状态里）。
    // 下拉状态需要**双向**：Esc 要先收下拉、再按一次才返回（`key-pressed` 里处理）。
    in-out property <bool> detail-drop-open <=> detail-page.drop-open;
    out property <bool> detail-in-my-list: detail-page.in-my-list;
    // 调试用：对话框里当前聚焦的输入框（0 = 无，1 = 地址，2 = 用户名，3 = 密码）。
    out property <int> add-server-focus: add-server.focus-field;
    out property <int> debug-nav-tabs: home-page.debug-nav-tabs;
    out property <length> home-content-h: home-page.content-h;
    // 顶栏键盘焦点的几何探针（当前页的 `navbar.slint` 转发到这里）：
    // 窄窗口下焦点移到被截断的标签上时，用它断言那个标签真的滚进了标签区。
    out property <length> nav-focus-tab-left: root.page == 1 ? lib-page.probe-focus-tab-left
        : root.page == 4 ? search-page.probe-focus-tab-left : home-page.probe-focus-tab-left;
    out property <length> nav-focus-tab-right: root.page == 1 ? lib-page.probe-focus-tab-right
        : root.page == 4 ? search-page.probe-focus-tab-right : home-page.probe-focus-tab-right;
    out property <length> nav-tabs-viewport-w: root.page == 1 ? lib-page.probe-tabs-viewport-w
        : root.page == 4 ? search-page.probe-tabs-viewport-w : home-page.probe-tabs-viewport-w;
    out property <length> nav-tabs-scroll-x: root.page == 1 ? lib-page.probe-tabs-scroll-x
        : root.page == 4 ? search-page.probe-tabs-scroll-x : home-page.probe-tabs-scroll-x;

    // “添加服务器”对话框：绝对定位覆盖层（不进布局器，关闭后零残留）。
    add-server := AddServerDialog {
        open: root.add-server-open;
        state: root.add-server-state;
        address <=> root.add-server-address;
        user <=> root.add-server-user;
        password <=> root.add-server-password;
        address-hint: root.add-server-hint;
        plaintext-warning: root.add-server-plaintext;
        error-text: root.add-server-error;
        error-detail: root.add-server-error-detail;
        note-text: root.add-server-note;
        close => {
            // 焦点还给全局键盘处理（与搜索框退出聚焦同一路径）。
            root.focus-global();
            root.add-server-close();
        }
        submit => {
            root.add-server-submit();
        }
        address-edited(text) => {
            root.add-server-address-edited(text);
        }
    }
}

//! 基础卡片（官方 Netflix `li` 结构）：**海报在上、标题在卡片下方**。
//!
//! 尺寸（官方原文见 `theme.slint` 的 `card-caption-*`）：
//! - `image-height` = 图高（海报区）。竖版海报**无内衬**（官方 240×336 就是图本体），
//!   横版集数卡有 8px 内衬 + 2px 描边（`framed: true`）；
//! - 卡片总高 = 图高 + `Theme.card-caption-height`（标题块 = margin-top + 行高）；
//! - 官方 `li` 的竖向合计（≥1920）：10.4 + 336 + 8 + 24 + 10.4 = 388.8。
//!
//! 官方**没有**悬停信息面板（`li` 里只有海报 + 一行标题），所以这里也不再为面板
//! 留任何空间。放大仍由独立的 `CardZoom` 覆盖层负责（不在这里做，避免布局跳动）。
//!
//! `scale` 只有放大覆盖层用：Slint 1.19 的 `Transform`（`transform-scale-*`）是
//! internal 元素，用户代码实例化会编译报错，所以"放大"= 用同一个组件按 `scale`
//! 重算尺寸（单张卡的绘制只有这一份）。

import { Theme } from "theme.slint";
import { CardData, TargetBus } from "models.slint";

export component PosterCard inherits Rectangle {
    in property <CardData> card;
    // 海报区宽（含外框内衬）：行/网格算出来的列宽。
    in property <length> card-width: 260px;
    // 图高（海报区高，**不含**卡下标题）。
    in property <length> image-height: 390px;
    // 内部等比放大系数（1.0 = 未放大；放大覆盖层传 `zoom-factor`）。
    in property <float> scale: 1.0;
    // 是否画"集数卡"外框（8px 内衬 + 2px 描边 + 半透明白底）。
    //
    // 官方有两种卡：
    // - **横版集数卡**：`li 327×322`、`padding:8px`、`background:rgba(255,255,255,.1)`、
    //   `border-radius:16px` → 缩略图实际 307×173（实测）；
    // - **竖版海报卡**：`240×336` 的图本体就直接是 240×336，**没有内衬**，
    //   圆角加在图上。
    // 所以外框只给横版卡用，竖版卡必须关掉，否则 240 宽的卡里图只剩 220×316。
    in property <bool> framed: false;
    // 是否接受指针输入：放大覆盖层在放大完成前要关掉，否则它会抢走基础卡的悬停
    // （悬停 → 覆盖层接管 → 基础卡失焦 → 还原 → 无限抖动）。
    in property <bool> interactive: true;
    // ---- 调试通道：卡片本身是一个可点目标 ----
    // 卡片是重复元素，没法被父组件的 `targets` 数组收进去，所以自己登记
    // （id / label 由父组件按 `行前缀 + 下标` 传下来，见 docs/ui-architecture.md）。
    in property <string> target-id: "";
    in property <string> target-label: "";
    in property <bool> targets-visible: true;
    property <int> target-gen: TargetBus.gen;
    changed target-gen => {
        // 这里**不**再判宽高：
        // - `App::targets()` 已经用 `TargetInfo::is_clickable()` 过滤过零尺寸（宽高为正、
        //   中心在窗口内），重复过滤只会制造一类“本该登记却被挡掉”的漏项；
        // - 登记是**一次性快照**：某个代次里一旦被条件挡掉，清单里就留下上一代的
        //   旧坐标，直到下一次代次推进。实测刚切页 / 刚实例化的那一拍 `root.width`
        //   可能还是 0，把合法卡片挡在门外。
        if (root.targets-visible && root.visible && root.target-id != "") {
            TargetBus.register({
                id: root.target-id,
                kind: "card",
                label: root.target-label,
                x: root.absolute-position.x,
                y: root.absolute-position.y,
                width: root.width,
                height: root.height,
            });
        }
    }

    // 卡片总高（图高 + 标题块 × scale）——布局与测试只读这个。
    out property <length> card-height: (root.image-height + Theme.card-caption-height)
        * root.scale;
    // 覆盖层是否正被悬停（放大完成后才可能为真）。
    out property <bool> hovered: card-area.has-hover;
    // 悬停复算请求序号（父行在 `hover-reset` 时推一档）。
    //
    // `has-hover` 是边沿事件：指针不动、只有数据变化时它不会重发，父行也就没机会
    // 按“每张卡当前的悬停状态”重算放大的是哪一张。所以父行推一档序号，本卡若
    // **仍被悬停**就重新上报一次（没被悬停的卡不说话 = 放大自然会熄灭）。
    in property <int> hover-gen: 0;
    changed hover-gen => {
        if (card-area.has-hover) {
            root.hover-changed(true);
        }
    }
    callback clicked();
    // 悬停状态上报给行（行用它在覆盖层里放大这张卡）。
    callback hover-changed(bool);

    width: root.card-width * root.scale;
    height: root.card-height;
    background: transparent;

    // ---- 海报（外框 + 图）----
    // 卡片外框（Netflix 集数卡实测）：8px 内衬 + 2px 极淡描边 + 16px 圆角。
    // 327 宽的横版卡：327 - 2×(8 + 2) = 307 宽缩略图（实测 307×173）。
    frame := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.image-height * root.scale;
        clip: true;
        border-radius: Theme.radius-poster;
        background: root.framed ? Theme.card-frame-bg : transparent;
        border-width: root.framed ? Theme.card-frame-border-width : 0px;
        border-color: Theme.card-frame-border;
        property <length> content-inset: root.framed
            ? (Theme.card-frame-padding + Theme.card-frame-border-width) * root.scale
            : 0px;

        // ---- 加载骨架（**近似：静态占位**）----
        //
        // 官方 CSS 原文：`background-color: rgb(35,35,35); animation: loading 4000ms infinite linear`
        // （斜向扫光，`Theme.motion-pulse` 就是那个 4000ms 周期）。
        //
        // 我们**不复刻扫光，也不做循环呼吸**：任务硬约束是不许引定时器 / 每帧重绘，
        // 而"首帧之后再触发一次"在 Slint 里没有可靠的声明式时机（首次求值不播动画，
        // 实测 `init` 里置位也会被跳过一次），所以这里只做**静态占位**：
        // 官方底色 `Theme.skeleton-bg` + `Theme.skeleton-opacity-high`。
        // 呼吸区间留在 `Theme.skeleton-opacity-low/high`，将来有真动画时直接用。

        // 图片区：内缩到外框内衬里，自己带 16px 圆角（占位底 + 首字母同区）。
        Rectangle {
            x: parent.content-inset;
            y: parent.content-inset;
            width: parent.width - parent.content-inset * 2;
            height: parent.height - parent.content-inset * 2;
            clip: true;
            border-radius: Theme.radius-poster;
            background: transparent;

            // 骨架占位底：只在该卡没有图片时可见（静态，见文件头说明）。
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: Theme.radius-poster;
                // 官方 CSS 的骨架底色：`background-color: rgb(35,35,35)`。
                background: Theme.skeleton-bg;
                opacity: Theme.skeleton-opacity-high;
                visible: root.card.image.width <= 0;
            }

            Text {
                text: root.card.initial;
                color: Theme.text-faint;
                font-family: Theme.font-family;
                font-size: Theme.font-34;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
                visible: root.card.image.width <= 0;
            }

            Image {
                width: parent.width;
                height: parent.height;
                source: root.card.image;
                image-fit: cover;
            }
        }

        // HDR / 4K 角标：叠在海报右上角，随放大一起走。
        if (root.card.badge != "") :
            Rectangle {
                x: parent.width - self.width - parent.content-inset;
                y: parent.content-inset;
                width: badge-label.preferred-width + Theme.space-3;
                height: 20px;
                border-radius: Theme.radius-badge;
                background: Theme.badge-bg;

                badge-label := Text {
                    x: Theme.space-1;
                    width: parent.width;
                    height: parent.height;
                    text: root.card.badge;
                    color: Theme.text;
                    font-family: Theme.font-family;
                    font-size: Theme.font-12;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
            }

        // 底部进度条（继续观看）：3px 红，距卡底 6px，左右各 6px。
        if (root.card.progress >= 0) :
            Rectangle {
                x: parent.content-inset;
                y: parent.height - self.height - parent.content-inset;
                width: parent.width - parent.content-inset * 2;
                height: 3px;
                border-radius: 1.5px;
                background: Theme.card-progress-track;

                Rectangle {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    width: parent.width * clamp(root.card.progress, 0, 1);
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
            }
    }

    // ---- 卡下标题（官方结构：标题不在悬停面板里，而是常驻在海报下方）----
    // 官方 `p`：`color:#fff; font-weight:400; text-align:center`，
    // 行高 21px（1280–1919）/ 24px（≥1920），`margin-top` 4px / 8px。
    // 官方是 3 行 clamp，但标题块高恰好只有一行行高（32 = 8 + 24），
    // 所以这里按单行 + 省略号渲染（视觉与官方单行结果一致）。
    title := Text {
        x: 0;
        y: parent.height - self.height - Theme.card-caption-gap * root.scale;
        width: parent.width;
        height: Theme.card-caption-line-height * root.scale;
        text: root.card.title;
        color: Theme.text;
        font-family: Theme.font-family;
        font-size: Theme.card-caption-size * root.scale;
        font-weight: Theme.weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }

    card-area := TouchArea {
        enabled: root.interactive;
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
        // 指针在卡上**移动**时也上报一次悬停（不只是 `has-hover` 的跳变）。
        //
        // `has-hover` 是边沿触发的：指针本来就停在这张卡上、或者放大覆盖层接管了
        // 命中区之后再“悬停”同一张卡，都不会产生跳变，键盘焦点就一直对不上鼠标下
        // 的那张卡（第三轮体检 R2-3 真机：hover card.1 → Right 从键盘旧位置 +1）。
        // 移动事件是水平触发的，正好补上这个缺口（见 `card_zoom.slint` 的 `hover`）。
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move && self.has-hover) {
                root.hover-changed(true);
            }
        }
        clicked => {
            root.clicked();
        }
    }
}

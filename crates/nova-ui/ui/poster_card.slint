//! 基础卡片：行 / 网格里的固定尺寸缩略图（含角标与底部进度条）。
//!
//! 尺寸只由 card-width / card-height 决定，与图片是否已加载无关；
//! 放大效果由独立的 `CardZoom` 覆盖层负责（不在这里做，避免布局跳动）。

import { Theme } from "theme.slint";
import { CardData } from "models.slint";

export component PosterCard inherits Rectangle {
    in property <CardData> card;
    in property <length> card-width: 260px;
    in property <length> card-height: 390px;
    callback clicked();
    // 悬停状态上报给行（行用它在覆盖层里放大这张卡）。
    callback hover-changed(bool);

    width: card-width;
    height: card-height;
    clip: true;
    border-radius: Theme.radius-poster;
    // 卡片外框（Netflix 集数卡实测）：8px 内衬 + 2px 极淡描边 + 16px 圆角。
    // 327 宽的横版卡：327 - 2×(8 + 2) = 307 宽缩略图（实测 307×173）。
    background: Theme.card-frame-bg;
    border-width: Theme.card-frame-border-width;
    border-color: Theme.card-frame-border;
    property <length> content-inset: Theme.card-frame-padding + Theme.card-frame-border-width;

    // 图片区：内缩到外框内衬里，自己带 16px 圆角（占位底 + 首字母同区）。
    Rectangle {
        x: root.content-inset;
        y: root.content-inset;
        width: parent.width - root.content-inset * 2;
        height: parent.height - root.content-inset * 2;
        clip: true;
        border-radius: Theme.radius-poster;
        background: root.card.image.width > 0 ? transparent : Theme.surface-raised;

        Text {
            text: root.card.initial;
            color: Theme.text-faint;
            font-family: Theme.font-family;
            font-size: Theme.font-34;
            font-weight: Theme.weight-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
            visible: root.card.image.width <= 0;
        }

        Image {
            width: parent.width;
            height: parent.height;
            source: root.card.image;
            image-fit: cover;
        }
    }

    if (root.card.badge != "") :
        Rectangle {
            x: parent.width - self.width - root.content-inset;
            y: root.content-inset;
            width: badge-label.preferred-width + Theme.space-3;
            height: 20px;
            border-radius: Theme.radius-badge;
            background: Theme.badge-bg;

            badge-label := Text {
                x: Theme.space-1;
                width: parent.width;
                height: parent.height;
                text: root.card.badge;
                color: Theme.text;
                font-family: Theme.font-family;
                font-size: Theme.font-12;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }
        }

    // 底部进度条：3px 红，距卡底 6px，左右各 6px。
    if (root.card.progress >= 0) :
        Rectangle {
            x: root.content-inset;
            y: parent.height - self.height - root.content-inset;
            width: parent.width - root.content-inset * 2;
            height: 3px;
            border-radius: 1.5px;
            background: Theme.player-track;

            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: parent.width * clamp(root.card.progress, 0, 1);
                border-radius: 1.5px;
                background: Theme.accent;
            }
        }

    card-area := TouchArea {
        changed has-hover => {
            root.hover-changed(self.has-hover);
        }
        clicked => {
            root.clicked();
        }
    }
}
